{
  "name": "@hoba/validator",
  "version": "0.5.0",
  "description": "Referential, epistemic, scenario and analysis validation for the HOBA registry",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@hoba/registry-core": "workspace:*",
    "@hoba/graph": "workspace:*",
    "js-yaml": "^5.4.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.7.3"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmytro-yemelianov/hoba.work.git",
    "directory": "packages/validator"
  }
}
