---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'uk';
  activeNav?: string;
}

const {
  title,
  description = 'hoba — Hiring Obstacles & Barriers Atlas. Turn hiring outcomes into structured facts.',
  lang = 'en',
  activeNav = '',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://hoba.work');
---
<!doctype html>
<html lang={lang} class="dark bg-hoba-bg text-hoba-text antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | hoba.work</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | hoba`} />
    <meta property="og:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-hoba-bg selection:bg-hoba-accent/20 selection:text-hoba-accent">
    <Navbar lang={lang} active={activeNav} />
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
