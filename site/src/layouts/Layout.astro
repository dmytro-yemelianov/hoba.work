---
import '../styles/theme.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { OG_LOCALES, publicPath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  activeNav?: string;
}

const { title, lang = 'en', activeNav = '' } = Astro.props;
const t = useTranslations(lang);
const description = Astro.props.description ?? t('meta.description');

const site = Astro.site ?? new URL('https://hoba.work');
// The build emits this page under an internal language tree; the canonical URL
// is the language-free one a reader is given.
const canonicalURL = new URL(publicPath(Astro.url.pathname), site);
---
<!doctype html>
<html lang={lang} class="bg-hoba-bg text-hoba-text antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | hoba.work</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | hoba`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />

    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f9fc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0c10" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="hoba" />

    <!-- Theme: explicit choice in localStorage wins; otherwise follow the system; dark when the browser reports no preference. Runs before paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var dark = true;
        try {
          var stored = localStorage.getItem('hoba_theme');
          if (stored === 'light' || stored === 'dark') dark = stored === 'dark';
          else if (window.matchMedia) dark = !window.matchMedia('(prefers-color-scheme: light)').matches;
        } catch (e) {}
        document.documentElement.classList.toggle('dark', dark);
        try {
          var view = localStorage.getItem('hoba_view');
          if (view === 'table' || view === 'list' || view === 'cards') document.documentElement.dataset.view = view;
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-hoba-bg selection:bg-hoba-accent/20 selection:text-hoba-accent">
    <a href="#main" class="skip-link">{t('nav.skip')}</a>
    <Navbar lang={lang} active={activeNav} />
    <main id="main" class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Offline shell. Registered late so it never competes with the first paint. -->
    <script is:inline>
      if ('serviceWorker' in navigator && window.isSecureContext) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
