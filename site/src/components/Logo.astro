---
import HobaMark from '../assets/hoba-mark.svg';

interface Props {
  className?: string;
  showText?: boolean;
}

const { className = 'h-8 w-auto', showText = true } = Astro.props;
---
<div class="inline-flex items-center gap-2.5">
  <HobaMark class={`${className} text-hoba-text shrink-0`} role="img" aria-label="hoba" />
  {showText && <span class="text-2xl font-semibold leading-none text-hoba-text">hoba</span>}
</div>
