---
import HobaMark from '../assets/hoba-mark.svg';

interface Props {
  className?: string;
  showText?: boolean;
}

const { className = 'h-8 w-auto', showText = true } = Astro.props;
---
<div class="inline-flex items-center gap-2.5 font-bold tracking-tight">
  <HobaMark class={`${className} text-hoba-text shrink-0`} role="img" aria-label="hoba logo" />
  {showText && (
    <div class="flex flex-col">
      <span class="text-xl font-black lowercase tracking-tighter text-hoba-text font-mono">hoba</span>
      <span class="text-[9px] uppercase tracking-widest text-hoba-muted -mt-1 font-mono">hoba.work</span>
    </div>
  )}
</div>
