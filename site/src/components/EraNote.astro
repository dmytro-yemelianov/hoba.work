---
/**
 * Which era made this ordinary.
 *
 * The registry says what happens at a gate. The eras say under what conditions
 * that became the normal thing to happen. Without this line an entry reads as
 * timeless, which is the one thing it is not.
 */
import { erasNaming } from '../lib/registry';
import { useTranslations, type Lang } from '../i18n/utils';
import type { RegistryBundle } from '@hoba/registry';

interface Props {
  id: string;
  lang: Lang;
  bundle: RegistryBundle;
  prefix: string;
}

const { id, lang, bundle, prefix } = Astro.props;
const t = useTranslations(lang);
const eras = erasNaming(bundle, id);
---
{eras.length > 0 && (
  <section class="my-5 p-3.5 rounded-xl border border-hoba-border bg-hoba-card/50 text-sm" aria-label={t('era.made')}>
    <div class="flex items-center gap-2 font-mono text-xs font-semibold text-amber-600 dark:text-amber-400">
      <span>⏳ {t('era.made')}</span>
    </div>
    {eras.map((era) => (
      <p class="mt-1.5 text-sm text-hoba-text">
        <a href={`${prefix}/eras#${era.id}`} class="font-medium text-hoba-accent hover:underline">{era.title}</a>
        <span class="font-mono text-xs text-hoba-muted"> ({era.from}–{era.to})</span>
        <span class="text-hoba-muted"> — {era.summary}</span>
      </p>
    ))}
  </section>
)}
