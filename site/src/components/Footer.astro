---
import Logo from './Logo.astro';
import { getBundle, siteVersion } from '../lib/registry';
import { branded, localePrefix, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const registryVersion = getBundle(lang).version;
---
<footer class="border-t border-hoba-border bg-hoba-card/40 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-1">
        <Logo showText={true} />
        <p class="text-sm text-hoba-muted mt-3 leading-relaxed" set:html={branded(t('footer.blurb'))} />
        <p class="text-sm text-hoba-muted mt-3">
          {t('footer.canonical')} <span class="text-hoba-accent">hoba.work</span>
        </p>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-hoba-text mb-3">{t('footer.atlas')}</h4>
        <ul class="space-y-2 text-sm text-hoba-muted">
          <li><a href={`${prefix}/analyze`} class="hover:text-hoba-accent">{t('footer.analysis')}</a></li>
          <li><a href={`${prefix}/registry`} class="hover:text-hoba-accent">{t('footer.registryDirectory')}</a></li>
          <li><a href={`${prefix}/patterns`} class="hover:text-hoba-accent">{t('footer.patterns')}</a></li>
          <li><a href={`${prefix}/graph`} class="hover:text-hoba-accent">{t('footer.graph')}</a></li>
          <li><a href={`${prefix}/process`} class="hover:text-hoba-accent">{t('nav.process')}</a></li>
          <li><a href={`${prefix}/eras`} class="hover:text-hoba-accent">{t('nav.eras')}</a></li>
          <li><a href={`${prefix}/check`} class="hover:text-hoba-accent">{t('nav.check')}</a></li>
          <li><a href={`${prefix}/data`} class="hover:text-hoba-accent">{t('footer.data')}</a></li>
          <li><a href={`${prefix}/cats`} class="hover:text-hoba-accent">{t('nav.cats')}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-hoba-text mb-3">{t('footer.developers')}</h4>
        <ul class="space-y-2 text-sm text-hoba-muted">
          <li><a href={`${prefix}/developers`} class="hover:text-hoba-accent">{t('footer.api')}</a></li>
          <li><a href="/openapi.json" target="_blank" class="hover:text-hoba-accent text-xs font-mono">/openapi.json</a></li>
          <li><a href="/data/latest/registry.json" target="_blank" class="hover:text-hoba-accent text-xs font-mono">/data/latest/registry.json</a></li>
          <li><a href="/data/latest/graph.graphml" target="_blank" class="hover:text-hoba-accent text-xs font-mono">/data/latest/graph.graphml</a></li>
          <li><a href={`${prefix}/developers#mcp`} class="hover:text-hoba-accent text-xs">{t('footer.mcp')}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-hoba-text mb-3">{t('footer.principles')}</h4>
        <p class="text-sm text-hoba-muted leading-relaxed" set:html={branded(t('footer.principlesText'))} />
        <div class="mt-4 pt-3 border-t border-hoba-border/60 text-xs text-hoba-muted flex items-center justify-between gap-2">
          <span>{t('footer.author')} <a href="https://github.com/dmytro-yemelianov" class="text-hoba-text underline underline-offset-2 decoration-hoba-border hover:decoration-hoba-text">Dmytro Yemelianov</a></span>
          <span class="">{t('footer.version', { site: siteVersion, registry: registryVersion })}</span>
        </div>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-hoba-border/40 flex flex-col sm:flex-row items-center justify-between text-xs text-hoba-muted gap-4">
      <div>
        {t('footer.content')} <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" class="text-hoba-text underline underline-offset-2 decoration-hoba-border hover:decoration-hoba-text">CC BY-SA 4.0</a> | {t('footer.code')} <a href="https://opensource.org/licenses/MIT" target="_blank" class="text-hoba-text underline underline-offset-2 decoration-hoba-border hover:decoration-hoba-text">MIT</a>
      </div>
      <div class="text-xs">{t('footer.deterministic')}</div>
    </div>
  </div>
</footer>
