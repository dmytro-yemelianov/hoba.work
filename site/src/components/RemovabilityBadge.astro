---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  removability: 'candidate' | 'intermediary' | 'none';
  lang?: Lang;
}

const { removability, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const dot = { candidate: 'bg-emerald-500', intermediary: 'bg-amber-500', none: 'bg-rose-500' }[removability];
---
<span class="pill pill-muted" title={t(`removability.${removability}.desc`)}>
  <span class={`dot ${dot}`} aria-hidden="true"></span>
  <span>{t(`removability.${removability}`)}</span>
</span>
