---
import Layout from '../../layouts/Layout.astro';
import EntityBadge from '../../components/EntityBadge.astro';
import path from 'node:path';
import { loadRegistryFromDirectory } from '@hoba/registry';

export async function getStaticPaths() {
  const rootDir = path.resolve(process.cwd(), '..');
  const bundle = loadRegistryFromDirectory(path.join(rootDir, 'content'), path.join(rootDir, 'evidence'));
  return bundle.interventions.map((intervention) => ({
    params: { id: intervention.id },
    props: { intervention, bundle },
  }));
}

const { intervention, bundle } = Astro.props;
---
<Layout title={`${intervention.id} — ${intervention.title}`} activeNav="registry">
  <div class="max-w-4xl mx-auto space-y-8">
    <!-- Breadcrumbs -->
    <div class="text-xs font-mono text-hoba-muted flex items-center gap-2">
      <a href="/registry" class="hover:text-hoba-text">Registry</a>
      <span>/</span>
      <a href="/registry?type=intervention" class="hover:text-hoba-text">Interventions</a>
      <span>/</span>
      <span class="text-hoba-accent">{intervention.id}</span>
    </div>

    <!-- Header Section -->
    <div class="p-6 rounded-2xl border border-hoba-border bg-hoba-card">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <EntityBadge type="intervention" id={intervention.id} size="md" />
        <div class="flex items-center gap-2 text-xs font-mono text-hoba-muted">
          <span>Responsible Actor: <strong class="text-cyan-300 uppercase">{intervention.actor}</strong></span>
          <span>•</span>
          <span>Cost: <strong class="text-hoba-text uppercase">{intervention.cost}</strong></span>
        </div>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black font-mono text-hoba-text">{intervention.title}</h1>
      <p class="text-sm text-hoba-muted mt-3 leading-relaxed">{intervention.summary}</p>
    </div>

    <!-- Target Entities -->
    <div class="p-6 rounded-xl border border-hoba-border bg-hoba-card text-xs font-mono">
      <h2 class="text-xs font-bold uppercase text-hoba-muted mb-2">Targeted System Entities (Mechanisms / Barriers / Loops):</h2>
      <div class="flex flex-wrap gap-2">
        {intervention.targets.map((tid: string) => (
          <span class="px-2.5 py-1 rounded bg-hoba-bg border border-hoba-border text-cyan-300 font-bold">
            {tid}
          </span>
        ))}
      </div>
    </div>

    <!-- Expected Effects & Measurement Plan -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-5 rounded-xl border border-emerald-800/40 bg-emerald-950/20 text-xs">
        <h2 class="font-mono font-bold uppercase text-emerald-300 mb-3">Expected System Effects:</h2>
        <ul class="space-y-2 text-emerald-100/90 list-disc list-inside">
          {intervention.expected_effects.map((ef: string) => <li>{ef}</li>)}
        </ul>
      </div>

      <div class="p-5 rounded-xl border border-cyan-800/40 bg-cyan-950/20 text-xs">
        <h2 class="font-mono font-bold uppercase text-cyan-300 mb-3">Measurement & Metric Concepts:</h2>
        <ul class="space-y-2 text-cyan-100/90 list-disc list-inside">
          {intervention.measurements.map((m: string) => <li class="font-mono"><code>{m}</code></li>)}
        </ul>
      </div>
    </div>

    <!-- Machine Link -->
    <div class="p-4 rounded-lg border border-hoba-border bg-hoba-card flex items-center justify-between text-xs font-mono text-hoba-muted">
      <span>Machine-readable static endpoint:</span>
      <a href={`/api/v1/interventions/${intervention.id}.json`} target="_blank" class="text-hoba-accent hover:underline">/api/v1/interventions/{intervention.id}.json</a>
    </div>
  </div>
</Layout>
