---
import Layout from '../../layouts/Layout.astro';
import EntityBadge from '../../components/EntityBadge.astro';
import { getBundle } from '../../lib/registry';

export async function getStaticPaths() {
  return getBundle().artifacts.map((artifact) => ({
    params: { id: artifact.id },
    props: { artifact },
  }));
}

const { artifact } = Astro.props;
const bundle = getBundle();
const compatibleMechanisms = bundle.mechanisms.filter((m) =>
  m.emissions.some((e) => e.artifact === artifact.id)
);
const relatedPatterns = bundle.patterns.filter((p) =>
  p.required_artifacts.includes(artifact.id)
);
---
<Layout title={`${artifact.id} — ${artifact.title}`} activeNav="registry">
  <div class="max-w-4xl mx-auto space-y-8">
    <!-- Breadcrumbs -->
    <div class="text-xs font-mono text-hoba-muted flex items-center gap-2">
      <a href="/registry" class="hover:text-hoba-text">Registry</a>
      <span>/</span>
      <a href="/registry" class="hover:text-hoba-text">Observations</a>
      <span>/</span>
      <span class="text-hoba-accent">{artifact.id}</span>
    </div>

    <!-- Header Section -->
    <div class="p-6 rounded-2xl border border-hoba-border bg-hoba-card">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <EntityBadge type="artifact" id={artifact.id} size="md" />
        <div class="flex items-center gap-2 text-xs font-mono text-hoba-muted">
          <span>Evidence: <strong class="text-hoba-text">{artifact.evidence_level}</strong></span>
          <span>•</span>
          <span>Status: <strong class="text-emerald-400">{artifact.status}</strong></span>
        </div>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black font-mono text-hoba-text">{artifact.title}</h1>
      <p class="text-sm text-hoba-muted mt-3 leading-relaxed">{artifact.summary}</p>

      <div class="mt-4 pt-4 border-t border-hoba-border flex flex-wrap gap-2 text-xs font-mono">
        <span class="text-hoba-muted">Funnel Stages:</span>
        {artifact.stages.map((st) => (
          <span class="px-2 py-0.5 rounded bg-hoba-bg border border-hoba-border text-hoba-text uppercase text-[10px]">{st}</span>
        ))}
      </div>
    </div>

    <!-- 1. Diagnostic Verdict & Meaning -->
    <div class="p-6 rounded-xl border border-hoba-border bg-hoba-card/50">
      <h2 class="text-xs font-mono font-bold uppercase text-hoba-accent tracking-wider mb-2">Diagnostic Epistemic Posture</h2>
      <p class="text-xs text-hoba-muted leading-relaxed">
        This observation represents an empirical signal received or experienced by a candidate. In the HOBA framework, an observation is an empirical consequence of underlying system mechanisms, not a causal proof in itself.
      </p>
    </div>

    <!-- 2. Diagnostic Probes -->
    {artifact.probes.length > 0 && (
      <div class="p-6 rounded-xl border border-hoba-border bg-hoba-card">
        <h2 class="text-sm font-mono font-bold uppercase text-hoba-text mb-4">Recommended Diagnostic Probes</h2>
        <div class="space-y-3">
          {artifact.probes.map((probe) => (
            <div class="p-3 rounded-lg border border-hoba-border bg-hoba-bg text-xs font-mono">
              <div class="flex items-center justify-between text-hoba-accent font-bold mb-1">
                <span>[{probe.id}] Diagnostic Probe</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-hoba-card text-hoba-muted border border-hoba-border">Cost: {probe.cost}</span>
              </div>
              <div class="text-hoba-text"><strong class="text-hoba-muted">Action:</strong> {probe.action}</div>
              <div class="text-hoba-muted mt-1"><strong class="text-hoba-text">Expected Signal:</strong> {probe.expected_signal}</div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- 3. Compatible Mechanisms -->
    <div class="p-6 rounded-xl border border-hoba-border bg-hoba-card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-mono font-bold uppercase text-hoba-text">Compatible Mechanisms ({compatibleMechanisms.length})</h2>
        <a href={`/analyze`} class="text-xs font-mono text-hoba-accent hover:underline">Run Diagnostic Wizard &rarr;</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {compatibleMechanisms.map((m) => (
          <a href={`/mechanisms/${m.id}`} class="p-3 rounded-lg border border-hoba-border bg-hoba-bg hover:border-blue-500/50 transition-colors block text-xs">
            <div class="flex items-center justify-between font-mono mb-1">
              <span class="font-bold text-blue-400">{m.id}</span>
              <span class="text-[10px] px-1 rounded bg-hoba-card text-hoba-muted">{m.facets.removability}</span>
            </div>
            <div class="font-bold text-hoba-text">{m.title}</div>
            <p class="text-hoba-muted text-[11px] mt-1 line-clamp-2">{m.summary}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- 4. What This Does NOT Tell You (Non-Inferences) -->
    <div class="p-6 rounded-xl border border-rose-900/40 bg-rose-950/20 text-xs">
      <h2 class="font-mono font-bold uppercase text-rose-300 mb-2">What this observation does NOT establish:</h2>
      <ul class="space-y-1.5 text-rose-200/80 list-disc list-inside">
        {artifact.non_inferences.map((ni) => (
          <li>{ni}</li>
        ))}
      </ul>
    </div>

    <!-- 5. Related Graph Patterns -->
    {relatedPatterns.length > 0 && (
      <div class="p-6 rounded-xl border border-amber-900/40 bg-amber-950/20 text-xs">
        <h2 class="font-mono font-bold uppercase text-amber-300 mb-2">Participates in Contradiction Patterns:</h2>
        <div class="space-y-2">
          {relatedPatterns.map((p) => (
            <a href={`/patterns/${p.id}`} class="p-2.5 rounded bg-hoba-card/60 border border-amber-800/40 block hover:bg-hoba-hover">
              <span class="font-mono font-bold text-amber-400">{p.id}:</span> <strong class="text-hoba-text">{p.title}</strong>
              <p class="text-hoba-muted mt-0.5">{p.summary}</p>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- JSON API / Machine Links -->
    <div class="p-4 rounded-lg border border-hoba-border bg-hoba-card flex items-center justify-between text-xs font-mono text-hoba-muted">
      <span>Machine-readable static endpoint:</span>
      <a href={`/api/v1/artifacts/${artifact.id}.json`} target="_blank" class="text-hoba-accent hover:underline">/api/v1/artifacts/{artifact.id}.json</a>
    </div>
  </div>
</Layout>
