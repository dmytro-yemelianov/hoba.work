---
import Layout from '../layouts/Layout.astro';
import { langFromUrl } from '../lib/registry';
import Mascot from '../components/Mascot.astro';

const lang = langFromUrl(Astro.url);
---
<Layout lang={lang} title="About HOBA" activeNav="about">
  <div class="max-w-4xl mx-auto space-y-10">
    <div class="border-b border-hoba-border pb-6">
      <span class="text-xs font-mono uppercase font-bold text-hoba-accent tracking-wider">Project Identity</span>
      <h1 class="text-3xl sm:text-4xl font-black font-mono text-hoba-text mt-1">About hoba</h1>
      <p class="text-sm text-hoba-muted mt-2 font-mono">
        Hiring Obstacles & Barriers Atlas • Canonical domain: <strong class="text-hoba-accent">hoba.work</strong>
      </p>
    </div>

    <!-- Project Story -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-8 space-y-4 text-xs sm:text-sm text-hoba-muted leading-relaxed">
        <p>
          <strong class="text-hoba-text">hoba</strong> was created to turn ambiguous hiring signals into machine-readable facts, structural gates, compatible mechanisms, and actionable agency.
        </p>
        <p>
          When an applicant faces silence or standardized rejections, they often interpret it emotionally because the actual structural mechanism is hidden. hoba replaces that interpretation loop with a forensic protocol: <strong class="text-hoba-text font-mono">H — Hard facts, O — Obstacle, B — Behind, A — Agency</strong>.
        </p>
        <p>
          The canonical domain <strong class="text-hoba-text font-mono">hoba.work</strong> reflects the project purpose: mapping the systems, barriers, and evidence surrounding technical work and hiring.
        </p>
      </div>
      <div class="md:col-span-4 flex justify-center">
        <div class="p-4 rounded-2xl border border-hoba-border bg-hoba-card text-center">
          <Mascot className="w-36 h-36 mx-auto" />
          <span class="text-[10px] font-mono text-hoba-muted">Serious system, slightly absurd cat.</span>
        </div>
      </div>
    </div>

    <!-- Author & Licensing -->
    <div class="p-6 rounded-2xl border border-hoba-border bg-hoba-card space-y-4 text-xs font-mono">
      <h2 class="text-sm font-bold uppercase text-hoba-text">Author & Maintainer</h2>
      <p class="text-hoba-muted">
        Created and maintained by <a href="https://github.com/dmytro-yemelianov" class="text-hoba-accent font-bold hover:underline">Dmytro Yemelianov</a>.
      </p>
      <div class="pt-3 border-t border-hoba-border text-hoba-muted space-y-1 text-[11px]">
        <p>• <strong>Registry Content:</strong> <a href="https://creativecommons.org/licenses/by-sa/4.0/" class="text-hoba-text hover:underline">Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)</a></p>
        <p>• <strong>Code & Toolchain:</strong> <a href="https://opensource.org/licenses/MIT" class="text-hoba-text hover:underline">MIT License</a></p>
      </div>
    </div>
  </div>
</Layout>
