---
import Layout from '../layouts/Layout.astro';
import EntityBadge from '../components/EntityBadge.astro';
import path from 'node:path';
import { loadRegistryFromDirectory } from '@hoba/registry';

const rootDir = path.resolve(process.cwd(), '..');
const bundle = loadRegistryFromDirectory(path.join(rootDir, 'content'), path.join(rootDir, 'evidence'));
---
<Layout title="Recurring Contradiction Patterns" activeNav="patterns">
  <div class="mb-8 border-b border-hoba-border pb-6">
    <span class="text-xs font-mono uppercase font-bold text-hoba-pattern tracking-wider">Systemic Contradictions</span>
    <h1 class="text-3xl font-black font-mono text-hoba-text mt-1">Recurring Patterns Catalog</h1>
    <p class="text-sm text-hoba-muted mt-2">
      Named graph motifs describing structural double-binds, asymmetries, and feedback traps across the hiring process.
    </p>
  </div>

  <div class="space-y-6">
    {bundle.patterns.map((p) => {
      const requiredArts = bundle.artifacts.filter((a) => p.required_artifacts.includes(a.id));
      const compMechs = bundle.mechanisms.filter((m) => p.compatible_mechanisms.includes(m.id));
      const targetInterventions = bundle.interventions.filter((i) => p.interventions.includes(i.id));

      return (
        <div class="p-6 rounded-2xl border border-hoba-border bg-hoba-card/70 hover:border-amber-500/50 transition-colors">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <EntityBadge type="pattern" id={p.id} size="md" />
              <span class="text-xs font-mono text-hoba-muted">Evidence: <strong class="text-hoba-text">{p.evidence_level}</strong></span>
            </div>
            <a href={`/patterns/${p.id}`} class="text-xs font-mono text-hoba-accent hover:underline flex items-center gap-1">
              <span>View full motif</span>
              <span>&rarr;</span>
            </a>
          </div>

          <h2 class="text-xl font-bold font-mono text-hoba-text">
            <a href={`/patterns/${p.id}`} class="hover:text-amber-300 transition-colors">{p.title}</a>
          </h2>
          <p class="text-xs sm:text-sm text-hoba-muted mt-2 leading-relaxed">{p.summary}</p>

          <div class="mt-4 p-3 rounded-lg border border-amber-800/40 bg-amber-950/20 text-xs font-mono text-amber-200">
            <strong class="text-amber-300">Trigger Rule:</strong> {p.trigger_rule}
          </div>

          <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <div class="p-3 rounded-lg bg-emerald-950/20 border border-emerald-800/40">
              <span class="font-mono font-bold text-emerald-300 uppercase block mb-1">Establishes:</span>
              <ul class="space-y-1 text-emerald-100 list-disc list-inside">
                {p.establishes.map((e) => <li>{e}</li>)}
              </ul>
            </div>

            <div class="p-3 rounded-lg bg-rose-950/20 border border-rose-900/40">
              <span class="font-mono font-bold text-rose-300 uppercase block mb-1">Does NOT Establish:</span>
              <ul class="space-y-1 text-rose-200/90 list-disc list-inside">
                {p.non_inferences.map((ni) => <li>{ni}</li>)}
              </ul>
            </div>
          </div>

          <!-- Tags -->
          <div class="mt-4 pt-3 border-t border-hoba-border/60 flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-hoba-muted">
            <div class="flex items-center gap-1.5">
              <span>Required Signals:</span>
              {requiredArts.map((a) => (
                <a href={`/artifacts/${a.id}`} class="px-1.5 py-0.5 rounded bg-hoba-bg border border-hoba-border text-purple-300 hover:border-purple-500">
                  {a.id}
                </a>
              ))}
            </div>
            <div class="flex items-center gap-1.5">
              <span>Interventions:</span>
              {targetInterventions.map((i) => (
                <a href={`/interventions/${i.id}`} class="px-1.5 py-0.5 rounded bg-hoba-bg border border-hoba-border text-cyan-300 hover:border-cyan-500">
                  {i.id}
                </a>
              ))}
            </div>
          </div>
        </div>
      );
    })}
  </div>
</Layout>
