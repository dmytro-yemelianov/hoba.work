---
import Layout from '../../layouts/Layout.astro';
import EntityBadge from '../../components/EntityBadge.astro';
import path from 'node:path';
import { loadRegistryFromDirectory } from '@hoba/registry';

export async function getStaticPaths() {
  const rootDir = path.resolve(process.cwd(), '..');
  const bundle = loadRegistryFromDirectory(path.join(rootDir, 'content'), path.join(rootDir, 'evidence'));
  return bundle.patterns.map((pattern) => ({
    params: { id: pattern.id },
    props: { pattern, bundle },
  }));
}

const { pattern, bundle } = Astro.props;
const requiredArtifacts = bundle.artifacts.filter((a) =>
  pattern.required_artifacts.includes(a.id)
);
const compatibleMechanisms = bundle.mechanisms.filter((m) =>
  pattern.compatible_mechanisms.includes(m.id)
);
const relevantInterventions = bundle.interventions.filter((i) =>
  pattern.interventions.includes(i.id)
);
---
<Layout title={`${pattern.id} — ${pattern.title}`} activeNav="patterns">
  <div class="max-w-4xl mx-auto space-y-8">
    <!-- Breadcrumbs -->
    <div class="text-xs font-mono text-hoba-muted flex items-center gap-2">
      <a href="/patterns" class="hover:text-hoba-text">Patterns</a>
      <span>/</span>
      <span class="text-hoba-accent">{pattern.id}</span>
    </div>

    <!-- Header Section -->
    <div class="p-6 rounded-2xl border border-hoba-border bg-hoba-card">
      <div class="flex items-center justify-between gap-2 mb-3">
        <EntityBadge type="pattern" id={pattern.id} size="md" />
        <span class="text-xs font-mono text-hoba-muted">Evidence: <strong class="text-hoba-text">{pattern.evidence_level}</strong></span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black font-mono text-hoba-text">{pattern.title}</h1>
      <p class="text-sm text-hoba-muted mt-3 leading-relaxed">{pattern.summary}</p>

      <div class="mt-4 p-3 rounded-lg border border-amber-800/40 bg-amber-950/20 text-xs font-mono text-amber-200">
        <strong class="text-amber-300">Trigger Rule:</strong> {pattern.trigger_rule}
      </div>
    </div>

    <!-- What This Establishes vs What It Does NOT Establish -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-5 rounded-xl border border-emerald-800/40 bg-emerald-950/20 text-xs">
        <h2 class="font-mono font-bold uppercase text-emerald-300 mb-3 flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>What This Pattern Establishes:</span>
        </h2>
        <ul class="space-y-2 text-emerald-100/90 list-disc list-inside">
          {pattern.establishes.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="p-5 rounded-xl border border-rose-900/40 bg-rose-950/20 text-xs">
        <h2 class="font-mono font-bold uppercase text-rose-300 mb-3 flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          <span>What This Does NOT Establish:</span>
        </h2>
        <ul class="space-y-2 text-rose-200/90 list-disc list-inside">
          {pattern.non_inferences.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>
    </div>

    <!-- Required Observations -->
    <div class="p-6 rounded-xl border border-hoba-border bg-hoba-card">
      <h2 class="text-sm font-mono font-bold uppercase text-hoba-text mb-3">Required Observed Signals (Artifacts)</h2>
      <div class="space-y-2">
        {requiredArtifacts.map((a) => (
          <a href={`/artifacts/${a.id}`} class="p-3 rounded-lg bg-hoba-bg border border-hoba-border hover:border-purple-500/50 block text-xs">
            <span class="font-mono font-bold text-purple-300">{a.id}:</span> <strong class="text-hoba-text">{a.title}</strong>
            <p class="text-hoba-muted text-[11px] mt-1">{a.summary}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Compatible Mechanisms -->
    <div class="p-6 rounded-xl border border-hoba-border bg-hoba-card">
      <h2 class="text-sm font-mono font-bold uppercase text-hoba-text mb-3">Compatible Mechanisms Participating in Motif</h2>
      <div class="space-y-2">
        {compatibleMechanisms.map((m) => (
          <a href={`/mechanisms/${m.id}`} class="p-3 rounded-lg bg-hoba-bg border border-hoba-border hover:border-blue-500/50 block text-xs">
            <div class="flex items-center justify-between font-mono mb-1">
              <span class="font-bold text-blue-400">{m.id}</span>
              <span class="text-[10px] px-1 rounded bg-hoba-card text-hoba-muted">{m.facets.removability}</span>
            </div>
            <strong class="text-hoba-text">{m.title}</strong>
            <p class="text-hoba-muted text-[11px] mt-1">{m.summary}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Relevant Interventions -->
    {relevantInterventions.length > 0 && (
      <div class="p-6 rounded-xl border border-cyan-900/40 bg-cyan-950/20 text-xs">
        <h2 class="font-mono font-bold uppercase text-cyan-300 mb-3">Interventions Mitigating This Contradiction Pattern:</h2>
        <div class="space-y-2">
          {relevantInterventions.map((i) => (
            <a href={`/interventions/${i.id}`} class="p-3 rounded-lg bg-hoba-card border border-cyan-800/40 block hover:bg-hoba-hover">
              <span class="font-mono font-bold text-cyan-400">{i.id}:</span> <strong class="text-hoba-text">{i.title}</strong>
              <p class="text-hoba-muted mt-1">{i.summary}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>
