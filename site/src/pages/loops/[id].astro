---
import Layout from '../../layouts/Layout.astro';
import EntityBadge from '../../components/EntityBadge.astro';
import path from 'node:path';
import { loadRegistryFromDirectory } from '@hoba/registry';

export async function getStaticPaths() {
  const rootDir = path.resolve(process.cwd(), '..');
  const bundle = loadRegistryFromDirectory(path.join(rootDir, 'content'), path.join(rootDir, 'evidence'));
  return bundle.loops.map((loop) => ({
    params: { id: loop.id },
    props: { loop, bundle },
  }));
}

const { loop, bundle } = Astro.props;
const memberMechanisms = bundle.mechanisms.filter((m) =>
  loop.mechanisms.includes(m.id)
);
const breakingInterventions = bundle.interventions.filter((i) =>
  loop.interventions.includes(i.id)
);
---
<Layout title={`${loop.id} — ${loop.title}`} activeNav="registry">
  <div class="max-w-4xl mx-auto space-y-8">
    <!-- Breadcrumbs -->
    <div class="text-xs font-mono text-hoba-muted flex items-center gap-2">
      <a href="/registry" class="hover:text-hoba-text">Registry</a>
      <span>/</span>
      <a href="/registry?type=loop" class="hover:text-hoba-text">Loops</a>
      <span>/</span>
      <span class="text-hoba-accent">{loop.id}</span>
    </div>

    <!-- Header Section -->
    <div class="p-6 rounded-2xl border border-hoba-border bg-hoba-card">
      <div class="flex items-center justify-between gap-2 mb-3">
        <EntityBadge type="loop" id={loop.id} size="md" />
        <span class="text-xs font-mono text-hoba-muted">Evidence: <strong class="text-hoba-text">{loop.evidence_level}</strong></span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black font-mono text-hoba-text">{loop.title}</h1>
      <p class="text-sm text-hoba-muted mt-3 leading-relaxed">{loop.summary}</p>
    </div>

    <!-- Causal Graph SCC Sequence -->
    <div class="p-6 rounded-xl border border-pink-900/40 bg-pink-950/20 text-xs font-mono">
      <h2 class="font-bold uppercase text-pink-300 mb-3">Reinforcing Cycle Edges (SCC)</h2>
      <div class="space-y-2">
        {loop.edges.map((edge) => {
          const fromM = bundle.mechanisms.find((m) => m.id === edge.from);
          const toM = bundle.mechanisms.find((m) => m.id === edge.to);
          return (
            <div class="p-3 rounded bg-hoba-card border border-pink-800/40 flex items-center justify-between">
              <div>
                <a href={`/mechanisms/${edge.from}`} class="text-blue-400 font-bold hover:underline">{edge.from}</a>
                <span class="text-hoba-muted"> ({fromM?.title})</span>
              </div>
              <span class="text-pink-400 font-bold uppercase text-[10px] px-2 py-0.5 rounded bg-pink-900/60">&rarr; {edge.relation} &rarr;</span>
              <div>
                <a href={`/mechanisms/${edge.to}`} class="text-blue-400 font-bold hover:underline">{edge.to}</a>
                <span class="text-hoba-muted"> ({toM?.title})</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Member Mechanisms -->
    <div class="p-6 rounded-xl border border-hoba-border bg-hoba-card">
      <h2 class="text-sm font-mono font-bold uppercase text-hoba-text mb-3">Participating Mechanisms ({memberMechanisms.length})</h2>
      <div class="space-y-2">
        {memberMechanisms.map((m) => (
          <a href={`/mechanisms/${m.id}`} class="p-3 rounded-lg bg-hoba-bg border border-hoba-border hover:border-blue-500/50 block text-xs">
            <div class="flex items-center justify-between font-mono mb-1">
              <span class="font-bold text-blue-400">{m.id}</span>
              <span class="text-[10px] px-1 rounded bg-hoba-card text-hoba-muted">{m.facets.removability}</span>
            </div>
            <strong class="text-hoba-text">{m.title}</strong>
            <p class="text-hoba-muted text-[11px] mt-1">{m.summary}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Interventions That Break Cycle -->
    {breakingInterventions.length > 0 && (
      <div class="p-6 rounded-xl border border-cyan-900/40 bg-cyan-950/20 text-xs">
        <h2 class="font-mono font-bold uppercase text-cyan-300 mb-3">Interventions Proposed to Break This Cycle:</h2>
        <div class="space-y-2">
          {breakingInterventions.map((i) => (
            <a href={`/interventions/${i.id}`} class="p-3 rounded-lg bg-hoba-card border border-cyan-800/40 block hover:bg-hoba-hover">
              <span class="font-mono font-bold text-cyan-400">{i.id}:</span> <strong class="text-hoba-text">{i.title}</strong>
              <p class="text-hoba-muted mt-1">{i.summary}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>
