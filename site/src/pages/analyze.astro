---
import Layout from '../layouts/Layout.astro';
import { getBundle, langFromUrl, slimBundle, STAGES } from '../lib/registry';

const lang = langFromUrl(Astro.url);
const bundle = getBundle(lang);
// Only the structured fields reach the browser (no markdown bodies); "<" is
// escaped so the JSON can never terminate the script element early.
const bundleJSON = JSON.stringify(slimBundle(bundle)).replace(/</g, '\\u003c');
const stagesWithBarriers = STAGES.filter((st) => bundle.barriers.some((b) => b.stage === st));
---
<Layout lang={lang} title="HOBA Analysis Wizard" activeNav="analyze">
  <div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="mb-8 border-b border-hoba-border pb-6">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-xs font-mono uppercase font-bold text-hoba-accent tracking-wider">Interactive Protocol · registry {bundle.version}</span>
          <h1 class="text-3xl font-black font-mono text-hoba-text mt-1">HOBA Forensic Analysis</h1>
        </div>
        <div class="hidden sm:flex items-center gap-2 text-xs font-mono text-emerald-400 bg-emerald-950/40 border border-emerald-800/60 px-3 py-1.5 rounded-lg">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span>Runs in your browser · nothing is sent anywhere</span>
        </div>
      </div>
      <p class="text-sm text-hoba-muted mt-2">
        Turn ambiguous hiring feedback or silence into verifiable observations, structural barrier gates, compatible mechanisms, and actionable candidate probes.
      </p>
    </div>

    <!-- Wizard Steps Tabs -->
    <div class="grid grid-cols-4 gap-2 mb-8 font-mono text-xs" role="tablist">
      <button id="tab-h" data-step="h" class="wizard-tab p-3 rounded-lg border flex items-center justify-center gap-2" role="tab">
        <span class="w-5 h-5 rounded-full flex items-center justify-center text-[11px]">H</span>
        <span class="hidden sm:inline">1. Hard Facts</span>
      </button>
      <button id="tab-o" data-step="o" class="wizard-tab p-3 rounded-lg border flex items-center justify-center gap-2" role="tab">
        <span class="w-5 h-5 rounded-full flex items-center justify-center text-[11px]">O</span>
        <span class="hidden sm:inline">2. Obstacle</span>
      </button>
      <button id="tab-b" data-step="b" class="wizard-tab p-3 rounded-lg border flex items-center justify-center gap-2" role="tab">
        <span class="w-5 h-5 rounded-full flex items-center justify-center text-[11px]">B</span>
        <span class="hidden sm:inline">3. Behind</span>
      </button>
      <button id="tab-a" data-step="a" class="wizard-tab p-3 rounded-lg border flex items-center justify-center gap-2" role="tab">
        <span class="w-5 h-5 rounded-full flex items-center justify-center text-[11px]">A</span>
        <span class="hidden sm:inline">4. Agency</span>
      </button>
    </div>

    <div class="p-6 rounded-xl border border-hoba-border bg-hoba-card/60 backdrop-blur">

      <!-- STEP H: HARD FACTS -->
      <section id="step-h" class="wizard-step space-y-6">
        <div>
          <h2 class="text-xl font-bold font-mono text-hoba-text">Step H — What actually happened?</h2>
          <p class="text-xs text-hoba-muted mt-1">Select one or more factual observations directly witnessed. No intent speculation.</p>
        </div>

        <fieldset>
          <legend class="block text-xs font-mono font-semibold text-hoba-muted uppercase mb-2">Stage reached before the process stalled (optional):</legend>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-mono">
            {stagesWithBarriers.map((st) => (
              <label class="flex items-center gap-2 p-2 rounded border border-hoba-border bg-hoba-card hover:bg-hoba-hover cursor-pointer">
                <input type="radio" name="stage_select" value={st} class="text-hoba-accent focus:ring-0" />
                <span class="capitalize">{st}</span>
              </label>
            ))}
          </div>
          <p class="text-[11px] text-hoba-muted mt-2">Leave empty to infer gates from the stages where the selected observations occur.</p>
        </fieldset>

        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="artifact-search-input" class="text-xs font-mono font-semibold text-hoba-muted uppercase">Select Observed Signals (Artifacts):</label>
            <input
              type="text"
              id="artifact-search-input"
              placeholder="Filter observations..."
              class="px-3 py-1 bg-hoba-bg border border-hoba-border rounded text-xs text-hoba-text placeholder-hoba-muted focus:outline-none focus:border-hoba-accent"
            />
          </div>

          <div id="artifacts-list" class="space-y-2 max-h-96 overflow-y-auto pr-1">
            {bundle.artifacts.map((art) => (
              <label class="artifact-item flex items-start gap-3 p-3 rounded-lg border border-hoba-border bg-hoba-bg hover:border-purple-500/40 transition-colors cursor-pointer" data-search={`${art.id} ${art.title} ${art.summary}`.toLowerCase()}>
                <input type="checkbox" name="artifacts_selected" value={art.id} class="mt-1 text-hoba-accent rounded focus:ring-0" />
                <div class="flex-1 text-xs">
                  <div class="flex items-center gap-2">
                    <span class="font-mono font-bold text-purple-300">{art.id}</span>
                    <span class="font-semibold text-hoba-text">{art.title}</span>
                  </div>
                  <p class="text-hoba-muted mt-1 leading-relaxed">{art.summary}</p>
                </div>
              </label>
            ))}
          </div>
        </div>

        <div class="pt-4 border-t border-hoba-border flex justify-end">
          <button data-goto="o" class="px-6 py-2.5 rounded-lg bg-hoba-accent hover:bg-blue-500 text-hoba-bg font-bold font-mono text-xs transition-colors">
            Proceed to Step O (Obstacle) &rarr;
          </button>
        </div>
      </section>

      <!-- STEP O: OBSTACLE -->
      <section id="step-o" class="wizard-step hidden space-y-6">
        <div>
          <h2 class="text-xl font-bold font-mono text-hoba-text">Step O — Where did the hiring process stop?</h2>
          <p class="text-xs text-hoba-muted mt-1">Identified structural funnel gate(s) based on your selected observations.</p>
        </div>
        <div id="barriers-output" class="space-y-3"></div>
        <div class="pt-4 border-t border-hoba-border flex justify-between">
          <button data-goto="h" class="px-5 py-2 rounded-lg border border-hoba-border text-hoba-muted hover:text-hoba-text font-mono text-xs">&larr; Back to Hard Facts</button>
          <button data-goto="b" class="px-6 py-2.5 rounded-lg bg-hoba-accent hover:bg-blue-500 text-hoba-bg font-bold font-mono text-xs transition-colors">Proceed to Step B (Behind Obstacle) &rarr;</button>
        </div>
      </section>

      <!-- STEP B: BEHIND THE OBSTACLE -->
      <section id="step-b" class="wizard-step hidden space-y-6">
        <div>
          <h2 class="text-xl font-bold font-mono text-hoba-text">Step B — What mechanisms are compatible with the evidence?</h2>
          <p class="text-xs text-hoba-muted mt-1">Logically compatible causes without pretending certainty. Includes honest baseline factors.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <h3 class="text-xs font-mono font-bold uppercase text-hoba-text mb-3">Compatible Mechanisms:</h3>
            <div id="mechanisms-output" class="space-y-2 max-h-96 overflow-y-auto pr-1"></div>
          </div>
          <div class="space-y-4">
            <div>
              <h3 class="text-xs font-mono font-bold uppercase text-hoba-pattern mb-2">Matching Contradiction Patterns:</h3>
              <div id="patterns-output" class="space-y-2 text-xs"></div>
            </div>
            <div>
              <h3 class="text-xs font-mono font-bold uppercase text-pink-400 mb-2">Causal Loops in Scope:</h3>
              <div id="loops-output" class="space-y-2 text-xs"></div>
            </div>
            <div>
              <h3 class="text-xs font-mono font-bold uppercase text-rose-400 mb-2">Non-Inferences (What NOT to assume):</h3>
              <div id="noninferences-output" class="p-3 rounded-lg border border-rose-900/40 bg-rose-950/20 text-xs text-rose-200/80 space-y-1.5"></div>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-hoba-border flex justify-between">
          <button data-goto="o" class="px-5 py-2 rounded-lg border border-hoba-border text-hoba-muted hover:text-hoba-text font-mono text-xs">&larr; Back to Obstacle</button>
          <button data-goto="a" class="px-6 py-2.5 rounded-lg bg-hoba-accent hover:bg-blue-500 text-hoba-bg font-bold font-mono text-xs transition-colors">Proceed to Step A (Agency & Probes) &rarr;</button>
        </div>
      </section>

      <!-- STEP A: AGENCY & PROBES -->
      <section id="step-a" class="wizard-step hidden space-y-6">
        <div>
          <h2 class="text-xl font-bold font-mono text-hoba-text">Step A — Locus of Agency & Diagnostic Probes</h2>
          <p class="text-xs text-hoba-muted mt-1">Separating what you can test from factors outside your control.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="p-4 rounded-lg border border-emerald-800/60 bg-emerald-950/30">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-emerald-300 uppercase">Endogenous (You)</span>
              <span id="count-candidate" class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-emerald-900 text-emerald-200">0</span>
            </div>
            <p class="text-[11px] text-hoba-muted mb-3">Factors where candidate optimization or test probes are viable.</p>
            <div id="list-candidate" class="space-y-1 text-xs"></div>
          </div>
          <div class="p-4 rounded-lg border border-amber-800/60 bg-amber-950/30">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-amber-300 uppercase">Intermediary</span>
              <span id="count-intermediary" class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-amber-900 text-amber-200">0</span>
            </div>
            <p class="text-[11px] text-hoba-muted mb-3">Depends on recruiter, manager, or compensation authority.</p>
            <div id="list-intermediary" class="space-y-1 text-xs"></div>
          </div>
          <div class="p-4 rounded-lg border border-rose-800/60 bg-rose-950/30">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-rose-300 uppercase">Exogenous (No Agency)</span>
              <span id="count-noagency" class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-rose-900 text-rose-200">0</span>
            </div>
            <p class="text-[11px] text-hoba-muted mb-3">Structural macro factors, freezes, or cohort dynamics.</p>
            <div id="list-noagency" class="space-y-1 text-xs"></div>
          </div>
        </div>

        <div class="p-4 rounded-lg border border-hoba-border bg-hoba-bg">
          <h3 class="text-xs font-mono font-bold uppercase text-hoba-accent mb-2">Bounded Diagnostic Probes:</h3>
          <div id="probes-output" class="space-y-2"></div>
        </div>

        <div id="verdict-banner" class="p-4 rounded-lg border text-xs font-mono" aria-live="polite"></div>

        <div class="pt-4 border-t border-hoba-border flex flex-wrap items-center justify-between gap-4">
          <button data-goto="b" class="px-5 py-2 rounded-lg border border-hoba-border text-hoba-muted hover:text-hoba-text font-mono text-xs">&larr; Back to Behind</button>
          <div class="flex gap-2">
            <button id="btn-copy-report" class="px-4 py-2 rounded-lg border border-hoba-border bg-hoba-card hover:bg-hoba-hover text-hoba-text font-mono text-xs flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
              <span>Copy Markdown Report</span>
            </button>
            <button id="btn-reset" class="px-4 py-2 rounded-lg border border-hoba-border text-hoba-muted hover:text-rose-400 font-mono text-xs">Reset Analysis</button>
          </div>
        </div>
      </section>
    </div>
  </div>

  <script type="application/json" id="hoba-bundle" set:html={bundleJSON} />
  <script>
    // The wizard runs the very same HOBADiagnosticEngine as the CLI and the MCP
    // server — there is no second, hand-rolled copy of the protocol in the browser.
    import { HOBADiagnosticEngine, type DiagnosticResult, type RegistryBundle, type StageId } from '@hoba/registry/core';

    type Step = 'h' | 'o' | 'b' | 'a';
    const STEPS: Step[] = ['h', 'o', 'b', 'a'];
    const TAB_STYLE: Record<Step, { active: string; badge: string }> = {
      h: { active: 'border-purple-500/50 bg-purple-950/30 text-purple-300 font-bold', badge: 'bg-purple-800' },
      o: { active: 'border-emerald-500/50 bg-emerald-950/30 text-emerald-300 font-bold', badge: 'bg-emerald-800' },
      b: { active: 'border-blue-500/50 bg-blue-950/30 text-blue-300 font-bold', badge: 'bg-blue-800' },
      a: { active: 'border-amber-500/50 bg-amber-950/30 text-amber-300 font-bold', badge: 'bg-amber-800' },
    };
    const IDLE_TAB = 'border-hoba-border bg-hoba-card text-hoba-muted font-medium';

    const bundle = JSON.parse(document.getElementById('hoba-bundle')!.textContent!) as RegistryBundle;
    const engine = new HOBADiagnosticEngine(bundle);

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const esc = (value: unknown) =>
      String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    const REMOVABILITY_TAG: Record<string, string> = {
      candidate: 'bg-emerald-950 text-emerald-300 border-emerald-800',
      intermediary: 'bg-amber-950 text-amber-300 border-amber-800',
      none: 'bg-rose-950 text-rose-300 border-rose-800',
    };

    function collectInputs(): { artifacts: string[]; stage?: StageId } {
      const artifacts = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="artifacts_selected"]:checked')).map((el) => el.value);
      const stage = document.querySelector<HTMLInputElement>('input[name="stage_select"]:checked')?.value as StageId | undefined;
      return { artifacts, stage };
    }

    const analyze = (): DiagnosticResult => engine.analyze(collectInputs());

    function setStep(step: Step) {
      for (const s of STEPS) {
        $(`step-${s}`).classList.toggle('hidden', s !== step);
        const tab = $(`tab-${s}`);
        tab.className = `wizard-tab p-3 rounded-lg border flex items-center justify-center gap-2 ${s === step ? TAB_STYLE[s].active : IDLE_TAB}`;
        tab.setAttribute('aria-selected', String(s === step));
        tab.firstElementChild!.className = `w-5 h-5 rounded-full flex items-center justify-center text-[11px] ${s === step ? TAB_STYLE[s].badge : 'bg-hoba-border'}`;
      }
      if (step === 'o') renderStepO();
      if (step === 'b') renderStepB();
      if (step === 'a') renderStepA();
    }

    document.querySelectorAll<HTMLElement>('.wizard-tab').forEach((t) => t.addEventListener('click', () => setStep(t.dataset.step as Step)));
    document.querySelectorAll<HTMLElement>('[data-goto]').forEach((b) => b.addEventListener('click', () => setStep(b.dataset.goto as Step)));

    $<HTMLInputElement>('artifact-search-input').addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
      document.querySelectorAll<HTMLElement>('.artifact-item').forEach((el) => {
        el.classList.toggle('hidden', Boolean(q) && !(el.dataset.search ?? '').includes(q));
      });
    });

    const mechanismCard = (m: DiagnosticResult['behind']['compatible_mechanisms'][number]) => `
      <div class="p-2.5 rounded border border-hoba-border bg-hoba-bg text-xs">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5 font-mono">
            <span class="text-blue-400 font-bold">${esc(m.mechanism.id)}</span>
            <a href="/mechanisms/${esc(m.mechanism.id)}" target="_blank" class="font-semibold text-hoba-text hover:underline">${esc(m.mechanism.title)}</a>
          </div>
          <div class="flex items-center gap-1">
            ${m.honest_baseline ? '<span class="text-[9px] font-mono px-1 rounded bg-emerald-950 text-emerald-300 border border-emerald-800">Honest Baseline</span>' : ''}
            ${m.emitted_by_evidence ? '<span class="text-[9px] font-mono px-1 rounded bg-purple-950 text-purple-300 border border-purple-800" title="Directly emits a selected observation">emits signal</span>' : ''}
            <span class="text-[9px] font-mono px-1 rounded border ${REMOVABILITY_TAG[m.removability]}">${esc(m.removability)}</span>
          </div>
        </div>
        <p class="text-[11px] text-hoba-muted mt-1 leading-snug">${esc(m.mechanism.summary)}</p>
      </div>`;

    function renderStepO() {
      const res = analyze();
      const container = $('barriers-output');
      if (res.hard_facts.selected_artifacts.length === 0 && !res.hard_facts.stage) {
        container.innerHTML = `<div class="p-4 rounded-lg bg-hoba-bg text-hoba-muted text-xs font-mono">No stage or observations selected yet. Please select at least one observation in Step H.</div>`;
        return;
      }
      if (res.obstacle.identified_barriers.length === 0) {
        container.innerHTML = `<div class="p-4 rounded-lg bg-hoba-bg text-hoba-muted text-xs font-mono">No funnel gate is registered for the selected stage yet.</div>`;
        return;
      }
      container.innerHTML = res.obstacle.identified_barriers
        .map(
          (b) => `
        <div class="p-3 rounded-lg border border-emerald-800/40 bg-emerald-950/20 flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs font-bold text-emerald-400">${esc(b.id)}</span>
              <a href="/barriers/${esc(b.id)}" target="_blank" class="text-xs font-bold text-hoba-text hover:text-emerald-300 underline underline-offset-2">${esc(b.title)}</a>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-900/60 text-emerald-200 uppercase">${esc(b.stage)}</span>
            </div>
            <p class="text-xs text-hoba-muted mt-1">${esc(b.description)}</p>
            <div class="text-[11px] text-emerald-300/80 mt-2 font-mono"><strong class="text-hoba-text">Pass Condition:</strong> ${esc(b.pass_condition)}</div>
          </div>
          <span class="text-xs font-mono text-emerald-400/60 shrink-0">Gate #${b.order}</span>
        </div>`
        )
        .join('');
    }

    function renderStepB() {
      const res = analyze();
      $('mechanisms-output').innerHTML =
        res.behind.compatible_mechanisms.map(mechanismCard).join('') ||
        `<div class="p-3 rounded bg-hoba-bg text-xs text-hoba-muted font-mono">No compatible mechanisms resolved.</div>`;

      $('patterns-output').innerHTML =
        res.behind.related_patterns
          .map(
            (p) => `
          <div class="p-2.5 rounded border border-amber-800/40 bg-amber-950/20">
            <div class="flex items-center gap-1.5 font-mono text-xs">
              <span class="text-amber-400 font-bold">${esc(p.id)}</span>
              <a href="/patterns/${esc(p.id)}" target="_blank" class="font-bold text-amber-200 hover:underline">${esc(p.title)}</a>
            </div>
            <p class="text-[11px] text-hoba-muted mt-1">${esc(p.summary)}</p>
          </div>`
          )
          .join('') || `<div class="text-xs text-hoba-muted font-mono">No specific graph contradiction patterns triggered.</div>`;

      $('loops-output').innerHTML =
        res.behind.related_loops
          .map(
            (l) => `
          <div class="p-2.5 rounded border border-pink-800/40 bg-pink-950/20">
            <div class="flex items-center gap-1.5 font-mono text-xs">
              <span class="text-pink-400 font-bold">${esc(l.id)}</span>
              <a href="/loops/${esc(l.id)}" target="_blank" class="font-bold text-pink-200 hover:underline">${esc(l.title)}</a>
            </div>
            <p class="text-[11px] text-hoba-muted mt-1">${esc(l.summary)}</p>
          </div>`
          )
          .join('') || `<div class="text-xs text-hoba-muted font-mono">No causal loop touches the compatible mechanisms.</div>`;

      $('noninferences-output').innerHTML =
        res.behind.non_inferences.map((ni) => `<div>&bull; ${esc(ni)}</div>`).join('') ||
        `<div>No specific non-inferences registered for selection.</div>`;
    }

    const agencyList = (items: DiagnosticResult['agency']['candidate_removable'], cls: string) =>
      items
        .map((m) => `<div class="p-1.5 rounded ${cls} font-mono text-[11px]"><strong>${esc(m.id)}:</strong> ${esc(m.title)}</div>`)
        .join('') || '<div class="text-hoba-muted text-[11px]">None identified</div>';

    function renderStepA() {
      const res = analyze();
      $('count-candidate').textContent = String(res.counts.candidate_removable);
      $('count-intermediary').textContent = String(res.counts.intermediary);
      $('count-noagency').textContent = String(res.counts.no_agency);
      $('list-candidate').innerHTML = agencyList(res.agency.candidate_removable, 'bg-emerald-950/60 border border-emerald-800/40 text-emerald-200');
      $('list-intermediary').innerHTML = agencyList(res.agency.intermediary_dependent, 'bg-amber-950/60 border border-amber-800/40 text-amber-200');
      $('list-noagency').innerHTML = agencyList(res.agency.exogenous_no_agency, 'bg-rose-950/60 border border-rose-800/40 text-rose-200');

      $('probes-output').innerHTML =
        res.agency.diagnostic_probes
          .map(
            (p) => `
          <div class="p-3 rounded border border-hoba-border bg-hoba-card text-xs font-mono">
            <div class="flex items-center justify-between text-hoba-accent font-bold mb-1">
              <span>Probe ${esc(p.id)}</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-hoba-bg text-hoba-muted border border-hoba-border">Cost: ${esc(p.cost)}</span>
            </div>
            <div class="text-hoba-text"><strong class="text-hoba-muted">Action:</strong> ${esc(p.action)}</div>
            <div class="text-hoba-muted mt-1"><strong class="text-hoba-text">Expected Signal:</strong> ${esc(p.expected_signal)}</div>
          </div>`
          )
          .join('') || `<div class="text-xs text-hoba-muted font-mono">No candidate action probe is justified by current facts.</div>`;

      const banner = $('verdict-banner');
      if (res.verdict === 'low_signal_ambiguity') {
        banner.className = 'p-4 rounded-lg border border-amber-800/60 bg-amber-950/30 text-amber-200 text-xs font-mono';
        banner.innerHTML = `<strong>Diagnostic Stop Condition (zone: ${esc(res.agency.agency_zone)}):</strong> ${esc(res.agency.probes_summary)} Do not spend further energy optimizing against this specific outcome.`;
      } else {
        banner.className = 'p-4 rounded-lg border border-blue-800/60 bg-blue-950/30 text-blue-200 text-xs font-mono';
        banner.innerHTML = `<strong>Diagnostic Verdict (zone: ${esc(res.agency.agency_zone)}):</strong> ${esc(res.agency.probes_summary)} Execute the low-cost probes above before submitting comparable applications.`;
      }
    }

    $('btn-copy-report').addEventListener('click', async () => {
      const res = analyze();
      const md = [
        '# HOBA Forensic Analysis Report',
        `**Generated by:** https://hoba.work/analyze  `,
        `**Registry:** ${bundle.version} (schema ${bundle.schema_version})  `,
        `**Mode:** ${res.mode}  `,
        `**Verdict:** ${res.verdict} · agency zone: ${res.agency.agency_zone}`,
        '',
        '## H — Hard Facts',
        ...res.hard_facts.selected_artifacts.map((a) => `- **${a.id}**: ${a.title}`),
        res.hard_facts.stage ? `- **Confirmed Stage:** ${res.hard_facts.stage}` : '',
        '',
        '## O — Obstacle (Funnel Gates)',
        ...res.obstacle.identified_barriers.map((b) => `- **${b.id}** (${b.stage}): ${b.title} -> ${b.pass_condition}`),
        '',
        '## B — Behind Obstacle (Compatible Mechanisms)',
        ...res.behind.compatible_mechanisms.map((m) => `- **${m.mechanism.id}** [${m.removability}${m.honest_baseline ? ', honest baseline' : ''}]: ${m.mechanism.title}`),
        '',
        '### Related Patterns',
        ...(res.behind.related_patterns.map((p) => `- **${p.id}**: ${p.title}`).length ? res.behind.related_patterns.map((p) => `- **${p.id}**: ${p.title}`) : ['- None']),
        '',
        '### Non-Inferences',
        ...res.behind.non_inferences.map((ni) => `- ${ni}`),
        '',
        '## A — Agency & Probes',
        `- **Candidate Removable:** ${res.counts.candidate_removable}`,
        `- **Intermediary Dependent:** ${res.counts.intermediary}`,
        `- **Exogenous (No Agency):** ${res.counts.no_agency}`,
        '',
        '### Probes',
        ...(res.agency.diagnostic_probes.length ? res.agency.diagnostic_probes.map((p) => `- [${p.id}] ${p.action} (Cost: ${p.cost})`) : ['- None justified.']),
        '',
        `> ${res.epistemic_disclaimer}`,
        '',
      ].join('\n');
      try {
        await navigator.clipboard.writeText(md);
        alert('Diagnostic Markdown Report copied to clipboard!');
      } catch {
        alert('Clipboard access was denied by the browser.');
      }
    });

    $('btn-reset').addEventListener('click', () => {
      document.querySelectorAll<HTMLInputElement>('input[type="checkbox"], input[type="radio"]').forEach((el) => (el.checked = false));
      setStep('h');
    });

    setStep('h');
  </script>
</Layout>
