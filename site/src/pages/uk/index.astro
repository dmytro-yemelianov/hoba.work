---
import Layout from '../../layouts/Layout.astro';
import Mascot from '../../components/Mascot.astro';
import { countGraphNodes, getBundle, siteVersion } from '../../lib/registry';

const bundle = getBundle('uk');
const totalNodes = countGraphNodes(bundle);
---
<Layout title="Перетворюй результати найму на структуровані факти" lang="uk" activeNav="home">
  <!-- Hero Section -->
  <section class="relative py-12 md:py-20 border-b border-hoba-border overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-hoba-border bg-hoba-card text-xs font-mono text-hoba-muted mb-6">
          <span class="w-2 h-2 rounded-full bg-hoba-accent animate-pulse"></span>
          <span>Реєстр {bundle.version} · сайт v{siteVersion}</span>
          <span class="text-hoba-border">|</span>
          <span class="text-hoba-text">Домен: hoba.work</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-hoba-text font-mono">
          Перетворюй результати найму на <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-400">структуровані факти</span>.
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-hoba-muted leading-relaxed max-w-2xl font-sans">
          Сигнали під час найму часто є слабкими та неоднозначними. Коли результатом є тиша чи шаблонна відмова — не вигадуй історію: <strong class="text-hoba-text font-semibold">зупинись, відділи спостереження від інтерпретації та моделюй систему.</strong>
        </p>

        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a
            href="/uk/analyze"
            class="px-6 py-3 rounded-lg bg-hoba-accent hover:bg-blue-500 text-hoba-bg font-bold font-mono text-sm transition-all shadow-lg shadow-blue-500/10 flex items-center gap-2"
          >
            <span>Запустити HOBA Аналіз</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="/uk/registry"
            class="px-6 py-3 rounded-lg border border-hoba-border bg-hoba-card hover:bg-hoba-hover text-hoba-text font-mono text-sm transition-colors"
          >
            Відкрити Реєстр ({totalNodes} Сутностей)
          </a>
        </div>
      </div>

      <div class="lg:col-span-4 flex justify-center lg:justify-end">
        <div class="relative p-6 rounded-2xl border border-hoba-border bg-gradient-to-b from-hoba-card/80 to-hoba-card/20 backdrop-blur text-center">
          <Mascot className="w-44 h-44 mx-auto" />
          <div class="mt-2 text-xs font-mono text-hoba-muted">
            Поза <span class="text-hoba-accent font-bold">«хоба»</span>: пауза, спостереження, аналіз
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4-Step Protocol Grid -->
  <section class="py-16 border-b border-hoba-border">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs uppercase font-mono font-bold tracking-widest text-hoba-accent">Діагностична методологія</h2>
      <p class="text-2xl sm:text-3xl font-bold font-mono text-hoba-text mt-2">Протокол HOBA</p>
      <p class="text-sm text-hoba-muted mt-2">Структурована процедура, яка замінює румінацію та здогадки на фактологічну декомпозицію.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- H -->
      <div class="p-6 rounded-xl border border-hoba-border bg-hoba-card/50 flex flex-col">
        <div class="w-10 h-10 rounded-lg bg-purple-950/60 border border-purple-800/60 text-purple-300 font-mono font-black text-xl flex items-center justify-center mb-4">
          H
        </div>
        <h3 class="text-base font-bold font-mono text-hoba-text">Hard Facts (Факти)</h3>
        <p class="text-xs text-hoba-muted mt-2 leading-relaxed flex-1">
          Фіксуй лише безпосередні спостереження: отримані листи, пройдений етап, таймлайн. Жодного вгадування намірів.
        </p>
        <div class="mt-4 pt-3 border-t border-hoba-border/60 text-[11px] font-mono text-purple-400">
          Результат: Спостереження (A)
        </div>
      </div>

      <!-- O -->
      <div class="p-6 rounded-xl border border-hoba-border bg-hoba-card/50 flex flex-col">
        <div class="w-10 h-10 rounded-lg bg-emerald-950/60 border border-emerald-800/60 text-emerald-300 font-mono font-black text-xl flex items-center justify-center mb-4">
          O
        </div>
        <h3 class="text-base font-bold font-mono text-hoba-text">Obstacle (Бар’єр)</h3>
        <p class="text-xs text-hoba-muted mt-2 leading-relaxed flex-1">
          Локалізуй структурний шлюз у воронці найму, де процес зупинився (парсинг ATS, технічний скринінг, авторизація бюджету).
        </p>
        <div class="mt-4 pt-3 border-t border-hoba-border/60 text-[11px] font-mono text-emerald-400">
          Результат: Шлюз воронки (B)
        </div>
      </div>

      <!-- B -->
      <div class="p-6 rounded-xl border border-hoba-border bg-hoba-card/50 flex flex-col">
        <div class="w-10 h-10 rounded-lg bg-blue-950/60 border border-blue-800/60 text-blue-300 font-mono font-black text-xl flex items-center justify-center mb-4">
          B
        </div>
        <h3 class="text-base font-bold font-mono text-hoba-text">Behind (Механізми)</h3>
        <p class="text-xs text-hoba-muted mt-2 leading-relaxed flex-1">
          Перелік механізмів, сумісних із фактами. Зберігає об’єктивну базову оцінку кваліфікації поруч із системним тертям.
        </p>
        <div class="mt-4 pt-3 border-t border-hoba-border/60 text-[11px] font-mono text-blue-400">
          Результат: Сумісні механізми (M)
        </div>
      </div>

      <!-- A -->
      <div class="p-6 rounded-xl border border-hoba-border bg-hoba-card/50 flex flex-col">
        <div class="w-10 h-10 rounded-lg bg-amber-950/60 border border-amber-800/60 text-amber-300 font-mono font-black text-xl flex items-center justify-center mb-4">
          A
        </div>
        <h3 class="text-base font-bold font-mono text-hoba-text">Agency (Суб’єктність)</h3>
        <p class="text-xs text-hoba-muted mt-2 leading-relaxed flex-1">
          Розділи фактори впливу кандидата від посередників та макрофакторів. Формуй локальні діагностичні проби.
        </p>
        <div class="mt-4 pt-3 border-t border-hoba-border/60 text-[11px] font-mono text-amber-400">
          Результат: Проби та умова зупинки
        </div>
      </div>
    </div>
  </section>
</Layout>
