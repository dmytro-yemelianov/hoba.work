---
// Single static 404.html (Cloudflare Pages serves one for the whole site). The copy is
// rendered in both languages and the visible one is chosen client-side from the URL
// prefix / preference cookie, so /uk/… misses read Ukrainian.
import Layout from '../layouts/Layout.astro';
import Mascot from '../components/Mascot.astro';
import { LANGS, localePrefix, useTranslations } from '../i18n/utils';
---
<Layout lang="en" title={useTranslations('en')('nf.title')} activeNav="">
  {LANGS.map((lang) => {
    const t = useTranslations(lang);
    const prefix = localePrefix(lang);
    return (
      <section data-nf-lang={lang} class={`py-16 text-center max-w-2xl mx-auto ${lang === 'en' ? '' : 'hidden'}`} lang={lang}>
        <Mascot className="w-40 h-40 mx-auto" />
        <p class="mt-6 text-sm text-hoba-muted">{t('nf.kicker')}</p>
        <h1 class="mt-2 text-2xl font-semibold text-hoba-text">{t('nf.heading')}</h1>
        <p class="mt-4 text-sm text-hoba-muted leading-relaxed">{t('nf.text')}</p>
        <div class="mt-8 flex justify-center gap-3 text-sm">
          <a href={`${prefix}/registry`} class="px-5 py-2.5 rounded-md bg-hoba-accent hover:opacity-90 text-hoba-bg font-semibold transition-colors">{t('nf.registry')}</a>
          <a href={prefix || '/'} class="px-5 py-2.5 rounded-md border border-hoba-border bg-hoba-card hover:bg-hoba-hover text-hoba-text transition-colors">{t('common.home')}</a>
        </div>
      </section>
    );
  })}
  <script>
    const uk = /^\/uk(\/|$)/.test(location.pathname) || /(?:^|;\s*)hoba_lang=uk/.test(document.cookie);
    if (uk) {
      document.documentElement.lang = 'uk';
      document.querySelectorAll<HTMLElement>('[data-nf-lang]').forEach((el) => el.classList.toggle('hidden', el.dataset.nfLang !== 'uk'));
    }
  </script>
</Layout>
