---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Mascot from '../components/Mascot.astro';
import { LANGS, localePrefix, useTranslations } from '../i18n/utils';
---
<Layout lang="en" title={useTranslations('en')('nf.title')} activeNav="">
  {LANGS.map((lang) => {
    const t = useTranslations(lang);
    const prefix = localePrefix(lang);
    return (
      <div data-nf-lang={lang} class={lang === 'en' ? '' : 'hidden'} lang={lang}>
        <PageHeader kicker={t('nf.kicker')} title={t('nf.heading')} lead={t('nf.text')} />
        <div class="flex flex-wrap items-center gap-8">
          <Mascot className="w-28 h-28 shrink-0" />
          <div class="flex flex-wrap gap-3">
            <a href={`${prefix}/registry`} class="btn btn-primary">{t('nf.registry')}</a>
            <a href={prefix || '/'} class="btn btn-secondary">{t('common.home')}</a>
          </div>
        </div>
      </div>
    );
  })}
  <script>
    const uk = /^\/uk(\/|$)/.test(location.pathname) || /(?:^|;\s*)hoba_lang=uk/.test(document.cookie);
    if (uk) {
      document.documentElement.lang = 'uk';
      document.querySelectorAll<HTMLElement>('[data-nf-lang]').forEach((el) => el.classList.toggle('hidden', el.dataset.nfLang !== 'uk'));
    }
  </script>
</Layout>
