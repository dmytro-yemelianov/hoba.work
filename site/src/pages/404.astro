---
import Layout from '../layouts/Layout.astro';
import Mascot from '../components/Mascot.astro';
import { LANGS, localePrefix, useTranslations } from '../i18n/utils';
---
<Layout lang="en" title={useTranslations('en')('nf.title')} activeNav="">
  {LANGS.map((lang) => {
    const t = useTranslations(lang);
    const prefix = localePrefix(lang);
    return (
      <section data-nf-lang={lang} class={`py-16 max-w-2xl mx-auto text-center ${lang === 'en' ? '' : 'hidden'}`} lang={lang}>
        <Mascot className="w-32 h-32 mx-auto" />
        <p class="kicker mt-6">{t('nf.kicker')}</p>
        <h1 class="mt-2 text-2xl font-semibold text-hoba-text">{t('nf.heading')}</h1>
        <p class="mt-4 text-base text-hoba-muted">{t('nf.text')}</p>
        <div class="mt-8 flex justify-center gap-3">
          <a href={`${prefix}/registry`} class="btn btn-primary">{t('nf.registry')}</a>
          <a href={prefix || '/'} class="btn btn-secondary">{t('common.home')}</a>
        </div>
      </section>
    );
  })}
  <script>
    const uk = /^\/uk(\/|$)/.test(location.pathname) || /(?:^|;\s*)hoba_lang=uk/.test(document.cookie);
    if (uk) {
      document.documentElement.lang = 'uk';
      document.querySelectorAll<HTMLElement>('[data-nf-lang]').forEach((el) => el.classList.toggle('hidden', el.dataset.nfLang !== 'uk'));
    }
  </script>
</Layout>
