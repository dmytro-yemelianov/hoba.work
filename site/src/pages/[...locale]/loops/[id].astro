---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EntityBadge from '../../../components/EntityBadge.astro';
import EntityRow from '../../../components/EntityRow.astro';
import Specimen from '../../../components/Specimen.astro';
import IdealNote from '../../../components/IdealNote.astro';
import EraNote from '../../../components/EraNote.astro';
import { getBundle } from '../../../lib/registry';
import { asHeading, LANGS, localeParams, localePrefix, useTranslations, type Lang } from '../../../i18n/utils';
import type { LoopNode } from '@hoba/registry';

export async function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    getBundle(lang).loops.map((loop) => ({ params: { ...localeParams(lang), id: loop.id }, props: { lang, loop } }))
  );
}

const { lang, loop } = Astro.props as { lang: Lang; loop: LoopNode };
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
const memberMechanisms = bundle.mechanisms.filter((m) => loop.mechanisms.includes(m.id));
const breakingInterventions = bundle.interventions.filter((i) => loop.interventions.includes(i.id));
const titleOf = (id: string) => bundle.mechanisms.find((m) => m.id === id)?.title ?? id;
---
<Layout lang={lang} title={`${loop.id} — ${loop.title}`} description={loop.summary} activeNav="registry" image={`/cards/${lang}/${loop.id}.png`}>
  <PageHeader title={loop.title} lead={loop.summary}>
      <nav slot="eyebrow" class="text-sm text-hoba-muted flex flex-wrap items-center gap-2" aria-label="Breadcrumb">
        <a href={`${prefix}/registry`} class="hover:text-hoba-text">{t('common.registry')}</a><span>/</span>
        <a href={`${prefix}/registry?type=loop`} class="hover:text-hoba-text">{t('entity.plural.loop')}</a><span>/</span>
        <span class="text-hoba-accent font-mono">{loop.id}</span>
      </nav>
      <div slot="meta" class="flex flex-wrap items-center gap-1.5">
        <EntityBadge type="loop" id={loop.id} lang={lang} />
        <span class="pill pill-muted">{asHeading(t('common.evidence'))}: <span class="text-hoba-text">{t(`level.${loop.evidence_level}`)}</span></span>
      </div>
    </PageHeader>

  <div>
    <IdealNote id={loop.id} lang={lang} bundle={bundle} prefix={prefix} />
    <EraNote id={loop.id} lang={lang} bundle={bundle} prefix={prefix} />

    {loop.specimens.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t('specimen.section')}</h2>
        <p class="text-base text-hoba-muted max-w-3xl">{t('specimen.disclaimer')}</p>
        {loop.specimens.map((specimen) => <Specimen specimen={specimen} lang={lang} />)}
      </section>
    )}

    <section class="section">
      <h2 class="section-title">{t('loop.edges')}</h2>
      <ol class="row-list">
        {loop.edges.map((edge) => (
          <li class="py-3">
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-sm">
              <a href={`${prefix}/mechanisms/${edge.from}`} class="text-hoba-accent">{edge.from}</a>
              <span class="pill pill-muted">{t(`relation.${edge.relation}`)}</span>
              <a href={`${prefix}/mechanisms/${edge.to}`} class="text-hoba-accent">{edge.to}</a>
            </p>
            <p class="mt-1 text-base text-hoba-muted">
              {titleOf(edge.from)} <span class="text-hoba-text" aria-hidden="true">→</span> {titleOf(edge.to)}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section">
      <h2 class="section-title">{t('loop.members', { n: memberMechanisms.length })}</h2>
      <ul class="row-list">
        {memberMechanisms.map((m) => (
          <EntityRow
            id={m.id}
            title={m.title}
            href={`${prefix}/mechanisms/${m.id}`}
            pill={t(`removability.short.${m.facets.removability}`)}
            note={m.summary}
          />
        ))}
      </ul>
    </section>

    {breakingInterventions.length > 0 && (
      <section class="section">
        <h2 class="section-title">{asHeading(t('loop.interventions'))}</h2>
        <ul class="row-list">
          {breakingInterventions.map((i) => (
            <EntityRow id={i.id} title={i.title} href={`${prefix}/interventions/${i.id}`} note={i.summary} />
          ))}
        </ul>
      </section>
    )}

    <p class="mt-12 pt-4 border-t border-hoba-border text-sm text-hoba-muted flex flex-wrap items-center gap-x-3 gap-y-1">
      <span>{t('share.card')}</span>
      <a href={`/cards/${lang}/${loop.id}.png`} download class="text-hoba-accent underline underline-offset-2 font-mono">png</a>
      <span class="text-hoba-border" aria-hidden="true">|</span>
      <span>{t('md.view')}</span>
      <a href={`/loops/${loop.id}.md`} class="text-hoba-accent underline underline-offset-2 font-mono">markdown</a>
      <a href={`/api/v1/loops/${loop.id}.json`} target="_blank" class="text-hoba-accent underline underline-offset-2 font-mono">json</a>
    </p>
  </div>
</Layout>
