---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Mascot from '../../components/Mascot.astro';
import { branded, localeFromParams, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
---
<Layout lang={lang} title={t('about.title')} activeNav="about">
  <PageHeader kicker={t('about.kicker')} title={t('about.heading')}>
  <p slot="meta" class="text-lg text-hoba-muted">{t('about.sub.before')}<strong class="text-hoba-text">hoba.work</strong></p>
  </PageHeader>

  <article class="prose-hoba">
    <p>{t('about.p1.before')}<b class="wordmark">{t('about.p1.strong')}</b>{t('about.p1.after')}</p>
    <p><span set:html={branded(t('about.p2.before'))} /><strong class="text-hoba-text">{t('about.p2.strong')}</strong>{t('about.p2.after')}</p>
    <p>{t('about.p3.before')}<strong class="text-hoba-text">hoba.work</strong>{t('about.p3.after')}</p>

    <figure class="my-10">
      <Mascot className="w-28 h-28" />
      <figcaption class="mt-2 text-sm text-hoba-muted max-w-3xl">{t('about.mascot')}</figcaption>
    </figure>

    <h2 id="license">{t('about.author.title')}</h2>
    <p>{t('about.author.text.before')}<a href="https://github.com/dmytro-yemelianov">Dmytro Yemelianov</a>{t('about.author.text.after')}</p>
    <ul>
      <li>{t('about.license.content')} <a href="https://creativecommons.org/licenses/by-sa/4.0/">Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)</a></li>
      <li>{t('about.license.code')} <a href="https://opensource.org/licenses/MIT">MIT License</a></li>
    </ul>
  </article>
</Layout>
