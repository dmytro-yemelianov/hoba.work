---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EntityBadge from '../../../components/EntityBadge.astro';
import EntityRow from '../../../components/EntityRow.astro';
import Specimen from '../../../components/Specimen.astro';
import { getBundle } from '../../../lib/registry';
import { asHeading, LANGS, localePrefix, useTranslations, type Lang } from '../../../i18n/utils';
import type { BarrierNode } from '@hoba/registry';

export async function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    getBundle(lang).barriers.map((barrier) => ({ params: { locale: lang === 'uk' ? 'uk' : undefined, id: barrier.id }, props: { lang, barrier } }))
  );
}

const { lang, barrier } = Astro.props as { lang: Lang; barrier: BarrierNode };
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
const operatingMechanisms = bundle.mechanisms.filter((m) => m.operates_at.includes(barrier.id));
const precedingBarriers = bundle.barriers.filter((b) => b.precedes.includes(barrier.id));
const succeedingBarriers = bundle.barriers.filter((b) => barrier.precedes.includes(b.id));
const targetedInterventions = bundle.interventions.filter((i) => i.targets.includes(barrier.id));
---
<Layout lang={lang} title={`${barrier.id} — ${barrier.title}`} description={barrier.description} activeNav="registry">
  <PageHeader title={barrier.title} lead={barrier.description}>
      <nav slot="eyebrow" class="text-sm text-hoba-muted flex flex-wrap items-center gap-2" aria-label="Breadcrumb">
        <a href={`${prefix}/registry`} class="hover:text-hoba-text">{t('common.registry')}</a><span>/</span>
        <a href={`${prefix}/registry?type=barrier`} class="hover:text-hoba-text">{t('entity.plural.barrier')}</a><span>/</span>
        <span class="text-hoba-accent font-mono">{barrier.id}</span>
      </nav>
      <div slot="meta" class="flex flex-wrap items-center gap-1.5">
        <EntityBadge type="barrier" id={barrier.id} lang={lang} />
        <span class="pill pill-muted">{asHeading(t('common.stage'))}: <span class="text-hoba-text">{t(`stage.${barrier.stage}`)}</span></span>
        <span class="pill pill-muted">{t('bar.order', { n: barrier.order })}</span>
        <span class="pill pill-muted">{asHeading(t('common.evidence'))}: <span class="text-hoba-text">{t(`level.${barrier.evidence_level}`)}</span></span>
      </div>
    </PageHeader>

  <div>
    {barrier.specimens.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t('specimen.section')}</h2>
        <p class="text-base text-hoba-muted max-w-3xl">{t('specimen.disclaimer')}</p>
        {barrier.specimens.map((specimen) => <Specimen specimen={specimen} lang={lang} />)}
      </section>
    )}

    <div class="callout border-l-hoba-barrier">
      <h2 class="text-base font-semibold text-hoba-text">{asHeading(t('bar.pass'))}</h2>
      <p class="mt-1 text-base text-hoba-muted">{barrier.pass_condition}</p>
    </div>

    <section class="section grid grid-cols-1 sm:grid-cols-2 gap-x-10">
      <div>
        <h2 class="section-title">{asHeading(t('bar.precededBy'))}</h2>
        {precedingBarriers.length > 0 ? (
          <ul class="row-list">{precedingBarriers.map((b) => <EntityRow id={b.id} title={b.title} href={`${prefix}/barriers/${b.id}`} />)}</ul>
        ) : (
          <p class="text-base text-hoba-muted">{t('bar.initial')}</p>
        )}
      </div>
      <div class="mt-8 sm:mt-0">
        <h2 class="section-title">{asHeading(t('bar.precedes'))}</h2>
        {succeedingBarriers.length > 0 ? (
          <ul class="row-list">{succeedingBarriers.map((b) => <EntityRow id={b.id} title={b.title} href={`${prefix}/barriers/${b.id}`} />)}</ul>
        ) : (
          <p class="text-base text-hoba-muted">{t('bar.terminal')}</p>
        )}
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">{t('bar.mechanisms', { n: operatingMechanisms.length })}</h2>
      <ul class="row-list">
        {operatingMechanisms.map((m) => (
          <EntityRow
            id={m.id}
            title={m.title}
            href={`${prefix}/mechanisms/${m.id}`}
            pill={t(`removability.short.${m.facets.removability}`)}
            note={m.summary}
          />
        ))}
      </ul>
    </section>

    {targetedInterventions.length > 0 && (
      <section class="section">
        <h2 class="section-title">{asHeading(t('bar.interventions'))}</h2>
        <ul class="row-list">
          {targetedInterventions.map((i) => (
            <EntityRow id={i.id} title={i.title} href={`${prefix}/interventions/${i.id}`} note={i.summary} />
          ))}
        </ul>
      </section>
    )}

    <p class="mt-12 pt-4 border-t border-hoba-border text-sm text-hoba-muted flex flex-wrap items-center gap-2">
      <span>{t('common.machineEndpoint')}</span>
      <a href={`/api/v1/barriers/${barrier.id}.json`} target="_blank" class="text-hoba-accent underline underline-offset-2 font-mono">/api/v1/barriers/{barrier.id}.json</a>
    </p>
  </div>
</Layout>
