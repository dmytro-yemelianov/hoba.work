---
import Layout from '../../../layouts/Layout.astro';
import EntityBadge from '../../../components/EntityBadge.astro';
import RemovabilityBadge from '../../../components/RemovabilityBadge.astro';
import { getBundle } from '../../../lib/registry';
import { LANGS, localePrefix, useTranslations, type Lang } from '../../../i18n/utils';
import type { BarrierNode } from '@hoba/registry';

export async function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    getBundle(lang).barriers.map((barrier) => ({ params: { locale: lang === 'uk' ? 'uk' : undefined, id: barrier.id }, props: { lang, barrier } }))
  );
}

const { lang, barrier } = Astro.props as { lang: Lang; barrier: BarrierNode };
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
const operatingMechanisms = bundle.mechanisms.filter((m) => m.operates_at.includes(barrier.id));
const precedingBarriers = bundle.barriers.filter((b) => b.precedes.includes(barrier.id));
const succeedingBarriers = bundle.barriers.filter((b) => barrier.precedes.includes(b.id));
const targetedInterventions = bundle.interventions.filter((i) => i.targets.includes(barrier.id));
---
<Layout lang={lang} title={`${barrier.id} — ${barrier.title}`} description={barrier.description} activeNav="registry">
  <div class="max-w-4xl mx-auto space-y-8">
    <nav class="text-xs text-hoba-muted flex items-center gap-2" aria-label="Breadcrumb">
      <a href={`${prefix}/registry`} class="hover:text-hoba-text">{t('common.registry')}</a><span>/</span>
      <a href={`${prefix}/registry?type=barrier`} class="hover:text-hoba-text">{t('entity.plural.barrier')}</a><span>/</span>
      <span class="text-hoba-accent font-mono">{barrier.id}</span>
    </nav>

    <div class="p-6 rounded-md border border-hoba-border bg-hoba-card">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <EntityBadge type="barrier" id={barrier.id} size="md" lang={lang} />
        <div class="flex items-center gap-2 text-xs text-hoba-muted">
          <span class="px-2 py-0.5 rounded bg-hoba-bg text-emerald-700 dark:text-emerald-300 border border-hoba-border">{t('common.stage')}: {t(`stage.${barrier.stage}`)}</span><span>•</span>
          <span>{t('bar.order', { n: barrier.order })}</span>
        </div>
      </div>
      <h1 class="text-2xl font-semibold text-hoba-text">{barrier.title}</h1>
      <p class="text-sm text-hoba-muted mt-3 leading-relaxed">{barrier.description}</p>
      <div class="mt-4 p-3 rounded-md border border-hoba-border border-l-2 border-l-emerald-500 bg-hoba-card text-xs text-hoba-text">
        <strong class="text-emerald-700 dark:text-emerald-300">{t('bar.pass')}</strong> {barrier.pass_condition}
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
      <div class="p-4 rounded-md border border-hoba-border bg-hoba-card/50">
        <span class="text-hoba-muted font-semibold">{t('bar.precededBy')}</span>
        <div class="mt-2 space-y-1">
          {precedingBarriers.length > 0 ? precedingBarriers.map((b) => (
            <a href={`${prefix}/barriers/${b.id}`} class="block p-2 rounded bg-hoba-bg border border-hoba-border text-hoba-text hover:border-emerald-500/50"><span class="text-emerald-600 dark:text-emerald-400 font-semibold font-mono">{b.id}:</span> {b.title}</a>
          )) : <span class="text-hoba-muted italic">{t('bar.initial')}</span>}
        </div>
      </div>
      <div class="p-4 rounded-md border border-hoba-border bg-hoba-card/50">
        <span class="text-hoba-muted font-semibold">{t('bar.precedes')}</span>
        <div class="mt-2 space-y-1">
          {succeedingBarriers.length > 0 ? succeedingBarriers.map((b) => (
            <a href={`${prefix}/barriers/${b.id}`} class="block p-2 rounded bg-hoba-bg border border-hoba-border text-hoba-text hover:border-emerald-500/50"><span class="text-emerald-600 dark:text-emerald-400 font-semibold font-mono">{b.id}:</span> {b.title}</a>
          )) : <span class="text-hoba-muted italic">{t('bar.terminal')}</span>}
        </div>
      </div>
    </div>

    <div class="p-6 rounded-md border border-hoba-border bg-hoba-card">
      <h2 class="text-sm font-semibold text-hoba-text mb-4">{t('bar.mechanisms', { n: operatingMechanisms.length })}</h2>
      <div class="space-y-2">
        {operatingMechanisms.map((m) => (
          <a href={`${prefix}/mechanisms/${m.id}`} class="p-3 rounded-md border border-hoba-border bg-hoba-bg hover:border-blue-500/50 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
            <div>
              <span class="font-semibold text-blue-600 dark:text-blue-400 font-mono">{m.id}:</span>
              <span class="font-semibold text-hoba-text ml-1">{m.title}</span>
              <p class="text-hoba-muted text-sm mt-0.5">{m.summary}</p>
            </div>
            <RemovabilityBadge removability={m.facets.removability} lang={lang} />
          </a>
        ))}
      </div>
    </div>

    {targetedInterventions.length > 0 && (
      <div class="p-6 rounded-md border border-hoba-border border-l-2 border-l-cyan-500 bg-hoba-card text-sm">
        <h2 class="font-semibold text-cyan-700 dark:text-cyan-300 mb-3">{t('bar.interventions')}</h2>
        <div class="space-y-2">
          {targetedInterventions.map((i) => (
            <a href={`${prefix}/interventions/${i.id}`} class="p-3 rounded-md bg-hoba-card border border-hoba-border border-l-2 border-l-cyan-500 block hover:bg-hoba-hover">
              <span class="font-semibold text-cyan-600 dark:text-cyan-400 font-mono">{i.id}:</span> <strong class="text-hoba-text">{i.title}</strong>
              <p class="text-hoba-muted mt-1">{i.summary}</p>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="p-4 rounded-md border border-hoba-border bg-hoba-card flex items-center justify-between text-xs text-hoba-muted gap-2 flex-wrap">
      <span>{t('common.machineEndpoint')}</span>
      <a href={`/api/v1/barriers/${barrier.id}.json`} target="_blank" class="text-hoba-accent hover:underline font-mono">/api/v1/barriers/{barrier.id}.json</a>
    </div>
  </div>
</Layout>
