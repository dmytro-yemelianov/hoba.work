---
import Layout from '../../../layouts/Layout.astro';
import EntityBadge from '../../../components/EntityBadge.astro';
import RemovabilityBadge from '../../../components/RemovabilityBadge.astro';
import { getBundle } from '../../../lib/registry';
import { LANGS, localePrefix, useTranslations, type Lang } from '../../../i18n/utils';
import type { MechanismNode } from '@hoba/registry';

export async function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    getBundle(lang).mechanisms.map((mechanism) => ({ params: { locale: lang === 'uk' ? 'uk' : undefined, id: mechanism.id }, props: { lang, mechanism } }))
  );
}

const { lang, mechanism } = Astro.props as { lang: Lang; mechanism: MechanismNode };
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
const operatingBarriers = bundle.barriers.filter((b) => mechanism.operates_at.includes(b.id));
const amplifiedMechanisms = bundle.mechanisms.filter((m) => mechanism.amplifies.includes(m.id));
const maskedMechanisms = bundle.mechanisms.filter((m) => mechanism.masks.includes(m.id));
const targetingInterventions = bundle.interventions.filter((i) => i.targets.includes(mechanism.id));
const participatingLoops = bundle.loops.filter((l) => l.mechanisms.includes(mechanism.id));
const facets = [
  { label: t('facet.actor'), value: t(`actor.${mechanism.facets.actor}`) },
  { label: t('facet.nature'), value: t(`nature.${mechanism.facets.nature}`) },
  { label: t('facet.visibility'), value: t(`visibility.${mechanism.facets.visibility}`) },
  { label: t('facet.removability'), value: t(`removability.short.${mechanism.facets.removability}`) },
];
---
<Layout lang={lang} title={`${mechanism.id} — ${mechanism.title}`} description={mechanism.summary} activeNav="registry">
  <div class="max-w-4xl mx-auto space-y-8">
    <nav class="text-xs text-hoba-muted flex items-center gap-2" aria-label="Breadcrumb">
      <a href={`${prefix}/registry`} class="hover:text-hoba-text">{t('common.registry')}</a><span>/</span>
      <a href={`${prefix}/registry?type=mechanism`} class="hover:text-hoba-text">{t('entity.plural.mechanism')}</a><span>/</span>
      <span class="text-hoba-accent font-mono">{mechanism.id}</span>
    </nav>

    <div class="p-6 rounded-md border border-hoba-border bg-hoba-card">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <EntityBadge type="mechanism" id={mechanism.id} size="md" lang={lang} />
        <div class="flex items-center gap-2">
          {mechanism.honest_baseline && <span class="text-xs px-2 py-0.5 rounded bg-hoba-bg text-emerald-700 dark:text-emerald-300 border border-hoba-border font-semibold">{t('mech.honest')}</span>}
          <RemovabilityBadge removability={mechanism.facets.removability} lang={lang} />
        </div>
      </div>
      <h1 class="text-2xl font-semibold text-hoba-text">{mechanism.title}</h1>
      <p class="text-sm text-hoba-muted mt-3 leading-relaxed">{mechanism.summary}</p>
    </div>

    <div class="p-6 rounded-md border border-hoba-border bg-hoba-card/50">
      <h2 class="text-xs font-medium text-hoba-muted mb-4">{t('mech.facets')}</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
        {facets.map((f) => (
          <div class="p-3 rounded-md bg-hoba-bg border border-hoba-border">
            <span class="text-hoba-muted text-xs block">{f.label}</span>
            <span class="font-semibold text-hoba-text">{f.value}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="p-6 rounded-md border border-hoba-border bg-hoba-card">
      <h2 class="text-sm font-semibold text-hoba-text mb-3">{t('mech.barriers')}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
        {operatingBarriers.map((b) => (
          <a href={`${prefix}/barriers/${b.id}`} class="p-2.5 rounded bg-hoba-bg border border-hoba-border hover:border-emerald-500/50 block">
            <span class="text-emerald-700 dark:text-emerald-400 font-semibold font-mono">{b.id}:</span> <span class="text-hoba-text">{b.title}</span>
            <span class="text-xs text-hoba-muted block mt-0.5">{t('common.stage')}: {t(`stage.${b.stage}`)}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="p-6 rounded-md border border-hoba-border bg-hoba-card">
      <h2 class="text-sm font-semibold text-hoba-text mb-3">{t('mech.emitted')}</h2>
      <div class="space-y-2">
        {mechanism.emissions.map((em) => {
          const art = bundle.artifacts.find((a) => a.id === em.artifact);
          return (
            <a href={`${prefix}/artifacts/${em.artifact}`} class="p-3 rounded-md bg-hoba-bg border border-hoba-border hover:border-purple-500/50 block text-xs">
              <div class="flex items-center justify-between mb-1">
                <span class="font-semibold text-purple-700 dark:text-purple-300">{em.artifact}</span>
                <span class="text-xs px-1.5 py-0.5 rounded bg-hoba-card text-hoba-muted border border-hoba-border">{t('mech.fidelity', { f: t(`fidelity.${em.fidelity ?? 'unspecified'}`) })}</span>
              </div>
              <div class="font-semibold text-hoba-text">{art?.title ?? em.artifact}</div>
            </a>
          );
        })}
      </div>
    </div>

    <div class="p-6 rounded-md border border-hoba-border border-l-2 border-l-rose-500 bg-hoba-card text-sm">
      <h2 class="font-semibold text-rose-700 dark:text-rose-300 mb-2">{t('mech.nonInf')}</h2>
      <ul class="space-y-1.5 text-hoba-text list-disc list-inside">{mechanism.non_inferences.map((ni) => <li>{ni}</li>)}</ul>
    </div>

    {(amplifiedMechanisms.length > 0 || maskedMechanisms.length > 0 || participatingLoops.length > 0) && (
      <div class="p-6 rounded-md border border-hoba-border bg-hoba-card space-y-4 text-sm">
        <h2 class="text-sm font-semibold text-hoba-text">{t('mech.causal')}</h2>
        {amplifiedMechanisms.length > 0 && (
          <div>
            <span class="text-hoba-muted font-semibold text-xs">{t('mech.amplifies')}</span>
            <div class="mt-1 space-y-1">{amplifiedMechanisms.map((am) => <a href={`${prefix}/mechanisms/${am.id}`} class="block p-2 rounded bg-hoba-bg border border-hoba-border text-hoba-text hover:underline"><span class="text-blue-700 dark:text-blue-400 font-semibold font-mono">{am.id}:</span> {am.title}</a>)}</div>
          </div>
        )}
        {maskedMechanisms.length > 0 && (
          <div>
            <span class="text-hoba-muted font-semibold text-xs">{t('mech.masks')}</span>
            <div class="mt-1 space-y-1">{maskedMechanisms.map((mm) => <a href={`${prefix}/mechanisms/${mm.id}`} class="block p-2 rounded bg-hoba-bg border border-hoba-border text-hoba-text hover:underline"><span class="text-blue-700 dark:text-blue-400 font-semibold font-mono">{mm.id}:</span> {mm.title}</a>)}</div>
          </div>
        )}
        {participatingLoops.length > 0 && (
          <div>
            <span class="text-pink-700 dark:text-pink-400 font-semibold text-xs">{t('mech.loops')}</span>
            <div class="mt-1 space-y-1">{participatingLoops.map((lp) => <a href={`${prefix}/loops/${lp.id}`} class="block p-2 rounded bg-hoba-bg border border-hoba-border text-hoba-text hover:underline"><span class="font-semibold font-mono">{lp.id}:</span> {lp.title}</a>)}</div>
          </div>
        )}
      </div>
    )}

    {targetingInterventions.length > 0 && (
      <div class="p-6 rounded-md border border-hoba-border border-l-2 border-l-cyan-500 bg-hoba-card text-sm">
        <h2 class="font-semibold text-cyan-700 dark:text-cyan-300 mb-3">{t('mech.interventions')}</h2>
        <div class="space-y-2">
          {targetingInterventions.map((i) => (
            <a href={`${prefix}/interventions/${i.id}`} class="p-3 rounded-md bg-hoba-card border border-hoba-border border-l-2 border-l-cyan-500 block hover:bg-hoba-hover">
              <span class="font-semibold text-cyan-700 dark:text-cyan-400 font-mono">{i.id}:</span> <strong class="text-hoba-text">{i.title}</strong>
              <p class="text-hoba-muted mt-1">{i.summary}</p>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="p-4 rounded-md border border-hoba-border bg-hoba-card flex items-center justify-between text-xs text-hoba-muted gap-2 flex-wrap">
      <span>{t('common.machineEndpoint')}</span>
      <a href={`/api/v1/mechanisms/${mechanism.id}.json`} target="_blank" class="text-hoba-accent hover:underline font-mono">/api/v1/mechanisms/{mechanism.id}.json</a>
    </div>
  </div>
</Layout>
