---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EntityBadge from '../../../components/EntityBadge.astro';
import EntityRow from '../../../components/EntityRow.astro';
import RemovabilityBadge from '../../../components/RemovabilityBadge.astro';
import { getBundle } from '../../../lib/registry';
import { asHeading, LANGS, localePrefix, useTranslations, type Lang } from '../../../i18n/utils';
import type { MechanismNode } from '@hoba/registry';

export async function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    getBundle(lang).mechanisms.map((mechanism) => ({ params: { locale: lang === 'uk' ? 'uk' : undefined, id: mechanism.id }, props: { lang, mechanism } }))
  );
}

const { lang, mechanism } = Astro.props as { lang: Lang; mechanism: MechanismNode };
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
const operatingBarriers = bundle.barriers.filter((b) => mechanism.operates_at.includes(b.id));
const amplifiedMechanisms = bundle.mechanisms.filter((m) => mechanism.amplifies.includes(m.id));
const maskedMechanisms = bundle.mechanisms.filter((m) => mechanism.masks.includes(m.id));
const targetingInterventions = bundle.interventions.filter((i) => i.targets.includes(mechanism.id));
const participatingLoops = bundle.loops.filter((l) => l.mechanisms.includes(mechanism.id));
const facets = [
  { label: t('facet.actor'), value: t(`actor.${mechanism.facets.actor}`) },
  { label: t('facet.nature'), value: t(`nature.${mechanism.facets.nature}`) },
  { label: t('facet.visibility'), value: t(`visibility.${mechanism.facets.visibility}`) },
  { label: t('facet.removability'), value: t(`removability.short.${mechanism.facets.removability}`) },
  { label: asHeading(t('common.evidence')), value: t(`level.${mechanism.evidence_level}`) },
];
---
<Layout lang={lang} title={`${mechanism.id} — ${mechanism.title}`} description={mechanism.summary} activeNav="registry">
  <article>
    <PageHeader title={mechanism.title} lead={mechanism.summary}>
      <nav slot="eyebrow" class="text-sm text-hoba-muted flex flex-wrap items-center gap-2" aria-label="Breadcrumb">
        <a href={`${prefix}/registry`} class="hover:text-hoba-text">{t('common.registry')}</a><span>/</span>
        <a href={`${prefix}/registry?type=mechanism`} class="hover:text-hoba-text">{t('entity.plural.mechanism')}</a><span>/</span>
        <span class="text-hoba-accent font-mono">{mechanism.id}</span>
      </nav>
      <Fragment slot="meta">
        <div class="flex flex-wrap items-center gap-1.5">
          <EntityBadge type="mechanism" id={mechanism.id} lang={lang} />
          <RemovabilityBadge removability={mechanism.facets.removability} lang={lang} />
          {mechanism.honest_baseline && <span class="pill"><span class="dot bg-hoba-barrier" aria-hidden="true"></span>{t('mech.honest')}</span>}
          {facets.map((f) => <span class="pill pill-muted">{f.label}: <span class="text-hoba-text">{f.value}</span></span>)}
        </div>
      </Fragment>
    </PageHeader>

    <section class="section">
      <h2 class="section-title">{t('mech.barriers')}</h2>
      <ul class="row-list">
        {operatingBarriers.map((b) => (
          <EntityRow id={b.id} title={b.title} href={`${prefix}/barriers/${b.id}`} pill={t(`stage.${b.stage}`)} />
        ))}
      </ul>
    </section>

    {mechanism.emissions.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t('mech.emitted')}</h2>
        <ul class="row-list">
          {mechanism.emissions.map((em) => (
            <EntityRow
              id={em.artifact}
              title={bundle.artifacts.find((a) => a.id === em.artifact)?.title ?? em.artifact}
              href={`${prefix}/artifacts/${em.artifact}`}
              pill={t('mech.fidelity', { f: t(`fidelity.${em.fidelity ?? 'unspecified'}`) })}
            />
          ))}
        </ul>
      </section>
    )}

    <div class="callout border-l-hoba-exogenous">
      <h2 class="text-base font-semibold text-hoba-text">{asHeading(t('mech.nonInf'))}</h2>
      <ul class="mt-2 list-disc pl-5 space-y-1 text-base text-hoba-muted">{mechanism.non_inferences.map((ni) => <li>{ni}</li>)}</ul>
    </div>

    {(amplifiedMechanisms.length > 0 || maskedMechanisms.length > 0 || participatingLoops.length > 0) && (
      <section class="section">
        <h2 class="section-title">{t('mech.causal')}</h2>
        <ul class="row-list">
          {amplifiedMechanisms.map((am) => (
            <EntityRow id={am.id} title={am.title} href={`${prefix}/mechanisms/${am.id}`} pill={t('relation.amplifies')} />
          ))}
          {maskedMechanisms.map((mm) => (
            <EntityRow id={mm.id} title={mm.title} href={`${prefix}/mechanisms/${mm.id}`} pill={t('relation.masks')} />
          ))}
          {participatingLoops.map((lp) => (
            <EntityRow id={lp.id} title={lp.title} href={`${prefix}/loops/${lp.id}`} pill={t('entity.loop')} />
          ))}
        </ul>
      </section>
    )}

    {targetingInterventions.length > 0 && (
      <section class="section">
        <h2 class="section-title">{asHeading(t('mech.interventions'))}</h2>
        <ul class="row-list">
          {targetingInterventions.map((i) => (
            <EntityRow id={i.id} title={i.title} href={`${prefix}/interventions/${i.id}`} note={i.summary} />
          ))}
        </ul>
      </section>
    )}

    <p class="mt-12 pt-4 border-t border-hoba-border text-sm text-hoba-muted flex flex-wrap items-center gap-2">
      <span>{t('common.machineEndpoint')}</span>
      <a href={`/api/v1/mechanisms/${mechanism.id}.json`} target="_blank" class="text-hoba-accent underline underline-offset-2 font-mono">/api/v1/mechanisms/{mechanism.id}.json</a>
    </p>
  </article>
</Layout>
