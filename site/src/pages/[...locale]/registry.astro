---
import Layout from '../../layouts/Layout.astro';
import EntityBadge from '../../components/EntityBadge.astro';
import RemovabilityBadge from '../../components/RemovabilityBadge.astro';
import PageHeader from '../../components/PageHeader.astro';
import ViewSwitch from '../../components/ViewSwitch.astro';
import type { RemovabilityType, StageId } from '@hoba/registry';
import { countGraphNodes, getBundle } from '../../lib/registry';
import { localeFromParams, localePrefix, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);

type EntityType = 'artifact' | 'barrier' | 'mechanism' | 'pattern' | 'loop' | 'intervention';
interface Item {
  id: string;
  type: EntityType;
  title: string;
  text: string;
  link: string;
  evidenceLevel: string;
  stage?: StageId | StageId[];
  removability?: RemovabilityType;
}

const items: Item[] = [
  ...bundle.artifacts.map<Item>((a) => ({ id: a.id, type: 'artifact', title: a.title, text: a.summary, link: `${prefix}/artifacts/${a.id}`, evidenceLevel: a.evidence_level, stage: a.stages })),
  ...bundle.barriers.map<Item>((b) => ({ id: b.id, type: 'barrier', title: b.title, text: b.description, link: `${prefix}/barriers/${b.id}`, evidenceLevel: b.evidence_level, stage: b.stage })),
  ...bundle.mechanisms.map<Item>((m) => ({ id: m.id, type: 'mechanism', title: m.title, text: m.summary, link: `${prefix}/mechanisms/${m.id}`, evidenceLevel: m.evidence_level, removability: m.facets.removability })),
  ...bundle.patterns.map<Item>((p) => ({ id: p.id, type: 'pattern', title: p.title, text: p.summary, link: `${prefix}/patterns/${p.id}`, evidenceLevel: p.evidence_level })),
  ...bundle.loops.map<Item>((l) => ({ id: l.id, type: 'loop', title: l.title, text: l.summary, link: `${prefix}/loops/${l.id}`, evidenceLevel: l.evidence_level })),
  ...bundle.interventions.map<Item>((i) => ({ id: i.id, type: 'intervention', title: i.title, text: i.summary, link: `${prefix}/interventions/${i.id}`, evidenceLevel: i.evidence_level })),
];

const totalCount = countGraphNodes(bundle);
const stageLabels = (stage: Item['stage']): string[] => (Array.isArray(stage) ? stage.map((s) => t(`stage.${s}`)) : stage ? [t(`stage.${stage}`)] : []);
const dataAttrs = (node: Item) => ({
  'data-type': node.type,
  'data-id': node.id.toLowerCase(),
  'data-title': node.title.toLowerCase(),
  'data-text': `${node.text} ${stageLabels(node.stage).join(' ')}`.toLowerCase(),
  'data-removability': node.removability ?? '',
});
const tabs: { type: EntityType | 'all'; label: string; count: number }[] = [
  { type: 'all', label: t('registry.all'), count: totalCount },
  { type: 'artifact', label: t('entity.plural.artifact'), count: bundle.artifacts.length },
  { type: 'barrier', label: t('entity.plural.barrier'), count: bundle.barriers.length },
  { type: 'mechanism', label: t('entity.plural.mechanism'), count: bundle.mechanisms.length },
  { type: 'pattern', label: t('entity.plural.pattern'), count: bundle.patterns.length },
  { type: 'loop', label: t('entity.plural.loop'), count: bundle.loops.length },
  { type: 'intervention', label: t('entity.plural.intervention'), count: bundle.interventions.length },
];
const agency: { key: RemovabilityType | 'all'; label: string; dot?: string }[] = [
  { key: 'all', label: t('removability.all') },
  { key: 'candidate', label: t('removability.candidate'), dot: 'bg-emerald-500' },
  { key: 'intermediary', label: t('removability.intermediary'), dot: 'bg-amber-500' },
  { key: 'none', label: t('removability.none'), dot: 'bg-rose-500' },
];
---
<Layout lang={lang} title={t('registry.title')} activeNav="registry" width="app">
  <PageHeader kicker={t('registry.kicker', { version: bundle.version })} title={t('registry.title')} lead={t('registry.intro', { n: totalCount })} wide>
    <Fragment slot="actions">
      <ViewSwitch lang={lang} />
      <a href="/openapi.json" target="_blank" class="text-sm font-mono text-hoba-accent underline underline-offset-2">openapi.json</a>
      <a href="/data/latest/registry.json" target="_blank" class="text-sm font-mono text-hoba-accent underline underline-offset-2">registry.json</a>
    </Fragment>
  </PageHeader>

  <div class="space-y-4 mb-8">
    <div class="relative max-w-xl">
      <label for="search-input" class="sr-only">{t('registry.search')}</label>
      <input type="text" id="search-input" placeholder={t('registry.search')} class="w-full rounded-md border border-hoba-border bg-hoba-card pl-10 pr-4 py-2 text-base text-hoba-text placeholder-hoba-muted focus:outline-none focus:border-hoba-accent" />
      <svg class="w-4 h-4 text-hoba-muted absolute left-3 top-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>
    <div class="flex flex-wrap gap-2" role="tablist" aria-label={t('registry.typeTabs')}>
      {tabs.map((tab) => (
        <button type="button" role="tab" class={`type-tab pill ${tab.type === 'all' ? 'pill-active' : 'pill-muted hover:text-hoba-text'}`} data-type={tab.type} aria-selected={tab.type === 'all' ? 'true' : 'false'}>
          {tab.label} <span class="font-mono">{tab.count}</span>
        </button>
      ))}
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="meta mr-1">{t('registry.filterAgency')}</span>
      {agency.map((a) => (
        <button type="button" class={`removability-filter pill ${a.key === 'all' ? 'pill-active' : 'pill-muted hover:text-hoba-text'}`} data-removability={a.key} aria-pressed={a.key === 'all' ? 'true' : 'false'}>
          {a.dot && <span class={`dot ${a.dot}`} aria-hidden="true"></span>}{a.label}
        </button>
      ))}
    </div>
  </div>

  <div data-view-root>
    <div data-view="table" class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">{t('table.id')}</th>
            <th scope="col">{t('table.type')}</th>
            <th scope="col">{t('table.title')}</th>
            <th scope="col">{t('table.context')}</th>
            <th scope="col">{t('table.evidence')}</th>
          </tr>
        </thead>
        <tbody>
          {items.map((node) => (
            <tr class="node-item hover:bg-hoba-hover" {...dataAttrs(node)}>
              <td class="font-mono text-sm whitespace-nowrap"><a href={node.link} class="text-hoba-accent hover:underline">{node.id}</a></td>
              <td class="whitespace-nowrap"><EntityBadge type={node.type} lang={lang} /></td>
              <td><a href={node.link} class="font-medium text-hoba-text hover:underline">{node.title}</a><p class="text-sm text-hoba-muted line-clamp-1">{node.text}</p></td>
              <td class="whitespace-nowrap">
                {node.removability ? <RemovabilityBadge removability={node.removability} lang={lang} /> : stageLabels(node.stage).length ? <span class="flex flex-wrap gap-1">{stageLabels(node.stage).map((s) => <span class="pill pill-muted">{s}</span>)}</span> : <span class="text-hoba-muted">—</span>}
              </td>
              <td class="whitespace-nowrap"><span class="pill pill-muted">{t(`level.${node.evidenceLevel as 'established'}`)}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div data-view="list" class="row-list border-t border-hoba-border">
      {items.map((node) => (
        <a href={node.link} class="node-item row-link text-base" {...dataAttrs(node)}>
          <span class="font-mono text-sm text-hoba-accent w-16 shrink-0">{node.id}</span>
          <span class="font-medium text-hoba-text">{node.title}</span>
          <span class="text-sm text-hoba-muted truncate hidden md:inline flex-1 min-w-0">{node.text}</span>
        </a>
      ))}
    </div>

    <div data-view="cards">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {items.map((node) => (
          <a href={node.link} class="node-item rounded-md border border-hoba-border bg-hoba-card p-4 hover:bg-hoba-hover transition-colors flex flex-col gap-3" {...dataAttrs(node)}>
            <div class="flex flex-wrap items-center gap-2">
              <EntityBadge type={node.type} id={node.id} lang={lang} />
              {node.removability && <RemovabilityBadge removability={node.removability} lang={lang} />}
              {stageLabels(node.stage).slice(0, 1).map((s) => <span class="pill pill-muted">{s}</span>)}
            </div>
            <div>
              <h3 class="text-base font-semibold text-hoba-text">{node.title}</h3>
              <p class="mt-1 text-sm text-hoba-muted line-clamp-3">{node.text}</p>
            </div>
            <p class="meta mt-auto">{t('common.evidence')}: {t(`level.${node.evidenceLevel as 'established'}`)}</p>
          </a>
        ))}
      </div>
    </div>
  </div>

  <p id="no-results" class="hidden py-16 text-center text-hoba-muted text-base">{t('registry.noResults')}</p>

  <script>
    const TYPES = ['all', 'artifact', 'barrier', 'mechanism', 'pattern', 'loop', 'intervention'];
    const setActive = (el: Element, on: boolean) => {
      el.classList.toggle('pill-active', on);
      el.classList.toggle('pill-muted', !on);
      el.classList.toggle('hover:text-hoba-text', !on);
    };

    let activeType = 'all';
    let activeRemovability = 'all';
    let searchQuery = '';

    const items = document.querySelectorAll<HTMLElement>('.node-item');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const typeTabs = document.querySelectorAll<HTMLButtonElement>('.type-tab');
    const removabilityFilters = document.querySelectorAll<HTMLButtonElement>('.removability-filter');
    const noResults = document.getElementById('no-results');

    function applyFilters() {
      let visibleCount = 0;
      const activeView = document.documentElement.dataset.view ?? 'table';
      items.forEach((item) => {
        const matchesType = activeType === 'all' || item.dataset.type === activeType;
        const matchesRemovability = activeRemovability === 'all' || item.dataset.removability === activeRemovability;
        const matchesSearch = !searchQuery || (item.dataset.id ?? '').includes(searchQuery) || (item.dataset.title ?? '').includes(searchQuery) || (item.dataset.text ?? '').includes(searchQuery);
        const visible = matchesType && matchesRemovability && matchesSearch;
        item.classList.toggle('hidden', !visible);
        if (visible && item.closest('[data-view]')?.getAttribute('data-view') === activeView) visibleCount++;
      });
      noResults?.classList.toggle('hidden', visibleCount !== 0);
    }

    function selectType(type: string) {
      activeType = TYPES.includes(type) ? type : 'all';
      typeTabs.forEach((tab) => {
        const on = tab.dataset.type === activeType;
        setActive(tab, on);
        tab.setAttribute('aria-selected', String(on));
      });
      const url = new URL(window.location.href);
      if (activeType === 'all') url.searchParams.delete('type');
      else url.searchParams.set('type', activeType);
      history.replaceState(null, '', url);
      applyFilters();
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilters();
    });
    typeTabs.forEach((tab) => tab.addEventListener('click', () => selectType(tab.dataset.type ?? 'all')));
    removabilityFilters.forEach((rf) => {
      rf.addEventListener('click', () => {
        activeRemovability = rf.dataset.removability ?? 'all';
        removabilityFilters.forEach((r) => {
          const on = r === rf;
          setActive(r, on);
          r.setAttribute('aria-pressed', String(on));
        });
        applyFilters();
      });
    });
    window.addEventListener('hoba:view', applyFilters);

    const initialType = new URLSearchParams(window.location.search).get('type');
    if (initialType) selectType(initialType);
  </script>
</Layout>
