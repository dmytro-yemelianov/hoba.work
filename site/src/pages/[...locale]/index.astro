---
import Layout from '../../layouts/Layout.astro';
import Mascot from '../../components/Mascot.astro';
import { countGraphNodes, getBundle, siteVersion } from '../../lib/registry';
import { localeFromParams, localePrefix, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
const totalNodes = countGraphNodes(bundle);

const steps = [
  { k: 'h', letter: 'H', color: 'purple' },
  { k: 'o', letter: 'O', color: 'emerald' },
  { k: 'b', letter: 'B', color: 'blue' },
  { k: 'a', letter: 'A', color: 'amber' },
] as const;
const stepBox: Record<string, string> = {
  purple: 'bg-hoba-bg border-hoba-border text-purple-700 dark:text-purple-300',
  emerald: 'bg-hoba-bg border-hoba-border text-emerald-700 dark:text-emerald-300',
  blue: 'bg-hoba-bg border-hoba-border text-blue-700 dark:text-blue-300',
  amber: 'bg-hoba-bg border-hoba-border text-amber-700 dark:text-amber-300',
};
const stepOut: Record<string, string> = { purple: 'text-purple-600 dark:text-purple-400', emerald: 'text-emerald-600 dark:text-emerald-400', blue: 'text-blue-600 dark:text-blue-400', amber: 'text-amber-600 dark:text-amber-400' };
---
<Layout lang={lang} title={t('home.title')} activeNav="home">
  <section class="relative py-12 md:py-20 border-b border-hoba-border overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-8">
        <p class="text-sm font-mono text-hoba-muted mb-6">{t('home.badge', { registry: bundle.version, site: siteVersion })} · {t('home.canonical')}</p>

        <h1 class="text-3xl font-semibold text-hoba-text leading-tight">
          {t('home.h1.before')}<span class="text-hoba-accent">{t('home.h1.accent')}</span>.
        </h1>

        <p class="mt-6 text-sm text-hoba-muted leading-relaxed max-w-2xl font-sans">
          {t('home.lead.before')}<strong class="text-hoba-text font-semibold">{t('home.lead.strong')}</strong>
        </p>

        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a href={`${prefix}/analyze`} class="px-6 py-3 rounded-md bg-hoba-accent hover:opacity-90 text-hoba-bg font-semibold text-sm transition-all flex items-center gap-2">
            <span>{t('home.cta.analyze')}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href={`${prefix}/registry`} class="px-6 py-3 rounded-md border border-hoba-border bg-hoba-card hover:bg-hoba-hover text-hoba-text text-sm transition-colors">
            {t('home.cta.registry', { n: totalNodes })}
          </a>
        </div>
      </div>

      <div class="lg:col-span-4 flex justify-center lg:justify-end">
        <div class="relative p-6 rounded-md border border-hoba-border bg-hoba-card text-center">
          <Mascot className="w-44 h-44 mx-auto" />
          <div class="mt-2 text-xs text-hoba-muted">
            {t('home.pose.before')}<span class="text-hoba-accent font-semibold">хоба</span>{t('home.pose.after')}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-b border-hoba-border">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-medium text-hoba-muted">{t('home.protocol.kicker')}</h2>
      <p class="text-2xl font-semibold text-hoba-text mt-2">{t('home.protocol.title')}</p>
      <p class="text-sm text-hoba-muted mt-2">{t('home.protocol.sub')}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((s) => (
        <div class="p-6 rounded-md border border-hoba-border bg-hoba-card/50 hover:border-hoba-accent/40 transition-colors flex flex-col">
          <div class={`w-10 h-10 rounded-md border font-semibold text-lg flex items-center justify-center mb-4 ${stepBox[s.color]}`}>{s.letter}</div>
          <h3 class="text-sm font-semibold text-hoba-text">{t(`home.step.${s.k}.title`)}</h3>
          <p class="text-sm text-hoba-muted mt-2 leading-relaxed flex-1">{t(`home.step.${s.k}.text`)}</p>
          <div class={`mt-4 pt-3 border-t border-hoba-border/60 text-xs ${stepOut[s.color]}`}>{t(`home.step.${s.k}.out`)}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {(['1', '2', '3'] as const).map((n) => (
        <div class="p-6 rounded-md border border-hoba-border bg-hoba-card/30">
          <div class={`text-xs font-semibold mb-2 ${n === '1' ? 'text-hoba-accent' : n === '2' ? 'text-hoba-pattern' : 'text-hoba-intervention'}`}>{t(`home.pillar${n}.kicker`)}</div>
          <h3 class="text-lg font-semibold text-hoba-text">{t(`home.pillar${n}.title`)}</h3>
          <p class="text-sm text-hoba-muted mt-3 leading-relaxed">{t(`home.pillar${n}.text`)}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="my-8 p-8 rounded-md border border-hoba-border bg-hoba-card text-center">
    <h2 class="text-2xl font-semibold text-hoba-text">{t('home.cta2.title')}</h2>
    <p class="text-sm text-hoba-muted mt-2 max-w-xl mx-auto">{t('home.cta2.sub')}</p>
    <div class="mt-6 flex justify-center gap-4 flex-wrap">
      <a href={`${prefix}/analyze`} class="px-6 py-3 rounded-md bg-hoba-accent hover:opacity-90 text-hoba-bg font-semibold text-sm transition-colors">{t('home.cta2.start')}</a>
      <a href={`${prefix}/methodology`} class="px-6 py-3 rounded-md border border-hoba-border bg-hoba-card hover:bg-hoba-hover text-hoba-text text-sm transition-colors">{t('home.cta2.method')}</a>
    </div>
  </section>
</Layout>
