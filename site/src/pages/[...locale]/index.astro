---
import Layout from '../../layouts/Layout.astro';
import { countGraphNodes, getBundle, getGraph, siteVersion } from '../../lib/registry';
import { localeFromParams, localePrefix, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
const totalNodes = countGraphNodes(bundle);
const steps = [
  { k: 'h', letter: 'H' },
  { k: 'o', letter: 'O' },
  { k: 'b', letter: 'B' },
  { k: 'a', letter: 'A' },
] as const;
// The hero's second column: the registry in four numbers, so the headline is
// not left floating against half a screen of nothing.
const stats = [
  { n: totalNodes, label: t('home.stat.entities') },
  { n: bundle.barriers.length, label: t('home.stat.barriers') },
  { n: bundle.mechanisms.length, label: t('home.stat.mechanisms') },
  { n: getGraph(lang).edges.length, label: t('home.stat.edges') },
];
---
<Layout lang={lang} title={t('home.title')} activeNav="home">
  <section class="pb-12 border-b border-hoba-border grid gap-x-12 gap-y-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:items-end">
    <div>
      <p class="meta font-mono">{t('home.badge', { registry: bundle.version, site: siteVersion })} · {t('home.canonical')}</p>
      <h1 class="mt-4 text-3xl font-semibold text-hoba-text text-balance">
        {t('home.h1.before')}<span class="text-hoba-accent">{t('home.h1.accent')}</span>.
      </h1>
      <p class="mt-5 text-lg text-hoba-muted">
        {t('home.lead.before')}<strong class="text-hoba-text font-medium">{t('home.lead.strong')}</strong>
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`${prefix}/analyze`} class="btn btn-primary">{t('home.cta.analyze')} →</a>
        <a href={`${prefix}/registry`} class="btn btn-secondary">{t('home.cta.registry', { n: totalNodes })}</a>
      </div>
    </div>

    <dl class="grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-2 lg:border-l lg:border-hoba-border lg:pl-12">
      {stats.map((s) => (
        <div>
          <dt class="meta">{s.label}</dt>
          <dd class="mt-1 text-2xl font-semibold font-mono text-hoba-text tabular-nums">{s.n}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="py-12 border-b border-hoba-border">
    <p class="kicker">{t('home.protocol.kicker')}</p>
    <h2 class="mt-1 text-2xl font-semibold text-hoba-text">{t('home.protocol.title')}</h2>
    <p class="mt-2 text-base text-hoba-muted max-w-2xl">{t('home.protocol.sub')}</p>
    <ol class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-10 gap-y-10">
      {steps.map((s) => (
        <li>
          <h3 class="flex items-baseline gap-2 text-lg font-semibold text-hoba-text">
            <span class="font-mono text-hoba-accent" aria-hidden="true">{s.letter}</span>
            <span>{t(`home.step.${s.k}.title`)}</span>
          </h3>
          <p class="mt-2 text-base text-hoba-muted">{t(`home.step.${s.k}.text`)}</p>
          <p class="mt-3 text-sm font-mono text-hoba-muted">{t(`home.step.${s.k}.out`)}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="py-12 border-b border-hoba-border">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-10">
      {(['1', '2', '3'] as const).map((n) => (
        <div>
          <p class="kicker">{t(`home.pillar${n}.kicker`)}</p>
          <h3 class="mt-1 text-lg font-semibold text-hoba-text">{t(`home.pillar${n}.title`)}</h3>
          <p class="mt-2 text-base text-hoba-muted">{t(`home.pillar${n}.text`)}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div>
      <h2 class="text-2xl font-semibold text-hoba-text">{t('home.cta2.title')}</h2>
      <p class="mt-2 text-base text-hoba-muted max-w-xl">{t('home.cta2.sub')}</p>
    </div>
    <div class="flex flex-wrap gap-3 md:shrink-0">
      <a href={`${prefix}/analyze`} class="btn btn-primary">{t('home.cta2.start')}</a>
      <a href={`${prefix}/methodology`} class="btn btn-secondary">{t('home.cta2.method')}</a>
    </div>
  </section>
</Layout>
