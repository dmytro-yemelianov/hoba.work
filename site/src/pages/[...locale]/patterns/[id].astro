---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EntityBadge from '../../../components/EntityBadge.astro';
import EntityRow from '../../../components/EntityRow.astro';
import Specimen from '../../../components/Specimen.astro';
import IdealNote from '../../../components/IdealNote.astro';
import EraNote from '../../../components/EraNote.astro';
import Perspectives from '../../../components/Perspectives.astro';
import Reach from '../../../components/Reach.astro';
import ShareBar from '../../../components/ShareBar.astro';
import { getBundle } from '../../../lib/registry';
import { asHeading, LANGS, localeParams, localePrefix, useTranslations, type Lang } from '../../../i18n/utils';
import type { PatternNode } from '@hoba/registry';

export async function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    getBundle(lang).patterns.map((pattern) => ({ params: { ...localeParams(lang), id: pattern.id }, props: { lang, pattern } }))
  );
}

const { lang, pattern } = Astro.props as { lang: Lang; pattern: PatternNode };
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
const requiredArtifacts = bundle.artifacts.filter((a) => pattern.required_artifacts.includes(a.id));
const compatibleMechanisms = bundle.mechanisms.filter((m) => pattern.compatible_mechanisms.includes(m.id));
const relevantInterventions = bundle.interventions.filter((i) => pattern.interventions.includes(i.id));
---
<Layout lang={lang} title={`${pattern.id} — ${pattern.title}`} description={pattern.summary} activeNav="patterns" image={`/cards/${lang}/${pattern.id}.png`}>
  <PageHeader title={pattern.title} lead={pattern.summary}>
      <nav slot="eyebrow" class="text-sm text-hoba-muted flex flex-wrap items-center gap-2" aria-label="Breadcrumb">
        <a href={`${prefix}/patterns`} class="hover:text-hoba-text">{t('entity.plural.pattern')}</a><span>/</span>
        <span class="text-hoba-accent font-mono break-all">{pattern.id}</span>
      </nav>
      <div slot="meta" class="flex flex-wrap items-center gap-1.5">
        <EntityBadge type="pattern" id={pattern.id} lang={lang} />
        <span class="pill pill-muted">{asHeading(t('common.evidence'))}: <span class="text-hoba-text">{t(`level.${pattern.evidence_level}`)}</span></span>
      </div>
    </PageHeader>

  <div>
    <IdealNote id={pattern.id} lang={lang} bundle={bundle} prefix={prefix} />
    <EraNote id={pattern.id} lang={lang} bundle={bundle} prefix={prefix} />

    <div class="callout border-l-hoba-pattern">
      <h2 class="text-base font-semibold text-hoba-text">{asHeading(t('patterns.trigger'))}</h2>
      <p class="mt-1 text-base text-hoba-muted">{pattern.trigger_rule}</p>
    </div>

    {pattern.specimens.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t('specimen.section')}</h2>
        <p class="text-base text-hoba-muted max-w-3xl">{t('specimen.disclaimer')}</p>
        {pattern.specimens.map((specimen) => <Specimen specimen={specimen} lang={lang} />)}
      </section>
    )}

    <section class="section grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-8">
      <div>
        <h2 class="section-title">{asHeading(t('pat.establishes'))}</h2>
        <ul class="list-disc pl-5 space-y-1 text-base text-hoba-muted">{pattern.establishes.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h2 class="section-title">{asHeading(t('pat.notEstablishes'))}</h2>
        <ul class="list-disc pl-5 space-y-1 text-base text-hoba-muted">{pattern.non_inferences.map((item) => <li>{item}</li>)}</ul>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">{t('pat.required')}</h2>
      <ul class="row-list">
        {requiredArtifacts.map((a) => (
          <EntityRow id={a.id} title={a.title} href={`${prefix}/artifacts/${a.id}`} note={a.summary} />
        ))}
      </ul>
    </section>

    <section class="section">
      <h2 class="section-title">{t('pat.mechanisms')}</h2>
      <ul class="row-list">
        {compatibleMechanisms.map((m) => (
          <EntityRow
            id={m.id}
            title={m.title}
            href={`${prefix}/mechanisms/${m.id}`}
            pill={t(`removability.short.${m.facets.removability}`)}
            note={m.summary}
          />
        ))}
      </ul>
    </section>

    {relevantInterventions.length > 0 && (
      <section class="section">
        <h2 class="section-title">{asHeading(t('pat.interventions'))}</h2>
        <ul class="row-list">
          {relevantInterventions.map((i) => (
            <EntityRow id={i.id} title={i.title} href={`${prefix}/interventions/${i.id}`} note={i.summary} />
          ))}
        </ul>
      </section>
    )}

    <Reach id={pattern.id} bundle={bundle} lang={lang} prefix={prefix} />

    <Perspectives perspectives={pattern.perspectives} actors={bundle.actors} lang={lang} prefix={prefix} />

    <ShareBar
      id={pattern.id}
      title={pattern.title}
      lang={lang}
      hasPostcard={true}
      type="pattern"
      markdownUrl={`/patterns/${pattern.id}.md`}
      jsonUrl={`/api/v1/patterns/${pattern.id}.json`}
    />
  </div>
</Layout>
