---
/**
 * The six seats.
 *
 * Every mechanism in the registry is somebody's decision, made from a position
 * with a specific view. This page is the index of those positions, and the
 * entry point to the lens: pick one and the whole atlas reads from there.
 */
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { entriesSeenBy, getBundle } from '../../../lib/registry';
import { localeFromParams, localePrefix, localeStaticPaths, useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
const actors = bundle.actors.map((actor) => ({
  actor,
  views: entriesSeenBy(bundle, actor.id, prefix).length,
}));
---
<Layout lang={lang} title={t('actors.title')} description={t('actors.intro')} activeNav="actors">
  <PageHeader kicker={t('actors.kicker')} title={t('actors.title')} lead={t('actors.intro')} tourPageKey="actors" lang={lang} />

  <ul id="actors-grid" class="row-list scroll-mt-24">
    {actors.map(({ actor, views }) => (
      <li class="py-5">
        <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <a href={`${prefix}/actors/${actor.id}`} class="text-lg font-medium text-hoba-text hover:text-hoba-accent">{actor.title}</a>
          <span class="pill pill-muted font-mono">{actor.id}</span>
          {actor.recommendations.length > 0 && (
            <span class="pill pill-muted">{actor.recommendations.length} · {t('actors.recommendations')}</span>
          )}
          {views > 0 && <span class="pill pill-muted">{views} · {t('actors.views')}</span>}
        </p>
        <p class="mt-1 text-base text-hoba-muted max-w-3xl">{actor.summary}</p>
        <p class="mt-2">
          <a href={`${prefix}/actors/${actor.id}?lens=${actor.id}`} class="text-sm text-hoba-accent hover:underline underline-offset-2">
            {t('actors.readAs')} →
          </a>
        </p>
      </li>
    ))}
  </ul>
</Layout>
