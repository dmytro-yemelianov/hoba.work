---
import Layout from '../../layouts/Layout.astro';
import EntityBadge from '../../components/EntityBadge.astro';
import ViewSwitch from '../../components/ViewSwitch.astro';
import { getBundle } from '../../lib/registry';
import { localeFromParams, localePrefix, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
---
<Layout lang={lang} title={t('patterns.title')} activeNav="patterns">
  <div class="mb-8 border-b border-hoba-border pb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
    <div>
      <span class="text-xs font-medium text-hoba-muted">{t('patterns.kicker')}</span>
      <h1 class="text-2xl font-semibold text-hoba-text mt-1">{t('patterns.heading')}</h1>
      <p class="text-sm text-hoba-muted mt-2">{t('patterns.intro')}</p>
    </div>
    <ViewSwitch lang={lang} />
  </div>

  <div data-view-root>
    <div data-view="table" class="overflow-x-auto rounded-md border border-hoba-border bg-hoba-card">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-hoba-muted border-b border-hoba-border">
            <th scope="col" class="px-3 py-2 font-medium">{t('table.id')}</th>
            <th scope="col" class="px-3 py-2 font-medium">{t('table.title')}</th>
            <th scope="col" class="px-3 py-2 font-medium">{t('table.signals')}</th>
            <th scope="col" class="px-3 py-2 font-medium">{t('table.mechanisms')}</th>
            <th scope="col" class="px-3 py-2 font-medium">{t('table.interventions')}</th>
            <th scope="col" class="px-3 py-2 font-medium">{t('table.evidence')}</th>
          </tr>
        </thead>
        <tbody>
          {bundle.patterns.map((p) => (
            <tr class="border-b border-hoba-border last:border-0 hover:bg-hoba-hover align-top">
              <td class="px-3 py-2 font-mono whitespace-nowrap"><a href={`${prefix}/patterns/${p.id}`} class="text-hoba-accent hover:underline">{p.id}</a></td>
              <td class="px-3 py-2"><a href={`${prefix}/patterns/${p.id}`} class="font-medium text-hoba-text hover:underline">{p.title}</a><div class="text-xs text-hoba-muted line-clamp-2">{p.summary}</div></td>
              <td class="px-3 py-2 font-mono text-xs whitespace-nowrap">{p.required_artifacts.map((a, i) => <><a href={`${prefix}/artifacts/${a}`} class="text-hoba-accent hover:underline">{a}</a>{i < p.required_artifacts.length - 1 ? ', ' : ''}</>)}</td>
              <td class="px-3 py-2 font-mono text-xs">{p.compatible_mechanisms.map((m, i) => <><a href={`${prefix}/mechanisms/${m}`} class="text-hoba-accent hover:underline">{m}</a>{i < p.compatible_mechanisms.length - 1 ? ', ' : ''}</>)}</td>
              <td class="px-3 py-2 font-mono text-xs whitespace-nowrap">{p.interventions.length ? p.interventions.map((i, k) => <><a href={`${prefix}/interventions/${i}`} class="text-hoba-accent hover:underline">{i}</a>{k < p.interventions.length - 1 ? ', ' : ''}</>) : '—'}</td>
              <td class="px-3 py-2 text-xs text-hoba-muted whitespace-nowrap">{t(`level.${p.evidence_level}`)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div data-view="list" class="rounded-md border border-hoba-border bg-hoba-card divide-y divide-hoba-border">
      {bundle.patterns.map((p) => (
        <a href={`${prefix}/patterns/${p.id}`} class="flex items-baseline gap-3 px-3 py-2 hover:bg-hoba-hover text-sm">
          <span class="font-mono text-hoba-accent w-14 shrink-0">{p.id}</span>
          <span class="font-medium text-hoba-text shrink-0">{p.title}</span>
          <span class="text-hoba-muted truncate hidden md:inline">{p.summary}</span>
        </a>
      ))}
    </div>

    <div data-view="cards">
  <div class="space-y-6">
    {bundle.patterns.map((p) => {
      const requiredArts = bundle.artifacts.filter((a) => p.required_artifacts.includes(a.id));
      const targetInterventions = bundle.interventions.filter((i) => p.interventions.includes(i.id));
      return (
        <article class="p-6 rounded-md border border-hoba-border bg-hoba-card/70 hover:border-amber-500/50 transition-colors">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <EntityBadge type="pattern" id={p.id} size="md" lang={lang} />
              <span class="text-xs text-hoba-muted">{t('common.evidence')}: <strong class="text-hoba-text">{t(`level.${p.evidence_level}`)}</strong></span>
            </div>
            <a href={`${prefix}/patterns/${p.id}`} class="text-xs text-hoba-accent hover:underline flex items-center gap-1"><span>{t('patterns.viewFull')}</span><span>&rarr;</span></a>
          </div>

          <h2 class="text-lg font-semibold text-hoba-text"><a href={`${prefix}/patterns/${p.id}`} class="hover:text-amber-700 dark:hover:text-amber-300 transition-colors">{p.title}</a></h2>
          <p class="text-sm text-hoba-muted mt-2 leading-relaxed">{p.summary}</p>

          <div class="mt-4 p-3 rounded-md border border-hoba-border border-l-2 border-l-amber-500 bg-hoba-card text-xs text-hoba-text">
            <strong class="text-amber-700 dark:text-amber-300">{t('patterns.trigger')}</strong> {p.trigger_rule}
          </div>

          <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <div class="p-3 rounded-md bg-hoba-card border border-hoba-border border-l-2 border-l-emerald-500">
              <span class="font-semibold text-emerald-700 dark:text-emerald-300 block mb-1">{t('patterns.establishes')}</span>
              <ul class="space-y-1 text-hoba-text list-disc list-inside">{p.establishes.map((e) => <li>{e}</li>)}</ul>
            </div>
            <div class="p-3 rounded-md bg-hoba-card border border-hoba-border border-l-2 border-l-rose-500">
              <span class="font-semibold text-rose-700 dark:text-rose-300 block mb-1">{t('patterns.notEstablishes')}</span>
              <ul class="space-y-1 text-hoba-text list-disc list-inside">{p.non_inferences.map((ni) => <li>{ni}</li>)}</ul>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-hoba-border/60 flex flex-wrap items-center justify-between gap-2 text-xs text-hoba-muted">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span>{t('patterns.requiredSignals')}</span>
              {requiredArts.map((a) => <a href={`${prefix}/artifacts/${a.id}`} class="px-1.5 py-0.5 rounded bg-hoba-bg border border-hoba-border text-purple-700 dark:text-purple-300 hover:border-purple-500 font-mono">{a.id}</a>)}
            </div>
            <div class="flex items-center gap-1.5 flex-wrap">
              <span>{t('patterns.interventions')}</span>
              {targetInterventions.map((i) => <a href={`${prefix}/interventions/${i.id}`} class="px-1.5 py-0.5 rounded bg-hoba-bg border border-hoba-border text-cyan-700 dark:text-cyan-300 hover:border-cyan-500 font-mono">{i.id}</a>)}
            </div>
          </div>
        </article>
      );
    })}
  </div>
    </div>
  </div>
</Layout>
