---
import Layout from '../../layouts/Layout.astro';
import EntityBadge from '../../components/EntityBadge.astro';
import PageHeader from '../../components/PageHeader.astro';
import ViewSwitch from '../../components/ViewSwitch.astro';
import { getBundle } from '../../lib/registry';
import { localeFromParams, localePrefix, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
const idLinks = (ids: string[], route: string) => ids.map((id) => ({ id, href: `${prefix}/${route}/${id}` }));
---
<Layout lang={lang} title={t('patterns.title')} activeNav="patterns" width="app">
  <PageHeader kicker={t('patterns.kicker')} title={t('patterns.heading')} lead={t('patterns.intro')} wide>
    <ViewSwitch slot="actions" lang={lang} />
  </PageHeader>

  <div data-view-root>
    <div data-view="table" class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">{t('table.id')}</th>
            <th scope="col">{t('table.title')}</th>
            <th scope="col">{t('table.signals')}</th>
            <th scope="col">{t('table.mechanisms')}</th>
            <th scope="col">{t('table.interventions')}</th>
            <th scope="col">{t('table.evidence')}</th>
          </tr>
        </thead>
        <tbody>
          {bundle.patterns.map((p) => (
            <tr class="hover:bg-hoba-hover">
              <td class="font-mono text-sm whitespace-nowrap"><a href={`${prefix}/patterns/${p.id}`} class="text-hoba-accent hover:underline">{p.id}</a></td>
              <td><a href={`${prefix}/patterns/${p.id}`} class="font-medium text-hoba-text hover:underline">{p.title}</a><p class="text-sm text-hoba-muted line-clamp-2">{p.summary}</p></td>
              <td class="font-mono text-sm">{idLinks(p.required_artifacts, 'artifacts').map((l, i) => <><a href={l.href} class="text-hoba-accent hover:underline whitespace-nowrap">{l.id}</a>{i < p.required_artifacts.length - 1 ? ', ' : ''}</>)}</td>
              <td class="font-mono text-sm">{idLinks(p.compatible_mechanisms, 'mechanisms').map((l, i) => <><a href={l.href} class="text-hoba-accent hover:underline whitespace-nowrap">{l.id}</a>{i < p.compatible_mechanisms.length - 1 ? ', ' : ''}</>)}</td>
              <td class="font-mono text-sm">{p.interventions.length ? idLinks(p.interventions, 'interventions').map((l, i) => <><a href={l.href} class="text-hoba-accent hover:underline whitespace-nowrap">{l.id}</a>{i < p.interventions.length - 1 ? ', ' : ''}</>) : '—'}</td>
              <td class="whitespace-nowrap"><span class="pill pill-muted">{t(`level.${p.evidence_level}`)}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div data-view="list" class="row-list border-t border-hoba-border">
      {bundle.patterns.map((p) => (
        <a href={`${prefix}/patterns/${p.id}`} class="row-link text-base">
          <span class="font-mono text-sm text-hoba-accent w-16 shrink-0">{p.id}</span>
          <span class="font-medium text-hoba-text">{p.title}</span>
          <span class="text-sm text-hoba-muted truncate hidden md:inline flex-1 min-w-0">{p.summary}</span>
        </a>
      ))}
    </div>

    <div data-view="cards">
      <div class="row-list border-t border-hoba-border">
        {bundle.patterns.map((p) => (
          <article class="py-10 max-w-3xl">
            <div class="flex flex-wrap items-center gap-2">
              <EntityBadge type="pattern" id={p.id} lang={lang} />
              <span class="pill pill-muted">{t(`level.${p.evidence_level}`)}</span>
            </div>
            <h2 class="mt-3 text-xl font-semibold text-hoba-text"><a href={`${prefix}/patterns/${p.id}`} class="hover:underline">{p.title}</a></h2>
            <p class="mt-2 text-base text-hoba-muted">{p.summary}</p>
            <aside class="callout border-l-amber-500">
              <p class="text-sm font-medium text-hoba-muted">{t('patterns.trigger')}</p>
              <p class="mt-1 text-base text-hoba-text">{p.trigger_rule}</p>
            </aside>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">
              <div class="callout border-l-emerald-500 my-0">
                <p class="text-sm font-medium text-hoba-muted">{t('patterns.establishes')}</p>
                <ul class="mt-1 list-disc pl-5 text-base space-y-1">{p.establishes.map((e) => <li>{e}</li>)}</ul>
              </div>
              <div class="callout border-l-rose-500 my-0">
                <p class="text-sm font-medium text-hoba-muted">{t('patterns.notEstablishes')}</p>
                <ul class="mt-1 list-disc pl-5 text-base space-y-1">{p.non_inferences.map((ni) => <li>{ni}</li>)}</ul>
              </div>
            </div>
            <div class="mt-6 flex flex-wrap items-center gap-2 text-sm text-hoba-muted">
              <span>{t('patterns.requiredSignals')}</span>
              {idLinks(p.required_artifacts, 'artifacts').map((l) => <a href={l.href} class="pill font-mono">{l.id}</a>)}
              <span class="ml-4">{t('patterns.interventions')}</span>
              {p.interventions.length ? idLinks(p.interventions, 'interventions').map((l) => <a href={l.href} class="pill font-mono">{l.id}</a>) : <span>—</span>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>
