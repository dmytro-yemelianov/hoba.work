---
import Layout from '../../layouts/Layout.astro';
import { localeFromParams, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const commands = [
  'git clone https://github.com/dmytro-yemelianov/hoba.work.git',
  'pnpm install',
  'pnpm validate:strict',
  'pnpm test',
  'pnpm build',
];
---
<Layout lang={lang} title={t('contrib.title')} activeNav="contribute">
  <article class="prose-hoba mx-auto">
    <header class="page-header">
      <p class="kicker">{t('contrib.kicker')}</p>
      <h1 class="mt-1 text-2xl font-semibold text-hoba-text">{t('contrib.heading')}</h1>
      <p class="mt-2 lead">{t('contrib.intro')}</p>
    </header>

    <h2>{t('contrib.workflow')}</h2>
    <pre tabindex="0"><code>{commands.join('\n')}</code></pre>

    <h2>{t('contrib.checks.title')}</h2>
    <ul>
      {(['1', '2', '3', '4', '5', '6'] as const).map((n) => <li>{t(`contrib.checks.${n}`)}</li>)}
    </ul>

    <h2>{t('contrib.mirror.title')}</h2>
    <p>{t('contrib.mirror.text')}</p>
  </article>
</Layout>
