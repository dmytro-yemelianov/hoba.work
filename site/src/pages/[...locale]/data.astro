---
import Layout from '../../layouts/Layout.astro';
import { getBundle, STAGES } from '../../lib/registry';
import { localeFromParams, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const bundle = getBundle(lang);

const byRemovability = (r: 'candidate' | 'intermediary' | 'none') => bundle.mechanisms.filter((m) => m.facets.removability === r).length;
const honestBaselineCount = bundle.mechanisms.filter((m) => m.honest_baseline).length;
const pct = (n: number) => Math.round((n / Math.max(1, bundle.mechanisms.length)) * 100);
const stageOf = (barrierId: string) => bundle.barriers.find((b) => b.id === barrierId)?.stage;
const barriersByStage = STAGES.map((st) => ({
  stage: st,
  barriers: bundle.barriers.filter((b) => b.stage === st).length,
  mechanisms: bundle.mechanisms.filter((m) => m.operates_at.some((bid) => stageOf(bid) === st)).length,
  artifacts: bundle.artifacts.filter((a) => a.stages.includes(st)).length,
}));
const bars = [
  { key: 'candidate', label: t('data.rem.candidate'), n: byRemovability('candidate'), text: 'text-emerald-700 dark:text-emerald-300', num: 'text-emerald-700 dark:text-emerald-400', fill: 'bg-emerald-500' },
  { key: 'intermediary', label: t('data.rem.intermediary'), n: byRemovability('intermediary'), text: 'text-amber-700 dark:text-amber-300', num: 'text-amber-700 dark:text-amber-400', fill: 'bg-amber-500' },
  { key: 'none', label: t('data.rem.none'), n: byRemovability('none'), text: 'text-rose-700 dark:text-rose-300', num: 'text-rose-700 dark:text-rose-400', fill: 'bg-rose-500' },
];
---
<Layout lang={lang} title={t('data.title')} activeNav="data">
  <div class="mb-8 border-b border-hoba-border pb-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <span class="text-xs font-medium text-hoba-muted">{t('data.kicker')}</span>
        <h1 class="text-2xl font-semibold text-hoba-text mt-1">{t('data.heading')}</h1>
      </div>
      <a href="/data/latest/nodes.csv" target="_blank" class="text-xs px-3 py-1.5 rounded-md border border-hoba-border bg-hoba-card hover:bg-hoba-hover text-hoba-text font-mono">{t('data.downloadNodes')}</a>
    </div>
    <p class="text-sm text-hoba-muted mt-2">{t('data.intro')}</p>
  </div>

  <div class="p-4 rounded-md border border-hoba-border border-l-2 border-l-amber-500 bg-hoba-card text-xs text-hoba-text mb-8 space-y-1">
    <div class="font-semibold flex items-center gap-1.5">
      <svg class="w-4 h-4 text-amber-700 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      <span>{t('data.guard.title')}</span>
    </div>
    <p class="text-amber-700 dark:text-amber-300/80 leading-relaxed">{t('data.guard.text')}</p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
    <div class="p-4 rounded-md border border-hoba-border bg-hoba-card">
      <span class="text-xs text-hoba-muted">{t('data.metric.barriers')}</span>
      <div class="text-2xl font-semibold text-emerald-700 dark:text-emerald-400 mt-1">{bundle.barriers.length}</div>
      <span class="text-xs text-hoba-muted">{t('data.metric.barriersSub')}</span>
    </div>
    <div class="p-4 rounded-md border border-hoba-border bg-hoba-card">
      <span class="text-xs text-hoba-muted">{t('data.metric.mechanisms')}</span>
      <div class="text-2xl font-semibold text-blue-700 dark:text-blue-400 mt-1">{bundle.mechanisms.length}</div>
      <span class="text-xs text-hoba-muted">{t('data.metric.honest', { n: honestBaselineCount })}</span>
    </div>
    <div class="p-4 rounded-md border border-hoba-border bg-hoba-card">
      <span class="text-xs text-hoba-muted">{t('data.metric.patterns')}</span>
      <div class="text-2xl font-semibold text-amber-700 dark:text-amber-400 mt-1">{bundle.patterns.length}</div>
      <span class="text-xs text-hoba-muted">{t('data.metric.patternsSub')}</span>
    </div>
    <div class="p-4 rounded-md border border-hoba-border bg-hoba-card">
      <span class="text-xs text-hoba-muted">{t('data.metric.loops')}</span>
      <div class="text-2xl font-semibold text-pink-700 dark:text-pink-400 mt-1">{bundle.loops.length}</div>
      <span class="text-xs text-hoba-muted">{t('data.metric.loopsSub')}</span>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
    <div class="p-6 rounded-md border border-hoba-border bg-hoba-card">
      <h2 class="text-sm font-semibold text-hoba-text mb-4">{t('data.removability.title')}</h2>
      <div class="space-y-4 text-xs">
        {bars.map((b) => (
          <div>
            <div class="flex justify-between mb-1">
              <span class={`${b.text} font-semibold`}>{b.label}</span>
              <span class={`${b.num} font-semibold`}>{b.n} ({pct(b.n)}%)</span>
            </div>
            <div class="w-full h-2 rounded-full bg-hoba-bg overflow-hidden" role="img" aria-label={`${b.label} ${pct(b.n)}%`}>
              <div class={`h-full ${b.fill} rounded-full`} style={`width: ${pct(b.n)}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="p-6 rounded-md border border-hoba-border bg-hoba-card">
      <h2 class="text-sm font-semibold text-hoba-text mb-4">{t('data.byStage.title')}</h2>
      <div class="space-y-2 text-xs">
        {barriersByStage.map((st) => (
          <div class="flex items-center justify-between p-2 rounded bg-hoba-bg border border-hoba-border">
            <span class="text-hoba-text">{t(`stage.${st.stage}`)}</span>
            <div class="flex gap-3 text-hoba-muted text-xs">
              <span>{t('data.byStage.barriers')} <strong class="text-emerald-700 dark:text-emerald-400">{st.barriers}</strong></span>
              <span>{t('data.byStage.mechanisms')} <strong class="text-blue-700 dark:text-blue-400">{st.mechanisms}</strong></span>
              <span>{t('data.byStage.signals')} <strong class="text-purple-700 dark:text-purple-400">{st.artifacts}</strong></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
