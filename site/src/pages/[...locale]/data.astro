---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { coverage, getBundle, STAGES } from '../../lib/registry';
import { localeFromParams, localePrefix, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const bundle = getBundle(lang);
const gaps = coverage(bundle);
const prefix = localePrefix(lang);

// Where an id can be clicked, it is; the point of publishing a gap is that a
// reader can go and look at what is missing a change.
const ROUTES: Record<string, string> = { B: 'barriers', M: 'mechanisms', A: 'artifacts', P: 'patterns', L: 'loops', I: 'interventions' };
const href = (id: string) => `${prefix}/${ROUTES[id[0]!]}/${id}`;

const gapRows = [
  { title: t('gap.gates'), text: t('gap.gatesText', { n: gaps.gatesWithoutIntervention.length, total: gaps.totals.gates }), ids: gaps.gatesWithoutIntervention },
  { title: t('gap.mechanisms'), text: t('gap.mechanismsText', { n: gaps.mechanismsWithoutIntervention.length, total: gaps.totals.mechanisms }), ids: gaps.mechanismsWithoutIntervention },
  { title: t('gap.evidence'), text: t('gap.evidenceText', { n: gaps.entriesWithoutEvidence.length, total: gaps.totals.entries }), ids: gaps.entriesWithoutEvidence },
];

const byRemovability = (r: 'candidate' | 'intermediary' | 'none') => bundle.mechanisms.filter((m) => m.facets.removability === r).length;
const honestBaselineCount = bundle.mechanisms.filter((m) => m.honest_baseline).length;
const pct = (n: number) => Math.round((n / Math.max(1, bundle.mechanisms.length)) * 100);
const stageOf = (barrierId: string) => bundle.barriers.find((b) => b.id === barrierId)?.stage;
const byStage = STAGES.map((st) => ({
  stage: st,
  barriers: bundle.barriers.filter((b) => b.stage === st).length,
  mechanisms: bundle.mechanisms.filter((m) => m.operates_at.some((bid) => stageOf(bid) === st)).length,
  artifacts: bundle.artifacts.filter((a) => a.stages.includes(st)).length,
}));
const stats = [
  { n: bundle.barriers.length, label: t('data.metric.barriers'), sub: t('data.metric.barriersSub') },
  { n: bundle.mechanisms.length, label: t('data.metric.mechanisms'), sub: t('data.metric.honest', { n: honestBaselineCount }) },
  { n: bundle.patterns.length, label: t('data.metric.patterns'), sub: t('data.metric.patternsSub') },
  { n: bundle.loops.length, label: t('data.metric.loops'), sub: t('data.metric.loopsSub') },
];
const bars = [
  { label: t('data.rem.candidate'), n: byRemovability('candidate'), dot: 'bg-emerald-500' },
  { label: t('data.rem.intermediary'), n: byRemovability('intermediary'), dot: 'bg-amber-500' },
  { label: t('data.rem.none'), n: byRemovability('none'), dot: 'bg-rose-500' },
];
---
<Layout lang={lang} title={t('data.title')} activeNav="data">
  <PageHeader kicker={t('data.kicker')} title={t('data.heading')} lead={t('data.intro')} wide>
    <a slot="actions" href="/data/latest/nodes.csv" target="_blank" class="btn btn-secondary font-mono">{t('data.downloadNodes')}</a>
  </PageHeader>

  <aside class="callout border-l-amber-500">
    <p class="text-base font-medium text-hoba-text">{t('data.guard.title')}</p>
    <p class="mt-1 text-base text-hoba-muted">{t('data.guard.text')}</p>
  </aside>

  <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-8 gap-y-6 py-8 border-y border-hoba-border">
    {stats.map((s) => (
      <div>
        <dt class="meta">{s.label}</dt>
        <dd class="mt-1 text-2xl font-semibold font-mono text-hoba-text">{s.n}</dd>
        <dd class="text-sm text-hoba-muted">{s.sub}</dd>
      </div>
    ))}
  </dl>

  <section class="section">
    <h2 class="section-title">{t('data.removability.title')}</h2>
    <ul class="grid grid-cols-1 sm:grid-cols-3 gap-x-10 gap-y-5">
      {bars.map((b) => (
        <li>
          <div class="flex items-baseline justify-between gap-3 text-base">
            <span class="flex items-center gap-2"><span class={`dot ${b.dot}`}></span>{b.label}</span>
            <span class="font-mono text-sm text-hoba-muted tabular-nums">{b.n} · {pct(b.n)}%</span>
          </div>
          <div class="mt-2 h-1.5 rounded-full bg-hoba-hover overflow-hidden" role="img" aria-label={`${b.label} ${pct(b.n)}%`}>
            <div class={`h-full rounded-full ${b.dot}`} style={`width: ${pct(b.n)}%`}></div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2 class="section-title">{t('data.byStage.title')}</h2>
    <div class="overflow-x-auto" tabindex="0">
      <table class="table">
        <thead><tr><th scope="col">{t('common.stage')}</th><th scope="col" class="text-right">{t('data.byStage.barriers')}</th><th scope="col" class="text-right">{t('data.byStage.mechanisms')}</th><th scope="col" class="text-right">{t('data.byStage.signals')}</th></tr></thead>
        <tbody>
          {byStage.map((st) => (
            <tr>
              <td>{t(`stage.${st.stage}`)}</td>
              <td class="text-right font-mono text-sm">{st.barriers}</td>
              <td class="text-right font-mono text-sm">{st.mechanisms}</td>
              <td class="text-right font-mono text-sm">{st.artifacts}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">{t('gap.title')}</h2>
    <p class="text-base text-hoba-muted max-w-3xl">{t('gap.intro')}</p>

    <ul class="row-list mt-5">
      {gapRows.map((row) => (
        <li class="py-4">
          <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="text-base font-medium text-hoba-text">{row.title}</span>
            <span class="pill pill-muted ml-auto font-mono tabular-nums">{row.ids.length}</span>
          </p>
          <p class="mt-1 text-base text-hoba-muted max-w-2xl">{row.text}</p>
          {row.ids.length > 0 ? (
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {row.ids.map((id) => <li><a href={href(id)} class="pill pill-muted font-mono">{id}</a></li>)}
            </ul>
          ) : (
            <p class="mt-2 text-sm text-hoba-muted">{t('gap.none')}</p>
          )}
        </li>
      ))}

      <li class="py-4">
        <p class="text-base font-medium text-hoba-text">{t('gap.stages')}</p>
        <p class="mt-1 text-base text-hoba-muted max-w-2xl">{t('gap.stagesText')}</p>
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {gaps.stagesWithoutObservation.map((stage) => <li><span class="pill pill-muted">{t(`stage.${stage}`)}</span></li>)}
        </ul>
      </li>
    </ul>

    <p class="mt-6 text-base text-hoba-muted max-w-3xl">{t('gap.limits')}</p>
  </section>
</Layout>
