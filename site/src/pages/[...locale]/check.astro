---
/**
 * The conformance check.
 *
 * A deliberately small tool: it reports the gates where the answer is
 * arithmetic and says "cannot be determined" everywhere else. It does not
 * rewrite anything, it does not score anyone, and it will not produce a
 * probability — see ROADMAP.md, where that refusal is recorded as permanent.
 *
 * Everything runs in the page. The employer side is whatever the reader types,
 * and nothing is stored or sent, which is what lets the page ask for a salary
 * expectation at all.
 */
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getBundle } from '../../lib/registry';
import { clientDictionary, localeFromParams, localePrefix, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);

const REASON_CODES = [
  'years.impossible', 'years.possible', 'years.unknown', 'years.short', 'years.met',
  'authorisation.unknown', 'authorisation.present', 'authorisation.absent',
  'location.unknown', 'location.inside', 'location.outside',
  'skills.missing', 'skills.present',
  'band.above', 'band.under', 'band.inside', 'band.unpublished',
] as const;

const KEYS = [
  'check.result', 'check.empty', 'check.stops', 'check.noStop', 'check.undetermined',
  'check.v.passes', 'check.v.fails', 'check.v.undetermined', 'check.v.unsatisfiable',
  'check.preset.label', 'check.preset.perfect', 'check.preset.impossible', 'check.preset.salary',
  'check.preset.auth', 'check.preset.missingSkills',
  'check.turnaround.title', 'check.turnaround.desc', 'check.turnaround.wf', 'check.turnaround.state',
  'check.turnaround.days', 'check.turnaround.nominal', 'check.turnaround.breach', 'check.turnaround.stalled',
  'check.turnaround.normal', 'check.runway.title', 'check.runway.desc', 'check.runway.savings',
  'check.runway.burn', 'check.runway.horizon', 'check.runway.risk.high', 'check.runway.risk.medium',
  'check.runway.risk.safe', 'check.runway.infinite',
  ...REASON_CODES.map((c) => `check.r.${c}` as const),
] as const;

// State titles and mechanism titles are resolved here so the client ships names
// rather than a second copy of the registry.
const ideal = bundle.workflows.find((w) => w.id === 'WF-003');
const payload = JSON.stringify({
  prefix,
  lang,
  ...clientDictionary(lang, KEYS),
  states: Object.fromEntries((ideal?.states ?? []).map((s) => [s.id, s.title])),
  gates: Object.fromEntries(bundle.barriers.map((b) => [b.id, b.title])),
  mechanisms: Object.fromEntries(bundle.mechanisms.map((m) => [m.id, m.title])),
  workflows: bundle.workflows.map((w) => ({
    id: w.id,
    title: w.title,
    states: w.states.map((s) => ({ id: s.id, title: s.title })),
    transitions: w.transitions.map((tr) => ({
      from: tr.from,
      to: tr.to,
      expected: tr.latency_expected_days ?? 3,
      max: tr.latency_max_days ?? 14,
    })),
  })),
}).replace(/</g, '\\u003c');

const you = [
  { id: 'years', label: t('check.years'), placeholder: t('check.placeholders.years'), type: 'number' },
  { id: 'skills', label: t('check.skills'), placeholder: t('check.placeholders.skills'), type: 'text' },
  { id: 'authorised', label: t('check.authorised'), placeholder: t('check.placeholders.authorised'), type: 'text' },
  { id: 'located', label: t('check.located'), placeholder: t('check.placeholders.located'), type: 'text' },
  { id: 'expectation', label: t('check.expectation'), placeholder: t('check.placeholders.expectation'), type: 'number' },
] as const;

const posting = [
  { id: 'requiredYears', label: t('check.requiredYears'), placeholder: t('check.placeholders.requiredYears'), type: 'number' },
  { id: 'requiredSkills', label: t('check.requiredSkills'), placeholder: t('check.placeholders.requiredSkills'), type: 'text' },
  { id: 'requiresAuth', label: t('check.requiresAuth'), placeholder: t('check.placeholders.requiresAuth'), type: 'text' },
  { id: 'hiringLocations', label: t('check.hiringLocations'), placeholder: t('check.placeholders.hiringLocations'), type: 'text' },
  { id: 'bandMin', label: t('check.bandMin'), placeholder: t('check.placeholders.bandMin'), type: 'number' },
  { id: 'bandMax', label: t('check.bandMax'), placeholder: t('check.placeholders.bandMax'), type: 'number' },
  { id: 'technologyAge', label: t('check.technologyAge'), placeholder: t('check.placeholders.technologyAge'), type: 'number', hint: t('check.technologyHint') },
] as const;

const presets = [
  {
    id: 'perfect',
    label: t('check.preset.perfect'),
    icon: '🟢',
    data: {
      years: '7',
      skills: 'TypeScript, React, Node.js, PostgreSQL, Docker',
      authorised: 'US, EU, UK',
      located: lang === 'uk' ? 'Київ, Україна' : 'London, UK',
      expectation: '120000',
      requiredYears: '5',
      requiredSkills: 'TypeScript, React, PostgreSQL',
      requiresAuth: lang === 'uk' ? 'EU' : 'UK',
      hiringLocations: lang === 'uk' ? 'Remote, EU' : 'Remote, UK',
      bandMin: '100000',
      bandMax: '140000',
      technologyAge: '12',
    },
  },
  {
    id: 'impossible',
    label: t('check.preset.impossible'),
    icon: '🔴',
    data: {
      years: '4',
      skills: 'Next.js 15, Bun, Tailwind CSS',
      authorised: 'US, EU',
      located: 'Remote',
      expectation: '95000',
      requiredYears: '8',
      requiredSkills: 'Next.js 15, Bun',
      requiresAuth: '',
      hiringLocations: 'Remote',
      bandMin: '80000',
      bandMax: '110000',
      technologyAge: '3',
    },
  },
  {
    id: 'salary',
    label: t('check.preset.salary'),
    icon: '🟡',
    data: {
      years: '8',
      skills: 'Go, Kubernetes, Distributed Systems',
      authorised: 'US, EU',
      located: 'Berlin',
      expectation: '150000',
      requiredYears: '6',
      requiredSkills: 'Go, Kubernetes',
      requiresAuth: 'EU',
      hiringLocations: 'EU, Remote',
      bandMin: '110000',
      bandMax: '130000',
      technologyAge: '10',
    },
  },
  {
    id: 'auth',
    label: t('check.preset.auth'),
    icon: '🚫',
    data: {
      years: '5',
      skills: 'Python, AWS, FastAPI',
      authorised: 'UA, EU',
      located: lang === 'uk' ? 'Київ, Україна' : 'Kyiv, Ukraine',
      expectation: '80000',
      requiredYears: '4',
      requiredSkills: 'Python, AWS',
      requiresAuth: 'US',
      hiringLocations: 'US (On-site NYC)',
      bandMin: '90000',
      bandMax: '120000',
      technologyAge: '6',
    },
  },
  {
    id: 'missingSkills',
    label: t('check.preset.missingSkills'),
    icon: '📋',
    data: {
      years: '6',
      skills: 'Python, Django, PostgreSQL',
      authorised: 'US, EU',
      located: 'Remote',
      expectation: '100000',
      requiredYears: '5',
      requiredSkills: 'Python, Django, GraphQL, Kubernetes, Apache Kafka',
      requiresAuth: '',
      hiringLocations: 'Remote',
      bandMin: '95000',
      bandMax: '125000',
      technologyAge: '10',
    },
  },
];
---
<Layout lang={lang} title={t('check.title')} description={t('check.intro')} activeNav="check">
  <PageHeader kicker={t('check.kicker')} title={t('check.title')} lead={t('check.intro')} tourPageKey="check" lang={lang}>
    <p slot="actions" class="flex items-center gap-2 text-sm text-hoba-muted">
      <span class="dot bg-hoba-candidate" aria-hidden="true"></span>{t('check.privacy')}
    </p>
  </PageHeader>

  <details class="disclosure mb-6" open>
    <summary>
      <span class="flex items-center gap-2">
        <span class="text-xs font-mono text-hoba-accent font-semibold">ℹ️ {lang === 'uk' ? 'Як працює ця перевірка' : 'How this check works'}</span>
        <span class="text-xs text-hoba-muted">({lang === 'uk' ? '100% клієнтський розрахунок, без оцінок та скорингу' : 'Client-side only, no score or probabilities'})</span>
      </span>
      <svg class="disclosure-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
    </summary>
    <div class="disclosure-body space-y-2">
      <p>{t('check.notAboutYou')}</p>
      <p>{t('check.noCompany')}</p>
    </div>
  </details>

  <!-- Interactive Preset Templates Bar -->
  <div class="my-8 p-5 rounded-2xl border border-hoba-border bg-hoba-card/80">
    <div class="flex items-center justify-between gap-3 mb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-hoba-muted font-mono">
        {t('check.preset.label')}
      </span>
      <button type="button" id="btn-clear-check" class="text-xs text-hoba-muted hover:text-hoba-accent underline underline-offset-2 transition-colors">
        {lang === 'uk' ? 'Очистити форму' : 'Clear Form'}
      </button>
    </div>
    <div class="flex flex-wrap gap-2">
      {presets.map((preset) => (
        <button
          type="button"
          class="btn-preset pill pill-muted hover:border-hoba-accent hover:text-hoba-text text-xs py-1.5 px-3 flex items-center gap-1.5 transition-all"
          data-preset={JSON.stringify(preset.data)}
        >
          <span>{preset.icon}</span>
          <span class="font-medium">{preset.label}</span>
        </button>
      ))}
    </div>
  </div>

  <form id="check-form" class="section grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2 scroll-mt-24" autocomplete="off">
    <!-- Column 1: Candidate Side -->
    <fieldset id="evidenced-facts-col" class="rounded-xl border border-hoba-border bg-hoba-card p-5 scroll-mt-24">
      <legend class="text-base font-semibold text-hoba-text px-2">{t('check.you')}</legend>
      <div class="space-y-4 mt-2">
        {you.map((field) => (
          <div>
            <label for={field.id} class="block text-xs font-medium text-hoba-muted mb-1">{field.label}</label>
            <input
              id={field.id}
              name={field.id}
              type={field.type}
              inputmode={field.type === 'number' ? 'numeric' : undefined}
              placeholder={field.placeholder}
              class="check-input w-full"
            />
          </div>
        ))}
      </div>
    </fieldset>

    <!-- Column 2: Employer Posting Side -->
    <fieldset id="stated-specs-col" class="rounded-xl border border-hoba-border bg-hoba-card p-5 scroll-mt-24">
      <legend class="text-base font-semibold text-hoba-text px-2">{t('check.posting')}</legend>
      <div class="space-y-4 mt-2">
        {posting.map((field) => (
          <div>
            <label for={field.id} class="block text-xs font-medium text-hoba-muted mb-1">{field.label}</label>
            <input
              id={field.id}
              name={field.id}
              type={field.type}
              inputmode={field.type === 'number' ? 'numeric' : undefined}
              placeholder={field.placeholder}
              class="check-input w-full"
            />
            {'hint' in field && field.hint && <span class="mt-1 block text-xs text-hoba-muted">{field.hint}</span>}
          </div>
        ))}
      </div>
    </fieldset>
  </form>

  <!-- Section 1: Arithmetic Conformance Results -->
  <section id="arithmetic-verdict" class="section scroll-mt-24">
    <div class="border-b border-hoba-border pb-3 mb-6">
      <h2 class="text-xl font-semibold text-hoba-text">{t('check.result')}</h2>
    </div>
    <div id="check-verdict" aria-live="polite"></div>
    <ul id="check-gates" class="row-list divide-y divide-hoba-border mt-4"></ul>
  </section>

  <!-- Section 2: Temporal Latency & Dwell Anomaly Diagnoser -->
  <section id="turnaround-section" class="section border-t border-hoba-border pt-12 scroll-mt-24">
    <div class="max-w-3xl mb-6">
      <h2 class="text-xl font-semibold text-hoba-text">{t('check.turnaround.title')}</h2>
      <p class="text-sm text-hoba-muted mt-1 leading-relaxed">
        {t('check.turnaround.desc')}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 rounded-xl border border-hoba-border bg-hoba-card p-5">
      <div>
        <label for="latency-wf" class="block text-xs font-medium text-hoba-muted mb-1">{t('check.turnaround.wf')}</label>
        <select id="latency-wf" class="check-input w-full bg-hoba-bg text-sm">
          {bundle.workflows.map((w) => (
            <option value={w.id}>{w.id} — {w.title}</option>
          ))}
        </select>
      </div>
      <div>
        <label for="latency-state" class="block text-xs font-medium text-hoba-muted mb-1">{t('check.turnaround.state')}</label>
        <select id="latency-state" class="check-input w-full bg-hoba-bg text-sm"></select>
      </div>
      <div>
        <label for="latency-days" class="block text-xs font-medium text-hoba-muted mb-1">{t('check.turnaround.days')}</label>
        <input id="latency-days" type="number" min="0" value="7" class="check-input w-full text-sm" />
      </div>
    </div>

    <div id="latency-result" class="mt-6" aria-live="polite"></div>
  </section>

  <!-- Section 3: Candidate Runway & Solvency Calculator -->
  <section id="runway-section" class="section border-t border-hoba-border pt-12 scroll-mt-24">
    <div class="max-w-3xl mb-6">
      <h2 class="text-xl font-semibold text-hoba-text">{t('check.runway.title')}</h2>
      <p class="text-sm text-hoba-muted mt-1 leading-relaxed">
        {t('check.runway.desc')}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 rounded-xl border border-hoba-border bg-hoba-card p-5">
      <div>
        <label for="runway-savings" class="block text-xs font-medium text-hoba-muted mb-1">{t('check.runway.savings')}</label>
        <input id="runway-savings" type="number" min="0" value="24000" class="check-input w-full text-sm" />
      </div>
      <div>
        <label for="runway-burn" class="block text-xs font-medium text-hoba-muted mb-1">{t('check.runway.burn')}</label>
        <input id="runway-burn" type="number" min="1" value="3500" class="check-input w-full text-sm" />
      </div>
    </div>

    <div id="runway-result" class="mt-6" aria-live="polite"></div>
  </section>

  <script type="application/json" id="check-data" set:html={payload} />
  <script>
    import { checkConformance, type CandidateProfile, type PostingFacets } from '@hoba/registry/core';

    const raw = document.getElementById('check-data')?.textContent;
    const form = document.getElementById('check-form') as HTMLFormElement | null;
    if (raw && form) {
      const data = JSON.parse(raw) as Record<string, any>;
      const lang = data.lang ?? 'en';
      const t = (key: string, vars: Record<string, string | number> = {}) =>
        String(data[key] ?? key).replace(/\{(\w+)\}/g, (_, name: string) => (name in vars ? String(vars[name]) : `{${name}}`));
      const esc = (value: string) =>
        value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

      const value = (id: string) => (form.elements.namedItem(id) as HTMLInputElement | null)?.value.trim() ?? '';
      const number = (id: string) => {
        const v = value(id);
        if (v === '') return undefined;
        const n = Number(v);
        return Number.isFinite(n) ? n : undefined;
      };
      const list = (id: string) =>
        value(id)
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean);

      const TONE: Record<string, string> = {
        passes: 'border-l-hoba-barrier bg-hoba-barrier/5',
        fails: 'border-l-hoba-exogenous bg-hoba-exogenous/5',
        undetermined: 'border-l-hoba-intermediary bg-hoba-intermediary/5',
        unsatisfiable: 'border-l-hoba-loop bg-hoba-loop/5',
      };

      function render() {
        const profile: CandidateProfile = {
          years: number('years'),
          skills: list('skills'),
          authorised_for: list('authorised'),
          located_in: value('located') || undefined,
          expectation: number('expectation'),
        };
        const facets: PostingFacets = {
          required_years: number('requiredYears'),
          required_skills: list('requiredSkills'),
          requires_authorisation_in: value('requiresAuth') || undefined,
          hiring_locations: list('hiringLocations'),
          band_min: number('bandMin'),
          band_max: number('bandMax'),
          technology_age: number('technologyAge'),
        };

        const report = checkConformance(profile, facets);
        const verdict = document.getElementById('check-verdict')!;
        const gates = document.getElementById('check-gates')!;

        if (report.gates.length === 0) {
          verdict.innerHTML = `<p class="text-sm sm:text-base text-hoba-muted">${esc(t('check.empty'))}</p>`;
          gates.innerHTML = '';
          return;
        }

        const lines: string[] = [];
        if (report.stops_at) {
          lines.push(
            `<p class="callout rounded-xl border-l-hoba-exogenous bg-hoba-exogenous/5 text-sm sm:text-base text-hoba-text">${esc(
              t('check.stops', {
                gate: `${report.stops_at.gate} — ${data.gates[report.stops_at.gate] ?? report.stops_at.gate}`,
                state: data.states[report.stops_at.state] ?? report.stops_at.state,
              })
            )}</p>`
          );
        } else {
          lines.push(`<p class="text-sm sm:text-base text-hoba-muted max-w-3xl">${esc(t('check.noStop'))}</p>`);
        }
        if (report.undetermined > 0) {
          lines.push(`<p class="mt-2 text-xs sm:text-sm text-hoba-muted">${esc(t('check.undetermined', { n: report.undetermined }))}</p>`);
        }
        verdict.innerHTML = lines.join('');

        gates.innerHTML = report.gates
          .map((gate) => `
            <li class="py-3.5">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <a href="${data.prefix}/barriers/${gate.gate}" class="font-mono text-xs font-semibold text-hoba-accent">${esc(gate.gate)}</a>
                <span class="text-sm font-medium text-hoba-text">${esc(data.gates[gate.gate] ?? gate.gate)}</span>
                <span class="pill pill-muted ml-auto text-xs">${esc(t(`check.v.${gate.verdict}`))}</span>
              </div>
              <p class="callout ${TONE[gate.verdict]} rounded-lg my-2 text-xs sm:text-sm text-hoba-text">${esc(
                t(`check.r.${gate.reason.code}`, gate.reason.params)
              )}</p>
              <ul class="flex flex-wrap gap-1.5 mt-2">
                ${gate.mechanisms
                  .map(
                    (m) =>
                      `<li><a href="${data.prefix}/mechanisms/${m}" class="pill pill-muted font-mono text-xs hover:border-hoba-accent transition-colors" title="${esc(
                        data.mechanisms[m] ?? m
                      )}">${esc(m)}</a></li>`
                  )
                  .join('')}
              </ul>
            </li>`)
          .join('');
      }

      form.addEventListener('input', render);

      // Preset click handlers
      document.querySelectorAll<HTMLButtonElement>('.btn-preset').forEach((btn) => {
        btn.addEventListener('click', () => {
          const rawPreset = btn.dataset.preset;
          if (!rawPreset) return;
          const values = JSON.parse(rawPreset) as Record<string, string>;
          for (const [key, val] of Object.entries(values)) {
            const input = form.elements.namedItem(key) as HTMLInputElement | null;
            if (input) input.value = val;
          }
          render();
        });
      });

      document.getElementById('btn-clear-check')?.addEventListener('click', () => {
        form.reset();
        document.querySelectorAll<HTMLInputElement>('#check-form input').forEach((inp) => (inp.value = ''));
        render();
      });

      render();

      // Temporal Latency Calculator
      const wfSelect = document.getElementById('latency-wf') as HTMLSelectElement | null;
      const stateSelect = document.getElementById('latency-state') as HTMLSelectElement | null;
      const daysInput = document.getElementById('latency-days') as HTMLInputElement | null;
      const latencyResult = document.getElementById('latency-result');

      function updateStates() {
        if (!wfSelect || !stateSelect) return;
        const currentWf = data.workflows.find((w: any) => w.id === wfSelect.value);
        if (!currentWf) return;
        stateSelect.innerHTML = currentWf.states
          .map((s: any) => `<option value="${s.id}">${s.id} — ${s.title}</option>`)
          .join('');
        renderLatency();
      }

      function renderLatency() {
        if (!wfSelect || !stateSelect || !daysInput || !latencyResult) return;
        const currentWf = data.workflows.find((w: any) => w.id === wfSelect.value);
        if (!currentWf) return;
        const stateId = stateSelect.value;
        const days = Number(daysInput.value) || 0;

        const transitions = currentWf.transitions.filter((tr: any) => tr.from === stateId);
        if (transitions.length === 0) {
          const terminalMsg = lang === 'uk'
            ? `Кінцевий стан або відсутні вихідні переходи з ${esc(stateId)}.`
            : `Terminal state or no outgoing transitions from ${esc(stateId)}.`;
          latencyResult.innerHTML = `<p class="text-xs sm:text-sm text-hoba-muted">${terminalMsg}</p>`;
          return;
        }

        const cards = transitions.map((tr: any) => {
          let badge = `<span class="pill pill-muted font-mono text-xs"><span class="dot bg-emerald-500" aria-hidden="true"></span>${esc(t('check.turnaround.nominal'))}</span>`;
          let calloutTone = 'border-l-emerald-500 bg-emerald-500/5';
          let note = t('check.turnaround.normal', { expected: tr.expected });
          let implicated: string[] = [];

          if (days > tr.max) {
            badge = `<span class="pill pill-muted font-mono text-xs font-semibold text-rose-400"><span class="dot bg-rose-500" aria-hidden="true"></span>${esc(t('check.turnaround.breach'))}</span>`;
            calloutTone = 'border-l-rose-500 bg-rose-500/5';
            note = t('check.turnaround.stalled', { max: tr.max });
            if (tr.from.includes('queue') || tr.from.includes('publish') || tr.from.includes('received')) {
              implicated = ['M-006', 'M-020', 'M-025'];
            } else if (tr.from.includes('screen') || tr.from.includes('technical') || tr.from.includes('panel')) {
              implicated = ['M-009', 'M-019', 'M-022'];
            } else if (tr.from.includes('offer') || tr.from.includes('verification')) {
              implicated = ['M-007', 'M-027'];
            }
          } else if (days > tr.expected) {
            const delayLabel = lang === 'uk' ? 'Перевищення очікуваного часу' : 'Delayed Beyond Expected';
            const delayMsg = lang === 'uk'
              ? `Час очікування перевищує середній (${tr.expected} дн.), наближаючись до максимального порогу (${tr.max} дн.).`
              : `Turnaround exceeds expected average (${tr.expected}d), approaching max bound (${tr.max}d).`;
            badge = `<span class="pill pill-muted font-mono text-xs text-amber-400"><span class="dot bg-amber-500" aria-hidden="true"></span>${delayLabel}</span>`;
            calloutTone = 'border-l-amber-500 bg-amber-500/5';
            note = delayMsg;
          }

          const statsLine = lang === 'uk'
            ? `Очікувано: ${tr.expected} дн. · Макс. поріг: ${tr.max} дн. · Минуло: ${days} дн.`
            : `Expected: ${tr.expected} days · Max bound: ${tr.max} days · Elapsed: ${days} days`;
          const implicatedLabel = lang === 'uk' ? 'Причетні механізми:' : 'Implicated Mechanisms:';

          return `
            <div class="callout ${calloutTone} rounded-xl my-3 p-4">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="font-mono text-xs sm:text-sm font-semibold text-hoba-text">${esc(tr.from)} → ${esc(tr.to)}</span>
                ${badge}
              </div>
              <p class="text-xs text-hoba-muted mt-1 font-mono">${statsLine}</p>
              <p class="text-xs sm:text-sm text-hoba-text mt-2 leading-relaxed">${esc(note)}</p>
              ${implicated.length > 0 ? `
                <div class="mt-3 pt-2 border-t border-hoba-border/40">
                  <span class="text-[11px] text-hoba-muted uppercase tracking-wider font-semibold">${implicatedLabel}</span>
                  <div class="flex flex-wrap gap-1.5 mt-1">
                    ${implicated.map((m) => `<a href="${data.prefix}/mechanisms/${m}" class="pill pill-muted font-mono text-xs hover:border-hoba-accent transition-colors">${esc(m)}</a>`).join('')}
                  </div>
                </div>
              ` : ''}
            </div>
          `;
        });

        latencyResult.innerHTML = cards.join('');
      }

      wfSelect?.addEventListener('change', updateStates);
      stateSelect?.addEventListener('change', renderLatency);
      daysInput?.addEventListener('input', renderLatency);
      updateStates();

      // Runway Calculator
      const savingsInput = document.getElementById('runway-savings') as HTMLInputElement | null;
      const burnInput = document.getElementById('runway-burn') as HTMLInputElement | null;
      const runwayResult = document.getElementById('runway-result');

      function renderRunway() {
        if (!savingsInput || !burnInput || !runwayResult) return;
        const savings = Number(savingsInput.value) || 0;
        const burn = Number(burnInput.value) || 1;
        const months = savings / burn;

        let statusBadge = `<span class="pill pill-muted font-mono text-xs"><span class="dot bg-emerald-500" aria-hidden="true"></span>${lang === 'uk' ? 'Стабільний запас (6+ міс.)' : 'Solvent (6+ Months)'}</span>`;
        let tone = 'border-l-emerald-500 bg-emerald-500/5';
        let assessment = t('check.runway.risk.safe');

        if (months < 3) {
          statusBadge = `<span class="pill pill-muted font-mono text-xs font-semibold text-rose-400"><span class="dot bg-rose-500" aria-hidden="true"></span>${lang === 'uk' ? 'Критичний фінансовий ризик' : 'Acute Vulnerability'}</span>`;
          tone = 'border-l-rose-500 bg-rose-500/5';
          assessment = t('check.runway.risk.high');
        } else if (months < 6) {
          statusBadge = `<span class="pill pill-muted font-mono text-xs text-amber-400"><span class="dot bg-amber-500" aria-hidden="true"></span>${lang === 'uk' ? 'Помірне навантаження' : 'Moderate Stress'}</span>`;
          tone = 'border-l-amber-500 bg-amber-500/5';
          assessment = t('check.runway.risk.medium');
        }

        runwayResult.innerHTML = `
          <div class="callout ${tone} rounded-xl p-4">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="text-sm sm:text-base font-semibold text-hoba-text">${esc(t('check.runway.horizon', { months: months.toFixed(1) }))}</span>
              ${statusBadge}
            </div>
            <p class="text-xs sm:text-sm text-hoba-muted mt-2 leading-relaxed">${esc(assessment)}</p>
          </div>
        `;
      }

      savingsInput?.addEventListener('input', renderRunway);
      burnInput?.addEventListener('input', renderRunway);
      renderRunway();
    }
  </script>
</Layout>
