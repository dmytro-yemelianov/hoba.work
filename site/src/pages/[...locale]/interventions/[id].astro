---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EntityBadge from '../../../components/EntityBadge.astro';
import EntityRow from '../../../components/EntityRow.astro';
import Specimen from '../../../components/Specimen.astro';
import { getGraph } from '../../../lib/registry';
import { asHeading, LANGS, localeParams, localePrefix, useTranslations, type Lang } from '../../../i18n/utils';
import type { InterventionNode } from '@hoba/registry';

export async function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    getGraph(lang).bundle.interventions.map((intervention) => ({ params: { ...localeParams(lang), id: intervention.id }, props: { lang, intervention } }))
  );
}

const { lang, intervention } = Astro.props as { lang: Lang; intervention: InterventionNode };
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const graph = getGraph(lang);
const ROUTES: Record<string, string> = { mechanism: 'mechanisms', barrier: 'barriers', pattern: 'patterns', loop: 'loops' };
const targets = intervention.targets.map((id) => {
  const node = graph.getNode(id);
  const route = node ? ROUTES[node.type] : undefined;
  return { id, title: node?.title ?? id, type: node?.type, href: route ? `${prefix}/${route}/${id}` : undefined };
});
---
<Layout lang={lang} title={`${intervention.id} — ${intervention.title}`} description={intervention.summary} activeNav="registry">
  <PageHeader title={intervention.title} lead={intervention.summary}>
      <nav slot="eyebrow" class="text-sm text-hoba-muted flex flex-wrap items-center gap-2" aria-label="Breadcrumb">
        <a href={`${prefix}/registry`} class="hover:text-hoba-text">{t('common.registry')}</a><span>/</span>
        <a href={`${prefix}/registry?type=intervention`} class="hover:text-hoba-text">{t('entity.plural.intervention')}</a><span>/</span>
        <span class="text-hoba-accent font-mono">{intervention.id}</span>
      </nav>
      <div slot="meta" class="flex flex-wrap items-center gap-1.5">
        <EntityBadge type="intervention" id={intervention.id} lang={lang} />
        <span class="pill pill-muted">{asHeading(t('int.actor'))}: <span class="text-hoba-text">{t(`iactor.${intervention.actor}`)}</span></span>
        <span class="pill pill-muted">{asHeading(t('int.scope'))}: <span class="text-hoba-text">{t(`scope.${intervention.scope}`)}</span></span>
        <span class="pill pill-muted">{asHeading(t('int.cost'))}: <span class="text-hoba-text">{t(`cost.${intervention.cost}`)}</span></span>
        <span class="pill pill-muted">{asHeading(t('common.evidence'))}: <span class="text-hoba-text">{t(`level.${intervention.evidence_level}`)}</span></span>
      </div>
    </PageHeader>

  <div>
    {intervention.specimens.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t('specimen.sectionFixed')}</h2>
        <p class="text-base text-hoba-muted max-w-3xl">{t('specimen.disclaimer')}</p>
        {intervention.specimens.map((specimen) => <Specimen specimen={specimen} lang={lang} />)}
      </section>
    )}

    <section class="section">
      <h2 class="section-title">{asHeading(t('int.targets'))}</h2>
      <ul class="row-list">
        {targets.map((tg) => (
          <EntityRow id={tg.id} title={tg.title} href={tg.href} pill={tg.type ? t(`entity.${tg.type as 'mechanism'}`) : undefined} />
        ))}
      </ul>
    </section>

    <section class="section grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-8">
      <div>
        <h2 class="section-title">{asHeading(t('int.effects'))}</h2>
        <ul class="list-disc pl-5 space-y-1 text-base text-hoba-muted">{intervention.expected_effects.map((ef) => <li>{ef}</li>)}</ul>
      </div>
      <div>
        <h2 class="section-title">{asHeading(t('int.measurements'))}</h2>
        <ul class="list-disc pl-5 space-y-1 text-base text-hoba-muted">{intervention.measurements.map((m) => <li><code class="text-sm">{m}</code></li>)}</ul>
      </div>
    </section>

    <p class="mt-12 pt-4 border-t border-hoba-border text-sm text-hoba-muted flex flex-wrap items-center gap-2">
      <span>{t('common.machineEndpoint')}</span>
      <a href={`/api/v1/interventions/${intervention.id}.json`} target="_blank" class="text-hoba-accent underline underline-offset-2 font-mono">/api/v1/interventions/{intervention.id}.json</a>
    </p>
  </div>
</Layout>
