---
import Layout from '../../../layouts/Layout.astro';
import EntityBadge from '../../../components/EntityBadge.astro';
import { getBundle, getGraph } from '../../../lib/registry';
import { LANGS, localePrefix, useTranslations, type Lang } from '../../../i18n/utils';
import type { InterventionNode } from '@hoba/registry';

export async function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    getBundle(lang).interventions.map((intervention) => ({ params: { locale: lang === 'uk' ? 'uk' : undefined, id: intervention.id }, props: { lang, intervention } }))
  );
}

const { lang, intervention } = Astro.props as { lang: Lang; intervention: InterventionNode };
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const graph = getGraph(lang);
const ROUTES: Record<string, string> = { mechanism: 'mechanisms', barrier: 'barriers', pattern: 'patterns', loop: 'loops' };
const targets = intervention.targets.map((id) => {
  const node = graph.getNode(id);
  const route = node ? ROUTES[node.type] : undefined;
  return { id, title: node?.title ?? id, type: node?.type, href: route ? `${prefix}/${route}/${id}` : undefined };
});
---
<Layout lang={lang} title={`${intervention.id} — ${intervention.title}`} description={intervention.summary} activeNav="registry">
  <div class="max-w-4xl mx-auto space-y-8">
    <nav class="text-xs text-hoba-muted flex items-center gap-2" aria-label="Breadcrumb">
      <a href={`${prefix}/registry`} class="hover:text-hoba-text">{t('common.registry')}</a><span>/</span>
      <a href={`${prefix}/registry?type=intervention`} class="hover:text-hoba-text">{t('entity.plural.intervention')}</a><span>/</span>
      <span class="text-hoba-accent font-mono">{intervention.id}</span>
    </nav>

    <div class="p-6 rounded-md border border-hoba-border bg-hoba-card">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <EntityBadge type="intervention" id={intervention.id} size="md" lang={lang} />
        <div class="flex items-center gap-2 text-xs text-hoba-muted flex-wrap">
          <span>{t('int.actor')} <strong class="text-cyan-700 dark:text-cyan-300">{t(`iactor.${intervention.actor}`)}</strong></span><span>•</span>
          <span>{t('int.scope')} <strong class="text-hoba-text">{t(`scope.${intervention.scope}`)}</strong></span><span>•</span>
          <span>{t('int.cost')} <strong class="text-hoba-text">{t(`cost.${intervention.cost}`)}</strong></span>
        </div>
      </div>
      <h1 class="text-2xl font-semibold text-hoba-text">{intervention.title}</h1>
      <p class="text-sm text-hoba-muted mt-3 leading-relaxed">{intervention.summary}</p>
    </div>

    <div class="p-6 rounded-md border border-hoba-border bg-hoba-card text-sm">
      <h2 class="text-xs font-semibold text-hoba-muted mb-2">{t('int.targets')}</h2>
      <div class="flex flex-wrap gap-2">
        {targets.map((tg) => (
          <a href={tg.href} class="px-2.5 py-1 rounded bg-hoba-bg border border-hoba-border hover:border-cyan-500/50 block">
            <span class="text-cyan-700 dark:text-cyan-300 font-semibold font-mono">{tg.id}</span>
            <span class="text-hoba-muted ml-1">{tg.title}</span>
            {tg.type && <span class="text-xs text-hoba-muted ml-1">({t(`entity.${tg.type as 'mechanism'}`)})</span>}
          </a>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-5 rounded-md border border-hoba-border border-l-2 border-l-emerald-500 bg-hoba-card text-sm">
        <h2 class="font-semibold text-emerald-700 dark:text-emerald-300 mb-3">{t('int.effects')}</h2>
        <ul class="space-y-2 text-hoba-text list-disc list-inside">{intervention.expected_effects.map((ef) => <li>{ef}</li>)}</ul>
      </div>
      <div class="p-5 rounded-md border border-hoba-border border-l-2 border-l-cyan-500 bg-hoba-card text-sm">
        <h2 class="font-semibold text-cyan-700 dark:text-cyan-300 mb-3">{t('int.measurements')}</h2>
        <ul class="space-y-2 text-hoba-text list-disc list-inside">{intervention.measurements.map((m) => <li class=""><code>{m}</code></li>)}</ul>
      </div>
    </div>

    <div class="p-4 rounded-md border border-hoba-border bg-hoba-card flex items-center justify-between text-xs text-hoba-muted gap-2 flex-wrap">
      <span>{t('common.machineEndpoint')}</span>
      <a href={`/api/v1/interventions/${intervention.id}.json`} target="_blank" class="text-hoba-accent hover:underline font-mono">/api/v1/interventions/{intervention.id}.json</a>
    </div>
  </div>
</Layout>
