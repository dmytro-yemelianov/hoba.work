---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { EMPIRICAL_SCENARIOS, getBundle, slimBundle, STAGES } from '../../lib/registry';
import { clientDictionary, localeFromParams, localePrefix, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
const bundleJSON = JSON.stringify(slimBundle(bundle)).replace(/</g, '\\u003c');
const stagesWithBarriers = STAGES.filter((st) => bundle.barriers.some((b) => b.stage === st));

const WIZ_KEYS = [
  'wiz.noSelection', 'wiz.noGate', 'wiz.passCondition', 'wiz.gate', 'wiz.noMechanisms', 'wiz.honestBaseline', 'wiz.emitsSignal', 'wiz.emitsTitle',
  'wiz.noPatterns', 'wiz.noLoops', 'wiz.noNonInf', 'wiz.noneIdentified', 'wiz.probe', 'wiz.cost', 'wiz.action', 'wiz.expectedSignal', 'wiz.noProbes',
  'wiz.ranIt', 'wiz.clearProbe', 'wiz.narrowing', 'wiz.narrowingFrom', 'wiz.remaining', 'wiz.ruledOut', 'wiz.ruledNothing',
  'wiz.limits', 'wiz.minimalProbes', 'wiz.cannotSeparate', 'wiz.settlesNothing',
  'wiz.stop', 'wiz.stopTail', 'wiz.verdict', 'wiz.verdictTail', 'wiz.summaryNoObs', 'wiz.summaryLow', 'wiz.summary', 'wiz.copied', 'wiz.clipboardDenied',
  'wiz.md.title', 'wiz.md.generatedBy', 'wiz.md.registry', 'wiz.md.mode', 'wiz.md.verdict', 'wiz.md.zone', 'wiz.md.h', 'wiz.md.stage', 'wiz.md.o', 'wiz.md.b',
  'wiz.md.patterns', 'wiz.md.nonInf', 'wiz.md.a', 'wiz.md.candidate', 'wiz.md.intermediary', 'wiz.md.none', 'wiz.md.probes', 'wiz.md.noneJustified', 'wiz.md.noneWord',
  'wiz.disclaimer', 'zone.endogenous', 'zone.exogenous', 'zone.mixed', 'zone.undetermined', 'removability.short.candidate', 'removability.short.intermediary', 'removability.short.none',
  'cost.low', 'cost.medium', 'cost.high',
  'stage.pre-posting', 'stage.sourcing', 'stage.ingestion', 'stage.screening', 'stage.recruiter', 'stage.technical', 'stage.hiring-manager', 'stage.team', 'stage.client', 'stage.compensation', 'stage.offer', 'stage.post-offer',
] as const;
const i18n = JSON.stringify({ prefix, lang, ...clientDictionary(lang, WIZ_KEYS) }).replace(/</g, '\\u003c');

const ARTIFACT_CATEGORIES = [
  { id: 'messages', key: 'analyze.cat.messages', icon: '📬', ids: ['A-002', 'A-008', 'A-010', 'A-020'] },
  { id: 'delays', key: 'analyze.cat.delays', icon: '⏳', ids: ['A-001', 'A-005', 'A-007', 'A-016'] },
  { id: 'listings', key: 'analyze.cat.listings', icon: '📋', ids: ['A-004', 'A-018', 'A-021'] },
  { id: 'tasks', key: 'analyze.cat.tasks', icon: '📝', ids: ['A-003', 'A-009', 'A-012', 'A-019'] },
  { id: 'offers', key: 'analyze.cat.offers', icon: '💰', ids: ['A-006', 'A-011', 'A-013', 'A-014', 'A-015', 'A-017'] },
] as const;

const SCENARIO_ICONS: Record<string, string> = {
  'ghost-refresh': '👻',
  'ats-knockout': '🤖',
  'post-panel-freeze': '🧊',
  'downlevelling-trap': '📉',
};

const tabs = [
  { k: 'h', letter: 'H', stepNum: '1', title: t('analyze.tab.h') },
  { k: 'o', letter: 'O', stepNum: '2', title: t('analyze.tab.o') },
  { k: 'b', letter: 'B', stepNum: '3', title: t('analyze.tab.b') },
  { k: 'a', letter: 'A', stepNum: '4', title: t('analyze.tab.a') },
] as const;

const zones = [
  { key: 'candidate', count: 'count-candidate', list: 'list-candidate', rule: 'border-l-hoba-candidate', bg: 'bg-hoba-candidate/5' },
  { key: 'intermediary', count: 'count-intermediary', list: 'list-intermediary', rule: 'border-l-hoba-intermediary', bg: 'bg-hoba-intermediary/5' },
  { key: 'none', count: 'count-noagency', list: 'list-noagency', rule: 'border-l-hoba-exogenous', bg: 'bg-hoba-exogenous/5' },
] as const;
---
<Layout lang={lang} title={t('analyze.title')} activeNav="analyze">
  <PageHeader kicker={t('analyze.kicker', { version: bundle.version })} title={t('analyze.heading')} lead={t('analyze.intro')}>
    <p slot="actions" class="flex items-center gap-2 text-sm text-hoba-muted"><span class="dot bg-hoba-candidate" aria-hidden="true"></span>{t('analyze.privacy')}</p>
  </PageHeader>

  <div class="mt-4">
    <!-- Structured Wizard Navigation Stepper -->
    <nav class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-8" aria-label="Wizard Steps" role="tablist">
      {tabs.map((tab) => (
        <button
          id={`tab-${tab.k}`}
          data-step={tab.k}
          class="wizard-tab group relative flex flex-col items-start p-3 sm:p-4 rounded-lg border border-hoba-border bg-hoba-card text-left transition-all hover:border-hoba-accent/50 focus:outline-none focus:ring-2 focus:ring-hoba-accent cursor-pointer"
          role="tab"
          aria-selected={tab.k === 'h'}
        >
          <div class="flex items-center justify-between w-full">
            <span class="step-badge inline-flex items-center justify-center w-6 h-6 rounded-full font-mono text-xs font-semibold bg-hoba-border text-hoba-muted group-hover:text-hoba-text transition-colors">
              {tab.letter}
            </span>
            <span class="text-[11px] font-mono text-hoba-muted tabular-nums">0{tab.stepNum}</span>
          </div>
          <span class="mt-2 text-sm font-medium text-hoba-text truncate w-full">{tab.title}</span>
        </button>
      ))}
    </nav>

    <!-- STEP H: Hard Facts -->
    <section id="step-h" class="wizard-step space-y-8">
      <div class="border-b border-hoba-border pb-4">
        <h2 class="text-2xl font-semibold text-hoba-text">{t('analyze.h.title')}</h2>
        <p class="mt-1 text-base text-hoba-muted">{t('analyze.h.sub')}</p>
      </div>

      <!-- Quick Preset Scenarios Grid -->
      <div class="rounded-xl border border-hoba-border bg-hoba-card/60 p-4 sm:p-5">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="text-xs font-semibold uppercase tracking-wider text-hoba-accent flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            {t('analyze.scenarios.label')}
          </span>
          <span class="text-xs text-hoba-muted">{t('analyze.scenarios.badge')}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {EMPIRICAL_SCENARIOS.map((sc) => (
            <button
              type="button"
              class="scenario-preset group flex flex-col p-3 rounded-lg border border-hoba-border bg-hoba-bg hover:border-hoba-accent hover:bg-hoba-card transition-all text-left cursor-pointer"
              data-scenario-id={sc.id}
              data-stage={sc.stage ?? ''}
              data-artifacts={JSON.stringify(sc.artifacts)}
              title={sc.summary}
            >
              <div class="flex items-center gap-2">
                <span class="text-lg" aria-hidden="true">{SCENARIO_ICONS[sc.id] ?? '📌'}</span>
                <span class="text-sm font-semibold text-hoba-text group-hover:text-hoba-accent transition-colors leading-tight">
                  {t(`analyze.scenarios.${sc.id}`)}
                </span>
              </div>
              <p class="mt-1.5 text-xs text-hoba-muted line-clamp-2 leading-relaxed">{sc.summary}</p>
              <span class="mt-auto pt-2 text-[11px] font-mono text-hoba-accent font-medium">
                {sc.artifacts.length} {lang === 'uk' ? 'спостережень' : 'signals'} {sc.stage ? `· ${t(`stage.${sc.stage}`)}` : ''}
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- Stage Selector -->
      <fieldset class="rounded-xl border border-hoba-border bg-hoba-card/60 p-4 sm:p-5">
        <legend class="text-xs font-semibold uppercase tracking-wider text-hoba-text px-1 mb-2">{t('analyze.h.stageLegend')}</legend>
        <div class="flex flex-wrap gap-1.5">
          {stagesWithBarriers.map((st) => (
            <label class="pill-toggle cursor-pointer">
              <input type="radio" name="stage_select" value={st} />
              <span class="pill-label text-xs sm:text-sm">{t(`stage.${st}`)}</span>
            </label>
          ))}
        </div>
        <p class="mt-2.5 text-xs text-hoba-muted">{t('analyze.h.stageHint')}</p>
      </fieldset>

      <!-- Observations Catalog & Filter Bar -->
      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-hoba-card p-3 rounded-lg border border-hoba-border">
          <div class="flex items-center gap-2">
            <span class="text-sm font-medium text-hoba-text">{t('analyze.h.selectSignals')}</span>
            <span id="selected-counter" class="pill pill-muted text-xs font-mono">0</span>
          </div>
          <div class="flex items-center gap-2 w-full sm:w-auto">
            <input
              type="text"
              id="artifact-search-input"
              placeholder={t('analyze.h.filter')}
              class="w-full sm:w-64 px-3 py-1.5 bg-hoba-bg border border-hoba-border rounded-md text-sm text-hoba-text placeholder-hoba-muted focus:outline-none focus:border-hoba-accent"
            />
            <button id="clear-selected-btn" type="button" class="btn btn-ghost text-xs hidden shrink-0 cursor-pointer">
              {lang === 'uk' ? 'Скинути вибір' : 'Clear'}
            </button>
          </div>
        </div>

        <!-- Categorized Observation Accordion / Groups -->
        <div class="space-y-3" id="categorized-artifacts">
          {ARTIFACT_CATEGORIES.map((cat, idx) => {
            const catArtifacts = bundle.artifacts.filter((a) => (cat.ids as readonly string[]).includes(a.id));
            if (!catArtifacts.length) return null;
            return (
              <details class="disclosure artifact-category-group" open={idx === 0}>
                <summary>
                  <span class="flex items-center gap-2 font-semibold text-sm text-hoba-text">
                    <span aria-hidden="true">{cat.icon}</span>
                    <span>{t(cat.key as any)}</span>
                    <span class="pill pill-muted text-[11px] font-mono">{catArtifacts.length}</span>
                  </span>
                  <svg class="disclosure-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="disclosure-body grid grid-cols-1 md:grid-cols-2 gap-2.5 pt-2">
                  {catArtifacts.map((art) => (
                    <div class="artifact-item" data-search={`${art.id} ${art.title} ${art.summary}`.toLowerCase()}>
                      <label class="group relative flex items-start gap-3 p-3 rounded-lg border border-hoba-border/70 bg-hoba-bg hover:border-hoba-accent hover:bg-hoba-card/80 transition-all cursor-pointer h-full">
                        <input type="checkbox" name="artifacts_selected" value={art.id} class="checkbox mt-1 shrink-0" />
                        <div class="flex flex-col flex-1 min-w-0">
                          <div class="flex items-baseline justify-between gap-2">
                            <span class="font-mono text-xs font-semibold text-hoba-accent">{art.id}</span>
                            <span class="text-[11px] font-mono text-hoba-muted">{art.stages.map((s) => t(`stage.${s}`)).join(' · ')}</span>
                          </div>
                          <span class="mt-1 text-sm font-medium text-hoba-text group-hover:text-hoba-accent transition-colors leading-snug">{art.title}</span>
                          <span class="mt-1 text-xs text-hoba-muted line-clamp-2 leading-relaxed">{art.summary}</span>
                        </div>
                      </label>
                    </div>
                  ))}
                </div>
              </details>
            );
          })}
        </div>
      </div>

      <div class="pt-6 border-t border-hoba-border flex items-center justify-between">
        <span id="step-h-summary" class="text-sm text-hoba-muted font-mono"></span>
        <button data-goto="o" class="btn btn-primary">{t('analyze.h.next')}</button>
      </div>
    </section>

    <!-- STEP O: Funnel Obstacle -->
    <section id="step-o" class="wizard-step hidden space-y-8">
      <div class="border-b border-hoba-border pb-4">
        <h2 class="text-2xl font-semibold text-hoba-text">{t('analyze.o.title')}</h2>
        <p class="mt-1 text-base text-hoba-muted">{t('analyze.o.sub')}</p>
      </div>
      <div id="barriers-output" class="space-y-4"></div>
      <div class="pt-6 border-t border-hoba-border flex justify-between">
        <button data-goto="h" class="btn btn-secondary">{t('analyze.o.back')}</button>
        <button data-goto="b" class="btn btn-primary">{t('analyze.o.next')}</button>
      </div>
    </section>

    <!-- STEP B: Behind the Obstacle -->
    <section id="step-b" class="wizard-step hidden space-y-8">
      <div class="border-b border-hoba-border pb-4">
        <h2 class="text-2xl font-semibold text-hoba-text">{t('analyze.b.title')}</h2>
        <p class="mt-1 text-base text-hoba-muted">{t('analyze.b.sub')}</p>
      </div>

      <div class="rounded-xl border border-hoba-border bg-hoba-card p-5">
        <h3 class="text-base font-semibold text-hoba-text mb-3">{t('analyze.b.mechanisms')}</h3>
        <div id="mechanisms-output"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-xl border border-hoba-border bg-hoba-card p-5">
          <h3 class="text-base font-semibold text-hoba-text mb-3">{t('analyze.b.patterns')}</h3>
          <div id="patterns-output"></div>
        </div>
        <div class="rounded-xl border border-hoba-border bg-hoba-card p-5">
          <h3 class="text-base font-semibold text-hoba-text mb-3">{t('analyze.b.loops')}</h3>
          <div id="loops-output"></div>
        </div>
      </div>

      <div class="callout border-l-hoba-exogenous rounded-xl">
        <h3 class="text-base font-semibold text-hoba-text">{t('analyze.b.nonInf')}</h3>
        <ul id="noninferences-output" class="mt-2 list-disc pl-5 space-y-1 text-sm text-hoba-muted"></ul>
      </div>

      <div class="pt-6 border-t border-hoba-border flex justify-between">
        <button data-goto="o" class="btn btn-secondary">{t('analyze.b.back')}</button>
        <button data-goto="a" class="btn btn-primary">{t('analyze.b.next')}</button>
      </div>
    </section>

    <!-- STEP A: Agency and Probes -->
    <section id="step-a" class="wizard-step hidden space-y-8">
      <div class="border-b border-hoba-border pb-4">
        <h2 class="text-2xl font-semibold text-hoba-text">{t('analyze.a.title')}</h2>
        <p class="mt-1 text-base text-hoba-muted">{t('analyze.a.sub')}</p>
      </div>

      <!-- Agency 3-Zone Partition Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {zones.map((zone) => (
          <div class={`p-4 rounded-xl border border-hoba-border ${zone.bg} border-l-4 ${zone.rule} flex flex-col`}>
            <div class="flex items-center justify-between">
              <h3 class="text-base font-semibold text-hoba-text">{t(`analyze.a.zone.${zone.key}`)}</h3>
              <span id={zone.count} class="pill pill-muted font-mono font-semibold text-xs tabular-nums">0</span>
            </div>
            <p class="mt-1 text-xs text-hoba-muted">{t(`analyze.a.zone.${zone.key}.desc`)}</p>
            <ul id={zone.list} class="row-list mt-3 space-y-1 text-sm"></ul>
          </div>
        ))}
      </div>

      <!-- Diagnostic Probes Interactive Section -->
      <div class="rounded-xl border border-hoba-border bg-hoba-card p-5">
        <h3 class="text-base font-semibold text-hoba-text mb-2">{t('analyze.a.probes')}</h3>
        <ul id="probes-output" class="row-list divide-y divide-hoba-border"></ul>
      </div>

      <div id="narrowing-output"></div>
      <div id="separation-output"></div>

      <!-- Final Verdict Banner -->
      <div id="verdict-banner" class="callout rounded-xl" aria-live="polite"></div>

      <div class="pt-6 border-t border-hoba-border flex flex-wrap items-center justify-between gap-4">
        <button data-goto="b" class="btn btn-secondary">{t('analyze.a.back')}</button>
        <div class="flex items-center gap-3">
          <span id="copy-status" class="text-sm text-hoba-muted font-mono" role="status"></span>
          <button id="btn-copy-report" class="btn btn-secondary">{t('analyze.a.copy')}</button>
          <button id="btn-reset" class="btn btn-ghost">{t('analyze.a.reset')}</button>
        </div>
      </div>
    </section>
  </div>

  <script type="application/json" id="hoba-bundle" set:html={bundleJSON} />
  <script type="application/json" id="hoba-i18n" set:html={i18n} />
  <script>
    // The wizard runs the very same HOBADiagnosticEngine as the CLI and the MCP server.
    import { HOBADiagnosticEngine, type DiagnosticResult, type ProbeResult, type RegistryBundle, type StageId } from '@hoba/registry/core';

    type Step = 'h' | 'o' | 'b' | 'a';
    const STEPS: Step[] = ['h', 'o', 'b', 'a'];

    const bundle = JSON.parse(document.getElementById('hoba-bundle')!.textContent!) as RegistryBundle;
    const i18n = JSON.parse(document.getElementById('hoba-i18n')!.textContent!) as Record<string, string>;
    const t = (key: string, vars?: Record<string, string | number>) =>
      (i18n[key] ?? key).replace(/\{(\w+)\}/g, (_, n: string) => (vars && n in vars ? String(vars[n]) : `{${n}}`));
    const prefix = i18n.prefix ?? '';
    const engine = new HOBADiagnosticEngine(bundle);

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const esc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    /** One hairline row: id, linked title, qualifier pills, and a note underneath. */
    const row = (id: string, href: string, title: string, pills: string[], note?: string) => `
      <li>
        <a href="${href}" target="_blank" class="row-link">
          <span class="font-mono text-sm text-hoba-accent shrink-0">${esc(id)}</span>
          <span class="text-hoba-text">${esc(title)}</span>
          ${pills.length ? `<span class="ml-auto flex flex-wrap gap-1.5">${pills.join('')}</span>` : ''}
          ${note ? `<span class="w-full text-sm text-hoba-muted">${esc(note)}</span>` : ''}
        </a>
      </li>`;
    const pill = (text: string, title?: string) =>
      `<span class="pill pill-muted"${title ? ` title="${esc(title)}"` : ''}>${esc(text)}</span>`;
    const empty = (text: string) => `<p class="text-base text-hoba-muted">${esc(text)}</p>`;

    // Probe results the reader has recorded. Kept here rather than in the DOM
    // because a result outlives the markup that collected it: changing the
    const probeResults = new Map<string, string>();

    function collectInputs(): { artifacts: string[]; stage?: StageId; probe_results: ProbeResult[] } {
      const artifacts = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="artifacts_selected"]:checked')).map((el) => el.value);
      const stage = document.querySelector<HTMLInputElement>('input[name="stage_select"]:checked')?.value as StageId | undefined;
      return {
        artifacts,
        stage,
        probe_results: [...probeResults].map(([probe, outcome]) => ({ probe, outcome })),
      };
    }
    const analyze = (): DiagnosticResult => engine.analyze(collectInputs());

    function updateSelectionCounter() {
      const inputs = collectInputs();
      const count = inputs.artifacts.length;
      const counter = $('selected-counter');
      if (counter) counter.textContent = String(count);
      const clearBtn = $('clear-selected-btn');
      if (clearBtn) clearBtn.classList.toggle('hidden', count === 0);
      const summary = $('step-h-summary');
      if (summary) {
        summary.textContent = count > 0 ? `${count} signals selected` : '';
      }
    }

    // Recording an outcome is an input, so it re-runs the analysis the same way
    // ticking an observation does.
    document.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('.probe-outcome') : null;
      if (!button) return;
      const probe = button.dataset.probe ?? '';
      const outcome = button.dataset.outcome ?? '';
      if (!outcome || probeResults.get(probe) === outcome) probeResults.delete(probe);
      else probeResults.set(probe, outcome);
      renderStepA();
    });

    function setStep(step: Step) {
      for (const s of STEPS) {
        $(`step-${s}`).classList.toggle('hidden', s !== step);
        const tab = $(`tab-${s}`);
        const isActive = s === step;
        tab.classList.toggle('border-hoba-accent', isActive);
        tab.classList.toggle('bg-hoba-accent/10', isActive);
        tab.setAttribute('aria-selected', String(isActive));
        const badge = tab.querySelector('.step-badge');
        if (badge) {
          badge.classList.toggle('bg-hoba-accent', isActive);
          badge.classList.toggle('text-white', isActive);
          badge.classList.toggle('bg-hoba-border', !isActive);
          badge.classList.toggle('text-hoba-muted', !isActive);
        }
      }
      if (step === 'o') renderStepO();
      if (step === 'b') renderStepB();
      if (step === 'a') renderStepA();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    document.querySelectorAll<HTMLElement>('.wizard-tab').forEach((el) => el.addEventListener('click', () => setStep(el.dataset.step as Step)));
    document.querySelectorAll<HTMLElement>('[data-goto]').forEach((b) => b.addEventListener('click', () => setStep(b.dataset.goto as Step)));

    $<HTMLInputElement>('artifact-search-input')?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
      document.querySelectorAll<HTMLElement>('.artifact-item').forEach((el) => {
        el.classList.toggle('hidden', Boolean(q) && !(el.dataset.search ?? '').includes(q));
      });
      document.querySelectorAll<HTMLDetailsElement>('.artifact-category-group').forEach((grp) => {
        const visibleChildren = grp.querySelectorAll('.artifact-item:not(.hidden)');
        grp.classList.toggle('hidden', Boolean(q) && visibleChildren.length === 0);
        if (q && visibleChildren.length > 0) grp.open = true;
      });
    });

    document.querySelectorAll<HTMLInputElement>('input[name="artifacts_selected"]').forEach((chk) => {
      chk.addEventListener('change', updateSelectionCounter);
    });

    $('clear-selected-btn')?.addEventListener('click', () => {
      document.querySelectorAll<HTMLInputElement>('input[name="artifacts_selected"]').forEach((chk) => (chk.checked = false));
      updateSelectionCounter();
    });

    const stageLabel = (s: string) => t(`stage.${s}`);
    const zoneLabel = (z: string) => t(`zone.${z}`);

    function renderStepO() {
      const res = analyze();
      const container = $('barriers-output');
      if (res.hard_facts.selected_artifacts.length === 0 && !res.hard_facts.stage) {
        container.innerHTML = empty(t('wiz.noSelection'));
        return;
      }
      if (res.obstacle.identified_barriers.length === 0) {
        container.innerHTML = empty(t('wiz.noGate'));
        return;
      }
      container.innerHTML = `<ul class="row-list divide-y divide-hoba-border">${res.obstacle.identified_barriers
        .map((b) =>
          row(b.id, `${prefix}/barriers/${b.id}`, b.title, [pill(stageLabel(b.stage)), pill(t('wiz.gate', { n: b.order }))],
            `${b.description} — ${t('wiz.passCondition')} ${b.pass_condition}`)
        )
        .join('')}</ul>`;
    }

    function renderStepB() {
      const res = analyze();
      $('mechanisms-output').innerHTML = res.behind.compatible_mechanisms.length
        ? `<ul class="row-list divide-y divide-hoba-border">${res.behind.compatible_mechanisms
            .map((m) =>
              row(m.mechanism.id, `${prefix}/mechanisms/${m.mechanism.id}`, m.mechanism.title, [
                ...(m.honest_baseline ? [pill(t('wiz.honestBaseline'))] : []),
                ...(m.emitted_by_evidence ? [pill(t('wiz.emitsSignal'), t('wiz.emitsTitle'))] : []),
                pill(t(`removability.short.${m.removability}`)),
              ], m.mechanism.summary)
            )
            .join('')}</ul>`
        : empty(t('wiz.noMechanisms'));

      $('patterns-output').innerHTML = res.behind.related_patterns.length
        ? `<ul class="row-list divide-y divide-hoba-border">${res.behind.related_patterns.map((p) => row(p.id, `${prefix}/patterns/${p.id}`, p.title, [], p.summary)).join('')}</ul>`
        : empty(t('wiz.noPatterns'));

      $('loops-output').innerHTML = res.behind.related_loops.length
        ? `<ul class="row-list divide-y divide-hoba-border">${res.behind.related_loops.map((l) => row(l.id, `${prefix}/loops/${l.id}`, l.title, [], l.summary)).join('')}</ul>`
        : empty(t('wiz.noLoops'));

      $('noninferences-output').innerHTML = (res.behind.non_inferences.length ? res.behind.non_inferences : [t('wiz.noNonInf')])
        .map((ni) => `<li>${esc(ni)}</li>`)
        .join('');
    }

    const agencyList = (items: DiagnosticResult['agency']['candidate_removable']) =>
      items.length
        ? items.map((m) => row(m.id, `${prefix}/mechanisms/${m.id}`, m.title, [])).join('')
        : `<li class="row text-hoba-muted text-xs">${esc(t('wiz.noneIdentified'))}</li>`;

    function summaryText(res: DiagnosticResult): string {
      if (res.hard_facts.selected_artifacts.length === 0) return t('wiz.summaryNoObs');
      if (res.verdict === 'low_signal_ambiguity') return t('wiz.summaryLow');
      return t('wiz.summary', { probes: res.counts.probes, candidate: res.counts.candidate_removable });
    }

    function renderStepA() {
      const res = analyze();
      $('count-candidate').textContent = String(res.counts.candidate_removable);
      $('count-intermediary').textContent = String(res.counts.intermediary);
      $('count-noagency').textContent = String(res.counts.no_agency);
      $('list-candidate').innerHTML = agencyList(res.agency.candidate_removable);
      $('list-intermediary').innerHTML = agencyList(res.agency.intermediary_dependent);
      $('list-noagency').innerHTML = agencyList(res.agency.exogenous_no_agency);

      $('probes-output').innerHTML = res.agency.diagnostic_probes.length
        ? res.agency.diagnostic_probes
            .map((p) => `
              <li class="py-3">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="font-mono text-xs font-semibold text-hoba-accent">${esc(t('wiz.probe', { id: p.id }))}</span>
                  <span class="ml-auto">${pill(t('wiz.cost', { cost: t(`cost.${p.cost}`) }))}</span>
                </div>
                <p class="mt-1 text-sm font-medium text-hoba-text"><span class="text-hoba-muted font-normal">${esc(t('wiz.action'))}</span> ${esc(p.action)}</p>
                <p class="mt-0.5 text-xs text-hoba-muted"><span class="text-hoba-text font-medium">${esc(t('wiz.expectedSignal'))}</span> ${esc(p.expected_signal)}</p>
                ${p.outcomes.length === 0 ? '' : `
                <p class="mt-2 text-xs font-medium text-hoba-muted">${esc(t('wiz.ranIt'))}</p>
                <div class="mt-1.5 flex flex-wrap gap-1.5">
                  ${p.outcomes
                    .map((o) => `
                      <button type="button" class="pill probe-outcome text-xs font-medium ${probeResults.get(p.id) === o.id ? 'pill-active' : 'pill-muted'}" data-probe="${esc(p.id)}" data-outcome="${esc(o.id)}"
                        aria-pressed="${probeResults.get(p.id) === o.id}">${esc(o.label)}</button>`)
                    .join('')}
                  ${probeResults.has(p.id) ? `<button type="button" class="pill probe-outcome text-xs pill-ghost" data-probe="${esc(p.id)}" data-outcome="" aria-pressed="false">${esc(t('wiz.clearProbe'))}</button>` : ''}
                </div>`}
              </li>`)
            .join('')
        : `<li class="row text-hoba-muted text-xs">${esc(t('wiz.noProbes'))}</li>`;

      const { narrowing, separation } = res.behind;
      $('narrowing-output').innerHTML = narrowing.steps.length === 0
        ? ''
        : [
            `<div class="rounded-xl border border-hoba-border bg-hoba-card p-5 mt-6">`,
            `<h3 class="text-base font-semibold text-hoba-text">${esc(t('wiz.narrowing'))}</h3>`,
            `<p class="text-xs text-hoba-muted mt-1">${esc(t('wiz.narrowingFrom', { n: res.behind.compatible_before_probes.length }))}</p>`,
            '<ol class="row-list divide-y divide-hoba-border mt-3">',
            ...narrowing.steps.map((step) => `
              <li class="py-2.5">
                <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="font-mono text-xs font-semibold text-hoba-accent">${esc(step.probe)}</span>
                  <span class="text-sm font-medium text-hoba-text">${esc(step.label)}</span>
                  <span class="ml-auto">${pill(t('wiz.remaining', { n: step.remaining }))}</span>
                </p>
                <p class="mt-1 text-xs text-hoba-muted">${
                  step.eliminated.length
                    ? esc(t('wiz.ruledOut', { ids: step.eliminated.join(', ') }))
                    : esc(t('wiz.ruledNothing'))
                }</p>
                ${step.because ? `<p class="mt-0.5 text-xs text-hoba-muted italic">${esc(step.because)}</p>` : ''}
              </li>`),
            '</ol></div>',
          ].join('');

      $('separation-output').innerHTML = separation.indistinguishable_groups.length === 0 && separation.minimal_probes.length === 0
        ? ''
        : [
            `<div class="rounded-xl border border-hoba-border bg-hoba-card p-5 mt-6">`,
            `<h3 class="text-base font-semibold text-hoba-text">${esc(t('wiz.limits'))}</h3>`,
            separation.minimal_probes.length
              ? `<p class="text-xs text-hoba-muted mt-1">${esc(t('wiz.minimalProbes', { ids: separation.minimal_probes.join(', ') }))}</p>`
              : res.agency.diagnostic_probes.length
                ? `<p class="text-xs text-hoba-muted max-w-3xl mt-1">${esc(t('wiz.settlesNothing'))}</p>`
                : '',
            separation.indistinguishable_groups.length
              ? `<p class="mt-2 text-xs text-hoba-muted">${esc(t('wiz.cannotSeparate'))}</p><ul class="row-list mt-1">` +
                separation.indistinguishable_groups
                  .map((g) => `<li class="row text-xs"><span class="font-mono text-hoba-accent">${esc(g.join(' / '))}</span></li>`)
                  .join('') +
                '</ul>'
              : '',
            '</div>',
          ].join('');

      const banner = $('verdict-banner');
      const zone = zoneLabel(res.agency.agency_zone);
      const low = res.verdict === 'low_signal_ambiguity';
      banner.className = `callout rounded-xl ${low ? 'border-l-hoba-intermediary bg-hoba-intermediary/5' : 'border-l-hoba-accent bg-hoba-accent/5'}`;
      banner.innerHTML = `<p class="text-sm text-hoba-text leading-relaxed"><strong>${esc(low ? t('wiz.stop', { zone }) : t('wiz.verdict', { zone }))}</strong> ${esc(summaryText(res))} ${esc(low ? t('wiz.stopTail') : t('wiz.verdictTail'))}</p>`;
    }

    $('btn-copy-report').addEventListener('click', async () => {
      const res = analyze();
      const list = (items: string[], fallback: string) => (items.length ? items : [`- ${fallback}`]);
      const md = [
        `# ${t('wiz.md.title')}`,
        `**${t('wiz.md.generatedBy')}:** https://hoba.work${prefix}/analyze  `,
        `**${t('wiz.md.registry')}:** ${bundle.version} (schema ${bundle.schema_version})  `,
        `**${t('wiz.md.mode')}:** ${res.mode}  `,
        `**${t('wiz.md.verdict')}:** ${res.verdict} · ${t('wiz.md.zone')}: ${zoneLabel(res.agency.agency_zone)}`,
        '',
        `## ${t('wiz.md.h')}`,
        ...res.hard_facts.selected_artifacts.map((a) => `- **${a.id}**: ${a.title}`),
        res.hard_facts.stage ? `- **${t('wiz.md.stage')}:** ${stageLabel(res.hard_facts.stage)}` : '',
        '',
        `## ${t('wiz.md.o')}`,
        ...list(res.obstacle.identified_barriers.map((b) => `- **${b.id}** (${stageLabel(b.stage)}): ${b.title} -> ${b.pass_condition}`), t('wiz.md.noneWord')),
        '',
        `## ${t('wiz.md.b')}`,
        ...list(res.behind.compatible_mechanisms.map((m) => `- **${m.mechanism.id}** [${t(`removability.short.${m.removability}`)}${m.honest_baseline ? `, ${t('wiz.honestBaseline').toLowerCase()}` : ''}]: ${m.mechanism.title}`), t('wiz.md.noneWord')),
        '',
        `### ${t('wiz.md.patterns')}`,
        ...list(res.behind.related_patterns.map((p) => `- **${p.id}**: ${p.title}`), t('wiz.md.noneWord')),
        '',
        `### ${t('wiz.md.nonInf')}`,
        ...list(res.behind.non_inferences.map((ni) => `- ${ni}`), t('wiz.md.noneWord')),
        '',
        `## ${t('wiz.md.a')}`,
        `- **${t('wiz.md.candidate')}:** ${res.counts.candidate_removable}`,
        `- **${t('wiz.md.intermediary')}:** ${res.counts.intermediary}`,
        `- **${t('wiz.md.none')}:** ${res.counts.no_agency}`,
        '',
        `### ${t('wiz.md.probes')}`,
        ...list(res.agency.diagnostic_probes.map((p) => `- [${p.id}] ${p.action} (${t('wiz.cost', { cost: t(`cost.${p.cost}`) })})`), t('wiz.md.noneJustified')),
        '',
        `> ${t('wiz.disclaimer')}`,
        '',
      ].join('\n');

      const status = $('copy-status');
      try {
        await navigator.clipboard.writeText(md);
        status.textContent = t('wiz.copied');
      } catch {
        status.textContent = t('wiz.clipboardDenied');
      }
      window.setTimeout(() => (status.textContent = ''), 4000);
    });

    $('btn-reset').addEventListener('click', () => {
      probeResults.clear();
      document.querySelectorAll<HTMLInputElement>('input[type="checkbox"], input[type="radio"]').forEach((el) => (el.checked = false));
      updateSelectionCounter();
      setStep('h');
    });

    document.querySelectorAll<HTMLButtonElement>('.scenario-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        probeResults.clear();
        const targetStage = btn.dataset.stage ?? '';
        const targetArtifacts: string[] = JSON.parse(btn.dataset.artifacts ?? '[]');

        document.querySelectorAll<HTMLInputElement>('input[name="stage_select"]').forEach((el) => {
          el.checked = el.value === targetStage;
        });

        document.querySelectorAll<HTMLInputElement>('input[name="artifacts_selected"]').forEach((el) => {
          el.checked = targetArtifacts.includes(el.value);
        });

        updateSelectionCounter();
        setStep('h');
      });
    });

    updateSelectionCounter();
    setStep('h');
  </script>
</Layout>
