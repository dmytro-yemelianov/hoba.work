---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EntityBadge from '../../../components/EntityBadge.astro';
import EntityRow from '../../../components/EntityRow.astro';
import Specimen from '../../../components/Specimen.astro';
import { getBundle } from '../../../lib/registry';
import { asHeading, LANGS, localePrefix, useTranslations, type Lang } from '../../../i18n/utils';
import type { ArtifactNode } from '@hoba/registry';

export async function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    getBundle(lang).artifacts.map((artifact) => ({ params: { locale: lang === 'uk' ? 'uk' : undefined, id: artifact.id }, props: { lang, artifact } }))
  );
}

const { lang, artifact } = Astro.props as { lang: Lang; artifact: ArtifactNode };
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
const compatibleMechanisms = bundle.mechanisms.filter((m) => m.emissions.some((e) => e.artifact === artifact.id));
const relatedPatterns = bundle.patterns.filter((p) => p.required_artifacts.includes(artifact.id));
---
<Layout lang={lang} title={`${artifact.id} — ${artifact.title}`} description={artifact.summary} activeNav="registry">
  <PageHeader title={artifact.title} lead={artifact.summary}>
      <nav slot="eyebrow" class="text-sm text-hoba-muted flex flex-wrap items-center gap-2" aria-label="Breadcrumb">
        <a href={`${prefix}/registry`} class="hover:text-hoba-text">{t('common.registry')}</a><span>/</span>
        <a href={`${prefix}/registry?type=artifact`} class="hover:text-hoba-text">{t('entity.plural.artifact')}</a><span>/</span>
        <span class="text-hoba-accent font-mono">{artifact.id}</span>
      </nav>
      <div slot="meta" class="flex flex-wrap items-center gap-1.5">
        <EntityBadge type="artifact" id={artifact.id} lang={lang} />
        {artifact.stages.map((st) => <span class="pill pill-muted">{t(`stage.${st}`)}</span>)}
        <span class="pill pill-muted">{asHeading(t('common.evidence'))}: <span class="text-hoba-text">{t(`level.${artifact.evidence_level}`)}</span></span>
        <span class="pill pill-muted">{asHeading(t('common.status'))}: <span class="text-hoba-text">{t(`status.${artifact.status}`)}</span></span>
      </div>
    </PageHeader>

  <div>
    {artifact.specimens.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t('specimen.section')}</h2>
        <p class="text-base text-hoba-muted max-w-3xl">{t('specimen.disclaimer')}</p>
        {artifact.specimens.map((specimen) => <Specimen specimen={specimen} lang={lang} />)}
      </section>
    )}

    <div class="callout border-l-hoba-border">
      <h2 class="text-base font-semibold text-hoba-text">{t('art.posture.title')}</h2>
      <p class="mt-1 text-base text-hoba-muted">{t('art.posture.text')}</p>
    </div>

    {artifact.probes.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t('art.probes')}</h2>
        <ul class="row-list">
          {artifact.probes.map((probe) => (
            <li class="py-3">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="font-mono text-sm text-hoba-accent">{t('art.probeLabel', { id: probe.id })}</span>
                <span class="pill pill-muted ml-auto">{t('wiz.cost', { cost: t(`cost.${probe.cost}`) })}</span>
              </div>
              <p class="mt-1 text-base text-hoba-text"><span class="text-hoba-muted">{t('wiz.action')}</span> {probe.action}</p>
              <p class="mt-0.5 text-base text-hoba-muted"><span class="text-hoba-text">{t('wiz.expectedSignal')}</span> {probe.expected_signal}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="section">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="section-title mb-0">{t('art.compatible', { n: compatibleMechanisms.length })}</h2>
        <a href={`${prefix}/analyze`} class="text-sm text-hoba-accent underline underline-offset-2">{t('art.runWizard')}</a>
      </div>
      <ul class="row-list mt-3">
        {compatibleMechanisms.map((m) => (
          <EntityRow
            id={m.id}
            title={m.title}
            href={`${prefix}/mechanisms/${m.id}`}
            pill={t(`removability.short.${m.facets.removability}`)}
            note={m.summary}
          />
        ))}
      </ul>
    </section>

    <div class="callout border-l-hoba-exogenous">
      <h2 class="text-base font-semibold text-hoba-text">{asHeading(t('art.nonInf'))}</h2>
      <ul class="mt-2 list-disc pl-5 space-y-1 text-base text-hoba-muted">{artifact.non_inferences.map((ni) => <li>{ni}</li>)}</ul>
    </div>

    {relatedPatterns.length > 0 && (
      <section class="section">
        <h2 class="section-title">{asHeading(t('art.patterns'))}</h2>
        <ul class="row-list">
          {relatedPatterns.map((p) => (
            <EntityRow id={p.id} title={p.title} href={`${prefix}/patterns/${p.id}`} note={p.summary} />
          ))}
        </ul>
      </section>
    )}

    <p class="mt-12 pt-4 border-t border-hoba-border text-sm text-hoba-muted flex flex-wrap items-center gap-2">
      <span>{t('common.machineEndpoint')}</span>
      <a href={`/api/v1/artifacts/${artifact.id}.json`} target="_blank" class="text-hoba-accent underline underline-offset-2 font-mono">/api/v1/artifacts/{artifact.id}.json</a>
    </p>
  </div>
</Layout>
