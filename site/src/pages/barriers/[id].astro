---
import Layout from '../../layouts/Layout.astro';
import EntityBadge from '../../components/EntityBadge.astro';
import RemovabilityBadge from '../../components/RemovabilityBadge.astro';
import path from 'node:path';
import { loadRegistryFromDirectory, HOBAKnowledgeGraph } from '@hoba/registry';

export async function getStaticPaths() {
  const rootDir = path.resolve(process.cwd(), '..');
  const bundle = loadRegistryFromDirectory(path.join(rootDir, 'content'), path.join(rootDir, 'evidence'));
  return bundle.barriers.map((barrier) => ({
    params: { id: barrier.id },
    props: { barrier, bundle },
  }));
}

const { barrier, bundle } = Astro.props;
const graph = new HOBAKnowledgeGraph(bundle);
const operatingMechanisms = bundle.mechanisms.filter((m) =>
  m.operates_at.includes(barrier.id)
);
const precedingBarriers = bundle.barriers.filter((b) =>
  b.precedes.includes(barrier.id)
);
const succeedingBarriers = bundle.barriers.filter((b) =>
  barrier.precedes.includes(b.id)
);
const targetedInterventions = bundle.interventions.filter((i) =>
  i.targets.includes(barrier.id)
);
---
<Layout title={`${barrier.id} — ${barrier.title}`} activeNav="registry">
  <div class="max-w-4xl mx-auto space-y-8">
    <!-- Breadcrumbs -->
    <div class="text-xs font-mono text-hoba-muted flex items-center gap-2">
      <a href="/registry" class="hover:text-hoba-text">Registry</a>
      <span>/</span>
      <a href="/registry" class="hover:text-hoba-text">Barriers</a>
      <span>/</span>
      <span class="text-hoba-accent">{barrier.id}</span>
    </div>

    <!-- Header Section -->
    <div class="p-6 rounded-2xl border border-hoba-border bg-hoba-card">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <EntityBadge type="barrier" id={barrier.id} size="md" />
        <div class="flex items-center gap-2 text-xs font-mono text-hoba-muted">
          <span class="px-2 py-0.5 rounded bg-emerald-950/60 text-emerald-300 border border-emerald-800/60 uppercase">
            Stage: {barrier.stage}
          </span>
          <span>•</span>
          <span>Funnel Order: <strong class="text-hoba-text">#{barrier.order}</strong></span>
        </div>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black font-mono text-hoba-text">{barrier.title}</h1>
      <p class="text-sm text-hoba-muted mt-3 leading-relaxed">{barrier.description}</p>

      <div class="mt-4 p-3 rounded-lg border border-emerald-800/40 bg-emerald-950/20 text-xs font-mono text-emerald-200">
        <strong class="text-emerald-300">Passing Condition:</strong> {barrier.pass_condition}
      </div>
    </div>

    <!-- Funnel Ordering DAG Neighbors -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
      <div class="p-4 rounded-xl border border-hoba-border bg-hoba-card/50">
        <span class="text-hoba-muted font-bold uppercase">Preceded By (Inbound Gates):</span>
        <div class="mt-2 space-y-1">
          {precedingBarriers.length > 0 ? precedingBarriers.map((b) => (
            <a href={`/barriers/${b.id}`} class="block p-2 rounded bg-hoba-bg border border-hoba-border text-hoba-text hover:border-emerald-500/50">
              <span class="text-emerald-400 font-bold">{b.id}:</span> {b.title}
            </a>
          )) : <span class="text-hoba-muted italic">Initial funnel entrance gate</span>}
        </div>
      </div>

      <div class="p-4 rounded-xl border border-hoba-border bg-hoba-card/50">
        <span class="text-hoba-muted font-bold uppercase">Precedes (Outbound Gates):</span>
        <div class="mt-2 space-y-1">
          {succeedingBarriers.length > 0 ? succeedingBarriers.map((b) => (
            <a href={`/barriers/${b.id}`} class="block p-2 rounded bg-hoba-bg border border-hoba-border text-hoba-text hover:border-emerald-500/50">
              <span class="text-emerald-400 font-bold">{b.id}:</span> {b.title}
            </a>
          )) : <span class="text-hoba-muted italic">Terminal funnel gate</span>}
        </div>
      </div>
    </div>

    <!-- Operating Mechanisms -->
    <div class="p-6 rounded-xl border border-hoba-border bg-hoba-card">
      <h2 class="text-sm font-mono font-bold uppercase text-hoba-text mb-4">Mechanisms Operating at this Gate ({operatingMechanisms.length})</h2>
      <div class="space-y-2">
        {operatingMechanisms.map((m) => (
          <a href={`/mechanisms/${m.id}`} class="p-3 rounded-lg border border-hoba-border bg-hoba-bg hover:border-blue-500/50 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
            <div>
              <span class="font-mono font-bold text-blue-400">{m.id}:</span>
              <span class="font-semibold text-hoba-text ml-1">{m.title}</span>
              <p class="text-hoba-muted text-[11px] mt-0.5">{m.summary}</p>
            </div>
            <RemovabilityBadge removability={m.facets.removability} />
          </a>
        ))}
      </div>
    </div>

    <!-- Targeted Interventions -->
    {targetedInterventions.length > 0 && (
      <div class="p-6 rounded-xl border border-cyan-900/40 bg-cyan-950/20 text-xs">
        <h2 class="font-mono font-bold uppercase text-cyan-300 mb-3">System Interventions Targeting this Gate:</h2>
        <div class="space-y-2">
          {targetedInterventions.map((i) => (
            <a href={`/interventions/${i.id}`} class="p-3 rounded-lg bg-hoba-card border border-cyan-800/40 block hover:bg-hoba-hover">
              <span class="font-mono font-bold text-cyan-400">{i.id}:</span> <strong class="text-hoba-text">{i.title}</strong>
              <p class="text-hoba-muted mt-1">{i.summary}</p>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- JSON API -->
    <div class="p-4 rounded-lg border border-hoba-border bg-hoba-card flex items-center justify-between text-xs font-mono text-hoba-muted">
      <span>Machine-readable static endpoint:</span>
      <a href={`/api/v1/barriers/${barrier.id}.json`} target="_blank" class="text-hoba-accent hover:underline">/api/v1/barriers/{barrier.id}.json</a>
    </div>
  </div>
</Layout>
