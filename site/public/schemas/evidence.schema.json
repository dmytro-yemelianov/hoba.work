{
  "$ref": "#/definitions/Evidence",
  "definitions": {
    "Evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EVD-\\d{3}$"
        },
        "type": {
          "type": "string",
          "const": "evidence"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "kind": {
          "type": "string",
          "enum": [
            "primary",
            "research",
            "reporting",
            "survey",
            "anecdote",
            "illustrative"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "citation": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "period": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "kind",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}