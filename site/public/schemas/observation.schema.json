{
  "$id": "https://hoba.work/schemas/observation.schema.json",
  "$ref": "#/definitions/Observation",
  "definitions": {
    "Observation": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ],
          "default": "active"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(EVD-\\d{3}|evidence\\.[a-z0-9_]+)$"
          },
          "default": []
        },
        "content": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "id": {
          "type": "string",
          "pattern": "^(A-\\d{3}|obs\\.[a-z0-9_]+)$"
        },
        "type": {
          "type": "string",
          "const": "observation"
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pre-posting",
              "sourcing",
              "ingestion",
              "screening",
              "recruiter",
              "technical",
              "hiring-manager",
              "team",
              "client",
              "compensation",
              "offer",
              "post-offer"
            ]
          },
          "minItems": 1
        },
        "fidelity": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "direct",
                "euphemism",
                "distortion",
                "noise",
                "void"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "superseded_by": {
          "$ref": "#/definitions/Observation/properties/id"
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "observed",
            "compatible",
            "supported",
            "strongly_supported",
            "proven",
            "contradicted",
            "unknown"
          ],
          "default": "supported"
        },
        "probes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^PROBE-[A-Z0-9-]+$"
              },
              "action": {
                "type": "string",
                "minLength": 5
              },
              "expected_signal": {
                "type": "string",
                "minLength": 5
              },
              "cost": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "removability_target": {
                "type": "string",
                "enum": [
                  "candidate",
                  "intermediary",
                  "none"
                ]
              },
              "outcomes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 5
                    },
                    "excludes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^(M-\\d{3}|mech\\.[a-z0-9_]+)$"
                      },
                      "default": []
                    },
                    "because": {
                      "type": "string",
                      "default": ""
                    }
                  },
                  "required": [
                    "id",
                    "label"
                  ],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "id",
              "action",
              "expected_signal",
              "cost"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "specimens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "email",
                  "chat",
                  "ats",
                  "transcript",
                  "posting",
                  "note"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 3
              },
              "subject": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "speaker": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tell": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "reading": {
                "type": "string",
                "minLength": 10
              }
            },
            "required": [
              "kind",
              "label",
              "lines"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "perspectives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actor": {
                "type": "string",
                "enum": [
                  "actor.candidate",
                  "actor.recruiter",
                  "actor.hiring_manager",
                  "actor.ats_vendor",
                  "actor.employer_policy",
                  "actor.public_policy_and_industry_standards",
                  "actor.client"
                ]
              },
              "sees": {
                "type": "string",
                "minLength": 20
              },
              "reads": {
                "type": "string",
                "minLength": 20
              },
              "does": {
                "type": "string",
                "minLength": 20
              }
            },
            "required": [
              "actor",
              "sees",
              "reads",
              "does"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "non_inferences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "title",
        "id",
        "type",
        "summary",
        "stages",
        "non_inferences"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
