{
  "$id": "https://hoba.work/schemas/actor.schema.json",
  "$ref": "#/definitions/Actor",
  "definitions": {
    "Actor": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ],
          "default": "active"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(EVD-\\d{3}|evidence\\.[a-z0-9_]+)$"
          },
          "default": []
        },
        "content": {
          "type": "string"
        },
        "aliases": {
          "type": "object",
          "properties": {
            "facet": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "system",
                  "recruiter",
                  "hiring-manager",
                  "policy",
                  "external",
                  "candidate"
                ]
              },
              "default": []
            },
            "intervention": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "employer-policy",
                  "recruiter-process",
                  "ats-vendor",
                  "hiring-manager",
                  "candidate-action",
                  "industry-standard",
                  "policy"
                ]
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {
            "facet": [],
            "intervention": []
          }
        },
        "id": {
          "type": "string",
          "enum": [
            "actor.candidate",
            "actor.recruiter",
            "actor.hiring_manager",
            "actor.ats_vendor",
            "actor.employer_policy",
            "actor.public_policy_and_industry_standards",
            "actor.client"
          ]
        },
        "type": {
          "type": "string",
          "const": "actor"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "blind_to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "incentives": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "specimens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "email",
                  "chat",
                  "ats",
                  "transcript",
                  "posting",
                  "note"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 3
              },
              "subject": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "speaker": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tell": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "reading": {
                "type": "string",
                "minLength": 10
              }
            },
            "required": [
              "kind",
              "label",
              "lines"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 5
              },
              "rationale": {
                "type": "string",
                "minLength": 20
              },
              "cost": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "costs": {
                "type": "string",
                "minLength": 10
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "interventions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(I-\\d{3}|int\\.[a-z0-9_]+)$"
                },
                "default": []
              }
            },
            "required": [
              "id",
              "title",
              "rationale",
              "cost",
              "costs"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "title",
        "id",
        "type",
        "slug",
        "summary",
        "controls",
        "blind_to",
        "incentives"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
