{
  "$id": "https://hoba.work/schemas/mechanism.schema.json",
  "$ref": "#/definitions/Mechanism",
  "definitions": {
    "Mechanism": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ],
          "default": "active"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EVD-\\d{3}$"
          },
          "default": []
        },
        "content": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^M-\\d{3}$"
        },
        "type": {
          "type": "string",
          "const": "mechanism"
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "operates_at": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^B-\\d{3}$"
          },
          "minItems": 1
        },
        "emissions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact": {
                "type": "string",
                "pattern": "^A-\\d{3}$"
              },
              "fidelity": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "direct",
                      "euphemism",
                      "distortion",
                      "noise",
                      "void"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "likelihood": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Mechanism/properties/evidence_ids/items"
                },
                "default": []
              }
            },
            "required": [
              "artifact"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "facets": {
          "type": "object",
          "properties": {
            "actor": {
              "type": "string",
              "enum": [
                "system",
                "recruiter",
                "hiring-manager",
                "policy",
                "external",
                "candidate"
              ]
            },
            "nature": {
              "type": "string",
              "enum": [
                "rule",
                "incentive",
                "bias",
                "noise",
                "void"
              ]
            },
            "visibility": {
              "type": "string",
              "enum": [
                "observable",
                "inferable",
                "opaque"
              ]
            },
            "removability": {
              "type": "string",
              "enum": [
                "candidate",
                "intermediary",
                "none"
              ]
            }
          },
          "required": [
            "actor",
            "nature",
            "visibility",
            "removability"
          ],
          "additionalProperties": false
        },
        "amplifies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Mechanism/properties/id"
          },
          "default": []
        },
        "masks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Mechanism/properties/id"
          },
          "default": []
        },
        "superseded_by": {
          "$ref": "#/definitions/Mechanism/properties/id"
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "established",
            "supported",
            "hypothesis",
            "illustrative"
          ],
          "default": "supported"
        },
        "honest_baseline": {
          "type": "boolean",
          "default": false
        },
        "specimens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "email",
                  "chat",
                  "ats",
                  "transcript",
                  "posting",
                  "note"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 3
              },
              "subject": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "speaker": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tell": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "reading": {
                "type": "string",
                "minLength": 10
              }
            },
            "required": [
              "kind",
              "label",
              "lines"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "perspectives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actor": {
                "type": "string",
                "enum": [
                  "candidate",
                  "recruiter",
                  "hiring-manager",
                  "ats-vendor",
                  "employer-policy",
                  "public-policy"
                ]
              },
              "sees": {
                "type": "string",
                "minLength": 20
              },
              "reads": {
                "type": "string",
                "minLength": 20
              },
              "does": {
                "type": "string",
                "minLength": 20
              }
            },
            "required": [
              "actor",
              "sees",
              "reads",
              "does"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "non_inferences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "title",
        "id",
        "type",
        "summary",
        "operates_at",
        "facets",
        "non_inferences"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
