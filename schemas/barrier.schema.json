{
  "$id": "https://hoba.work/schemas/barrier.schema.json",
  "$ref": "#/definitions/Barrier",
  "definitions": {
    "Barrier": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ],
          "default": "active"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(EVD-\\d{3}|evidence\\.[a-z0-9_]+)$"
          },
          "default": []
        },
        "content": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "id": {
          "type": "string",
          "pattern": "^(B-\\d{3}|bar\\.[a-z0-9_]+)$"
        },
        "type": {
          "type": "string",
          "const": "barrier"
        },
        "stage": {
          "type": "string",
          "enum": [
            "pre-posting",
            "sourcing",
            "ingestion",
            "screening",
            "recruiter",
            "technical",
            "hiring-manager",
            "team",
            "client",
            "compensation",
            "offer",
            "post-offer"
          ]
        },
        "order": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "precedes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Barrier/properties/id"
          },
          "default": []
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "pass_condition": {
          "type": "string",
          "minLength": 5
        },
        "superseded_by": {
          "$ref": "#/definitions/Barrier/properties/id"
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "established",
            "supported",
            "hypothesis",
            "illustrative"
          ],
          "default": "established"
        },
        "specimens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "email",
                  "chat",
                  "ats",
                  "transcript",
                  "posting",
                  "note"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 3
              },
              "subject": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "speaker": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tell": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "reading": {
                "type": "string",
                "minLength": 10
              }
            },
            "required": [
              "kind",
              "label",
              "lines"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "perspectives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actor": {
                "type": "string",
                "enum": [
                  "candidate",
                  "recruiter",
                  "hiring-manager",
                  "ats-vendor",
                  "employer-policy",
                  "public-policy",
                  "client"
                ]
              },
              "sees": {
                "type": "string",
                "minLength": 20
              },
              "reads": {
                "type": "string",
                "minLength": 20
              },
              "does": {
                "type": "string",
                "minLength": 20
              }
            },
            "required": [
              "actor",
              "sees",
              "reads",
              "does"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "title",
        "id",
        "type",
        "stage",
        "order",
        "description",
        "pass_condition"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
