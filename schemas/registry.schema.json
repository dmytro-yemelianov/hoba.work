{
  "$id": "https://hoba.work/schemas/registry.schema.json",
  "$ref": "#/definitions/RegistryBundle",
  "definitions": {
    "RegistryBundle": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 3
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "deprecated"
                ],
                "default": "active"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^EVD-\\d{3}$"
                },
                "default": []
              },
              "content": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "enum": [
                  "candidate",
                  "recruiter",
                  "hiring-manager",
                  "ats-vendor",
                  "employer-policy",
                  "public-policy"
                ]
              },
              "type": {
                "type": "string",
                "const": "actor"
              },
              "summary": {
                "type": "string",
                "minLength": 10
              },
              "controls": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "blind_to": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "incentives": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "aliases": {
                "type": "object",
                "properties": {
                  "facet": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "system",
                        "recruiter",
                        "hiring-manager",
                        "policy",
                        "external",
                        "candidate"
                      ]
                    },
                    "default": []
                  },
                  "intervention": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "employer-policy",
                        "recruiter-process",
                        "ats-vendor",
                        "hiring-manager",
                        "candidate-action",
                        "industry-standard",
                        "policy"
                      ]
                    },
                    "default": []
                  }
                },
                "additionalProperties": false,
                "default": {
                  "facet": [],
                  "intervention": []
                }
              },
              "specimens": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "email",
                        "chat",
                        "ats",
                        "transcript",
                        "posting",
                        "note"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 3
                    },
                    "subject": {
                      "type": "string"
                    },
                    "context": {
                      "type": "string"
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "speaker": {
                            "type": "string"
                          },
                          "at": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "tell": {
                            "type": "boolean",
                            "default": false
                          }
                        },
                        "required": [
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    },
                    "reading": {
                      "type": "string",
                      "minLength": 10
                    }
                  },
                  "required": [
                    "kind",
                    "label",
                    "lines"
                  ],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "title",
              "id",
              "type",
              "summary",
              "controls",
              "blind_to",
              "incentives"
            ],
            "additionalProperties": false
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/title"
              },
              "status": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/status"
              },
              "evidence_ids": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/evidence_ids"
              },
              "content": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/content"
              },
              "id": {
                "type": "string",
                "pattern": "^WF-\\d{3}$"
              },
              "type": {
                "type": "string",
                "const": "workflow"
              },
              "summary": {
                "type": "string",
                "minLength": 10
              },
              "subject": {
                "type": "string",
                "minLength": 3
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 3
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "initial",
                        "active",
                        "terminal"
                      ],
                      "default": "active"
                    },
                    "owner": {
                      "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/id"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 10
                    },
                    "entities": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "default": []
                    },
                    "visible_to_candidate": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "owner",
                    "description"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2
              },
              "transitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 3
                    },
                    "owner": {
                      "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/id"
                    },
                    "guard": {
                      "type": "string",
                      "minLength": 5
                    },
                    "entities": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "default": []
                    }
                  },
                  "required": [
                    "from",
                    "to",
                    "label",
                    "owner",
                    "guard"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "specimens": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/specimens/items"
                },
                "default": []
              }
            },
            "required": [
              "title",
              "id",
              "type",
              "summary",
              "subject",
              "states",
              "transitions"
            ],
            "additionalProperties": false
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/title"
              },
              "status": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/status"
              },
              "evidence_ids": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/evidence_ids"
              },
              "content": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/content"
              },
              "id": {
                "type": "string",
                "pattern": "^A-\\d{3}$"
              },
              "type": {
                "type": "string",
                "const": "artifact"
              },
              "summary": {
                "type": "string",
                "minLength": 10
              },
              "stages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "pre-posting",
                    "sourcing",
                    "ingestion",
                    "screening",
                    "recruiter",
                    "technical",
                    "hiring-manager",
                    "team",
                    "compensation",
                    "offer",
                    "post-offer"
                  ]
                },
                "minItems": 1
              },
              "fidelity": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "direct",
                      "euphemism",
                      "distortion",
                      "noise",
                      "void"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "superseded_by": {
                "$ref": "#/definitions/RegistryBundle/properties/artifacts/items/properties/id"
              },
              "evidence_level": {
                "type": "string",
                "enum": [
                  "established",
                  "supported",
                  "hypothesis",
                  "illustrative"
                ],
                "default": "supported"
              },
              "probes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^PROBE-[A-Z0-9-]+$"
                    },
                    "action": {
                      "type": "string",
                      "minLength": 5
                    },
                    "expected_signal": {
                      "type": "string",
                      "minLength": 5
                    },
                    "cost": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high"
                      ]
                    },
                    "removability_target": {
                      "type": "string",
                      "enum": [
                        "candidate",
                        "intermediary",
                        "none"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "action",
                    "expected_signal",
                    "cost"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "specimens": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/specimens/items"
                },
                "default": []
              },
              "non_inferences": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "title",
              "id",
              "type",
              "summary",
              "stages",
              "non_inferences"
            ],
            "additionalProperties": false
          }
        },
        "barriers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/title"
              },
              "status": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/status"
              },
              "evidence_ids": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/evidence_ids"
              },
              "content": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/content"
              },
              "id": {
                "type": "string",
                "pattern": "^B-\\d{3}$"
              },
              "type": {
                "type": "string",
                "const": "barrier"
              },
              "stage": {
                "$ref": "#/definitions/RegistryBundle/properties/artifacts/items/properties/stages/items"
              },
              "order": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "precedes": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/barriers/items/properties/id"
                },
                "default": []
              },
              "description": {
                "type": "string",
                "minLength": 10
              },
              "pass_condition": {
                "type": "string",
                "minLength": 5
              },
              "superseded_by": {
                "$ref": "#/definitions/RegistryBundle/properties/barriers/items/properties/id"
              },
              "evidence_level": {
                "$ref": "#/definitions/RegistryBundle/properties/artifacts/items/properties/evidence_level",
                "default": "established"
              },
              "specimens": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/specimens/items"
                },
                "default": []
              }
            },
            "required": [
              "title",
              "id",
              "type",
              "stage",
              "order",
              "description",
              "pass_condition"
            ],
            "additionalProperties": false
          }
        },
        "mechanisms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/title"
              },
              "status": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/status"
              },
              "evidence_ids": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/evidence_ids"
              },
              "content": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/content"
              },
              "id": {
                "type": "string",
                "pattern": "^M-\\d{3}$"
              },
              "type": {
                "type": "string",
                "const": "mechanism"
              },
              "summary": {
                "type": "string",
                "minLength": 10
              },
              "operates_at": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/barriers/items/properties/id"
                },
                "minItems": 1
              },
              "emissions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "artifact": {
                      "$ref": "#/definitions/RegistryBundle/properties/artifacts/items/properties/id"
                    },
                    "fidelity": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/RegistryBundle/properties/artifacts/items/properties/fidelity/anyOf/0"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "likelihood": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "low",
                            "medium",
                            "high"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/evidence_ids/items"
                      },
                      "default": []
                    }
                  },
                  "required": [
                    "artifact"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "facets": {
                "type": "object",
                "properties": {
                  "actor": {
                    "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/aliases/properties/facet/items"
                  },
                  "nature": {
                    "type": "string",
                    "enum": [
                      "rule",
                      "incentive",
                      "bias",
                      "noise",
                      "void"
                    ]
                  },
                  "visibility": {
                    "type": "string",
                    "enum": [
                      "observable",
                      "inferable",
                      "opaque"
                    ]
                  },
                  "removability": {
                    "$ref": "#/definitions/RegistryBundle/properties/artifacts/items/properties/probes/items/properties/removability_target"
                  }
                },
                "required": [
                  "actor",
                  "nature",
                  "visibility",
                  "removability"
                ],
                "additionalProperties": false
              },
              "amplifies": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/mechanisms/items/properties/id"
                },
                "default": []
              },
              "masks": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/mechanisms/items/properties/id"
                },
                "default": []
              },
              "superseded_by": {
                "$ref": "#/definitions/RegistryBundle/properties/mechanisms/items/properties/id"
              },
              "evidence_level": {
                "$ref": "#/definitions/RegistryBundle/properties/artifacts/items/properties/evidence_level",
                "default": "supported"
              },
              "honest_baseline": {
                "type": "boolean",
                "default": false
              },
              "specimens": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/specimens/items"
                },
                "default": []
              },
              "non_inferences": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "title",
              "id",
              "type",
              "summary",
              "operates_at",
              "facets",
              "non_inferences"
            ],
            "additionalProperties": false
          }
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/title"
              },
              "status": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/status"
              },
              "evidence_ids": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/evidence_ids"
              },
              "content": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/content"
              },
              "id": {
                "type": "string",
                "pattern": "^P-\\d{3}$"
              },
              "type": {
                "type": "string",
                "const": "pattern"
              },
              "summary": {
                "type": "string",
                "minLength": 10
              },
              "required_artifacts": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/artifacts/items/properties/id"
                },
                "minItems": 1
              },
              "compatible_mechanisms": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/mechanisms/items/properties/id"
                },
                "minItems": 1
              },
              "trigger_rule": {
                "type": "string",
                "minLength": 10
              },
              "establishes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "non_inferences": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "interventions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^I-\\d{3}$"
                },
                "default": []
              },
              "superseded_by": {
                "$ref": "#/definitions/RegistryBundle/properties/patterns/items/properties/id"
              },
              "evidence_level": {
                "$ref": "#/definitions/RegistryBundle/properties/artifacts/items/properties/evidence_level",
                "default": "supported"
              },
              "specimens": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/specimens/items"
                },
                "default": []
              }
            },
            "required": [
              "title",
              "id",
              "type",
              "summary",
              "required_artifacts",
              "compatible_mechanisms",
              "trigger_rule",
              "establishes",
              "non_inferences"
            ],
            "additionalProperties": false
          }
        },
        "loops": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/title"
              },
              "status": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/status"
              },
              "evidence_ids": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/evidence_ids"
              },
              "content": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/content"
              },
              "id": {
                "type": "string",
                "pattern": "^L-\\d{3}$"
              },
              "type": {
                "type": "string",
                "const": "loop"
              },
              "summary": {
                "type": "string",
                "minLength": 10
              },
              "mechanisms": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/mechanisms/items/properties/id"
                },
                "minItems": 2
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "$ref": "#/definitions/RegistryBundle/properties/mechanisms/items/properties/id"
                    },
                    "to": {
                      "$ref": "#/definitions/RegistryBundle/properties/mechanisms/items/properties/id"
                    },
                    "relation": {
                      "type": "string",
                      "enum": [
                        "amplifies",
                        "masks"
                      ]
                    }
                  },
                  "required": [
                    "from",
                    "to",
                    "relation"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2
              },
              "entry_points": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/mechanisms/items/properties/id"
                },
                "minItems": 1
              },
              "interventions": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/patterns/items/properties/interventions/items"
                },
                "default": []
              },
              "superseded_by": {
                "$ref": "#/definitions/RegistryBundle/properties/loops/items/properties/id"
              },
              "evidence_level": {
                "$ref": "#/definitions/RegistryBundle/properties/artifacts/items/properties/evidence_level",
                "default": "supported"
              },
              "specimens": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/specimens/items"
                },
                "default": []
              }
            },
            "required": [
              "title",
              "id",
              "type",
              "summary",
              "mechanisms",
              "edges",
              "entry_points"
            ],
            "additionalProperties": false
          }
        },
        "interventions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/title"
              },
              "status": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/status"
              },
              "evidence_ids": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/evidence_ids"
              },
              "content": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/content"
              },
              "id": {
                "$ref": "#/definitions/RegistryBundle/properties/patterns/items/properties/interventions/items"
              },
              "type": {
                "type": "string",
                "const": "intervention"
              },
              "summary": {
                "type": "string",
                "minLength": 10
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[MBPL]-\\d{3}$"
                },
                "minItems": 1
              },
              "actor": {
                "$ref": "#/definitions/RegistryBundle/properties/actors/items/properties/aliases/properties/intervention/items"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "individual",
                  "team",
                  "organizational",
                  "industry",
                  "ecosystem"
                ]
              },
              "cost": {
                "$ref": "#/definitions/RegistryBundle/properties/artifacts/items/properties/probes/items/properties/cost"
              },
