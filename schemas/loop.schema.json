{
  "$id": "https://hoba.work/schemas/loop.schema.json",
  "$ref": "#/definitions/Loop",
  "definitions": {
    "Loop": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ],
          "default": "active"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EVD-\\d{3}$"
          },
          "default": []
        },
        "content": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^L-\\d{3}$"
        },
        "type": {
          "type": "string",
          "const": "loop"
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "mechanisms": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M-\\d{3}$"
          },
          "minItems": 2
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "$ref": "#/definitions/Loop/properties/mechanisms/items"
              },
              "to": {
                "$ref": "#/definitions/Loop/properties/mechanisms/items"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "amplifies",
                  "masks"
                ]
              }
            },
            "required": [
              "from",
              "to",
              "relation"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "entry_points": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Loop/properties/mechanisms/items"
          },
          "minItems": 1
        },
        "interventions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^I-\\d{3}$"
          },
          "default": []
        },
        "superseded_by": {
          "$ref": "#/definitions/Loop/properties/id"
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "established",
            "supported",
            "hypothesis",
            "illustrative"
          ],
          "default": "supported"
        },
        "specimens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "email",
                  "chat",
                  "ats",
                  "transcript",
                  "posting",
                  "note"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 3
              },
              "subject": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "speaker": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tell": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "reading": {
                "type": "string",
                "minLength": 10
              }
            },
            "required": [
              "kind",
              "label",
              "lines"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "title",
        "id",
        "type",
        "summary",
        "mechanisms",
        "edges",
        "entry_points"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
