{
  "$id": "https://hoba.work/schemas/era.schema.json",
  "$ref": "#/definitions/Era",
  "definitions": {
    "Era": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ],
          "default": "active"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EVD-\\d{3}$"
          },
          "default": []
        },
        "content": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^E-\\d{3}$"
        },
        "type": {
          "type": "string",
          "const": "era"
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "from": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "to": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "capital": {
          "type": "string",
          "minLength": 20
        },
        "hiring": {
          "type": "string",
          "minLength": 20
        },
        "entry": {
          "type": "string",
          "minLength": 20
        },
        "ended_by": {
          "type": "string",
          "default": ""
        },
        "indicators": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 3
              },
              "figure": {
                "type": "string",
                "minLength": 1
              },
              "period": {
                "type": "string",
                "minLength": 4
              },
              "evidence": {
                "$ref": "#/definitions/Era/properties/evidence_ids/items"
              }
            },
            "required": [
              "label",
              "figure",
              "period",
              "evidence"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "specimens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "email",
                  "chat",
                  "ats",
                  "transcript",
                  "posting",
                  "note"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 3
              },
              "subject": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "speaker": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tell": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "reading": {
                "type": "string",
                "minLength": 10
              }
            },
            "required": [
              "kind",
              "label",
              "lines"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "title",
        "id",
        "type",
        "summary",
        "from",
        "to",
        "capital",
        "hiring",
        "entry"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
