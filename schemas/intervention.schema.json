{
  "$id": "https://hoba.work/schemas/intervention.schema.json",
  "$ref": "#/definitions/Intervention",
  "definitions": {
    "Intervention": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ],
          "default": "active"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(EVD-\\d{3}|evidence\\.[a-z0-9_]+)$"
          },
          "default": []
        },
        "content": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "id": {
          "type": "string",
          "pattern": "^(I-\\d{3}|int\\.[a-z0-9_]+)$"
        },
        "type": {
          "type": "string",
          "const": "intervention"
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([MBPL]-\\d{3}|(mech|bar|pat|loop)\\.[a-z0-9_]+)$"
          },
          "minItems": 1
        },
        "actor": {
          "type": "string",
          "enum": [
            "employer-policy",
            "recruiter-process",
            "ats-vendor",
            "hiring-manager",
            "candidate-action",
            "industry-standard",
            "policy"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "individual",
            "team",
            "organizational",
            "industry",
            "ecosystem"
          ]
        },
        "cost": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "superseded_by": {
          "$ref": "#/definitions/Intervention/properties/id"
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "established",
            "supported",
            "hypothesis",
            "illustrative"
          ],
          "default": "supported"
        },
        "expected_effects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "specimens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "email",
                  "chat",
                  "ats",
                  "transcript",
                  "posting",
                  "note"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 3
              },
              "subject": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "speaker": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tell": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "reading": {
                "type": "string",
                "minLength": 10
              }
            },
            "required": [
              "kind",
              "label",
              "lines"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "perspectives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actor": {
                "type": "string",
                "enum": [
                  "actor.candidate",
                  "actor.recruiter",
                  "actor.hiring_manager",
                  "actor.ats_vendor",
                  "actor.employer_policy",
                  "actor.public_policy_and_industry_standards",
                  "actor.client"
                ]
              },
              "sees": {
                "type": "string",
                "minLength": 20
              },
              "reads": {
                "type": "string",
                "minLength": 20
              },
              "does": {
                "type": "string",
                "minLength": 20
              }
            },
            "required": [
              "actor",
              "sees",
              "reads",
              "does"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "title",
        "id",
        "type",
        "summary",
        "targets",
        "actor",
        "scope",
        "cost",
        "expected_effects",
        "measurements"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
