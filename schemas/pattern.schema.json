{
  "$id": "https://hoba.work/schemas/pattern.schema.json",
  "$ref": "#/definitions/Pattern",
  "definitions": {
    "Pattern": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ],
          "default": "active"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EVD-\\d{3}$"
          },
          "default": []
        },
        "content": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^P-\\d{3}$"
        },
        "type": {
          "type": "string",
          "const": "pattern"
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "required_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^A-\\d{3}$"
          },
          "minItems": 1
        },
        "compatible_mechanisms": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M-\\d{3}$"
          },
          "minItems": 1
        },
        "trigger_rule": {
          "type": "string",
          "minLength": 10
        },
        "establishes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "non_inferences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "interventions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^I-\\d{3}$"
          },
          "default": []
        },
        "superseded_by": {
          "$ref": "#/definitions/Pattern/properties/id"
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "established",
            "supported",
            "hypothesis",
            "illustrative"
          ],
          "default": "supported"
        },
        "specimens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "email",
                  "chat",
                  "ats",
                  "transcript",
                  "posting",
                  "note"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 3
              },
              "subject": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "speaker": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tell": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "reading": {
                "type": "string",
                "minLength": 10
              }
            },
            "required": [
              "kind",
              "label",
              "lines"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "title",
        "id",
        "type",
        "summary",
        "required_artifacts",
        "compatible_mechanisms",
        "trigger_rule",
        "establishes",
        "non_inferences"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
