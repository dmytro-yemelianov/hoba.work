{
  "$ref": "#/definitions/Artifact",
  "definitions": {
    "Artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HOBA-A-\\d{3}$"
        },
        "type": {
          "type": "string",
          "const": "artifact"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pre-posting",
              "sourcing",
              "ingestion",
              "screening",
              "recruiter",
              "technical",
              "team",
              "compensation",
              "offer",
              "post-offer"
            ]
          },
          "minItems": 1
        },
        "fidelity": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "direct",
                "euphemism",
                "distortion",
                "noise",
                "void"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ],
          "default": "active"
        },
        "superseded_by": {
          "type": "string",
          "pattern": "^HOBA-A-\\d{3}$"
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "established",
            "supported",
            "hypothesis",
            "illustrative"
          ],
          "default": "supported"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "probes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^PROBE-[A-Z0-9-]+$"
              },
              "action": {
                "type": "string",
                "minLength": 5
              },
              "expected_signal": {
                "type": "string",
                "minLength": 5
              },
              "cost": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "removability_target": {
                "type": "string",
                "enum": [
                  "candidate",
                  "intermediary",
                  "none"
                ]
              }
            },
            "required": [
              "id",
              "action",
              "expected_signal",
              "cost"
            ],
            "additionalProperties": false
          }
        },
        "non_inferences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "summary",
        "stages",
        "non_inferences"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}