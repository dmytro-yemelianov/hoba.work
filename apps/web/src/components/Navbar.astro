---
import Logo from './Logo.astro';
import LensSwitch from './LensSwitch.astro';
import { LANGS, LANG_LABELS, LANG_COOKIE, localePrefix, withLang, useTranslations, type Lang, interpolated} from '../i18n/utils';
import { getBundle } from '../lib/registry';

interface Props {
  lang?: Lang;
  active?: string;
}

const { lang = 'en', active = '' } = Astro.props;
const t = useTranslations(lang);
const prefix = localePrefix(lang);

// Five things on the bar: the way in, and four groups. Eight flat links plus an
// overflow menu made the bar a list of words with no shape — a reader could not
// tell that the graph and the registry are the same material seen twice, or
// that the API and the aggregates are one concern.
const item = (key: string, path: string) => ({ key, name: t(interpolated(`nav.${key}`)), href: `${prefix}${path}`, desc: t(interpolated(`nav.desc.${key}`)) });

const groups = [
  {
    id: 'atlas',
    name: t('nav.group.atlas'),
    items: [item('registry', '/registry'), item('patterns', '/patterns'), item('graph', '/graph'), item('actors', '/actors'), item('eras', '/eras')],
  },
  {
    id: 'process',
    name: t('nav.group.process'),
    items: [item('process', '/process'), item('check', '/check')],
  },
  {
    id: 'data',
    name: t('nav.group.data'),
    items: [item('data', '/data'), item('developers', '/developers')],
  },
  {
    id: 'project',
    name: t('nav.group.project'),
    items: [item('methodology', '/methodology'), item('contribute', '/contribute'), item('about', '/about'), item('cats', '/cats')],
  },
];
const analyze = item('analyze', '/analyze');
const activeGroup = (group: (typeof groups)[number]) => group.items.some((i) => i.key === active);
const actors = getBundle(lang).actors;

// One URL per page: switching language is a query on the page you are already
// on, never a different address. `?lang=` is the explicit, shareable override;
// the click handler also writes the cookie the worker honours, so ordinary
// internal links stay bare and the language survives the next navigation.
const switchLinks = LANGS.map((l) => ({ lang: l, label: LANG_LABELS[l], href: withLang(Astro.url, l) }));
---
<header class="sticky top-0 z-50 w-full relative border-b border-hoba-border bg-hoba-bg/95 backdrop-blur supports-[backdrop-filter]:bg-hoba-bg/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center gap-3">
    <a href={prefix || '/'} class="shrink-0 rounded-md hover:opacity-90 transition-opacity" aria-label="hoba">
      <Logo />
    </a>

    <nav class="hidden lg:flex items-center gap-0.5 ml-4" aria-label="Primary">
      <a
        href={analyze.href}
        class={`nav-link ${active === analyze.key ? 'nav-link-active' : 'text-hoba-accent'}`}
        aria-current={active === analyze.key ? 'page' : undefined}
      >
        {analyze.name}
      </a>

      {groups.map((group) => (
        <details class="nav-group relative">
          <summary class={`nav-link list-none cursor-pointer inline-flex items-center gap-1 ${activeGroup(group) ? 'nav-link-active' : ''}`}>
            <span>{group.name}</span>
            <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="nav-panel">
            {group.items.map((entry) => (
              <a href={entry.href} class={`nav-entry ${active === entry.key ? 'is-active' : ''}`} aria-current={active === entry.key ? 'page' : undefined}>
                <span class="nav-entry-name">{entry.name}</span>
                <span class="nav-entry-desc">{entry.desc}</span>
              </a>
            ))}
          </div>
        </details>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1 sm:gap-2">
      <!-- Language switch (sets the preference cookie the edge worker honours) -->
      <div class="flex items-center text-xs bg-hoba-card border border-hoba-border rounded-md p-0.5" role="group" aria-label={t('nav.language')}>
        {switchLinks.map((s) => (
          <a
            href={s.href}
            hreflang={s.lang}
            lang={s.lang}
            data-lang-switch={s.lang}
            aria-current={s.lang === lang ? 'true' : undefined}
            class={`px-2 py-1 rounded transition-colors ${s.lang === lang ? 'bg-hoba-border text-hoba-text font-semibold' : 'text-hoba-muted hover:text-hoba-text'}`}
          >
            {s.label}
          </a>
        ))}
      </div>

      <div class="hidden lg:block"><LensSwitch lang={lang} actors={actors} /></div>

      <button id="theme-toggle" type="button" class="icon-btn" aria-label={t('nav.theme')} title={t('nav.theme')}>
        <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/></svg>
      </button>

      <a href="https://github.com/dmytro-yemelianov/hoba.work" target="_blank" rel="noopener noreferrer" class="icon-btn hidden sm:inline-flex" aria-label={t('nav.github')}>
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <!-- Mobile drawer. <details> so it opens with JavaScript disabled; the
           script below only adds Escape, scroll locking and outside clicks. -->
      <details id="mobile-nav" class="lg:hidden">
        <summary class="icon-btn list-none cursor-pointer" aria-label={t('nav.menu')}>
          <svg class="w-5 h-5 nav-open" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg class="w-5 h-5 nav-close hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
        </summary>
        <div class="nav-drawer">
          <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-4" aria-label="Primary (mobile)">
            <a href={analyze.href} class={`nav-link-mobile ${active === analyze.key ? 'nav-link-active' : 'text-hoba-accent'}`} aria-current={active === analyze.key ? 'page' : undefined}>{analyze.name}</a>

            {groups.map((group) => (
              <>
                <p class="kicker px-3 mt-5">{group.name}</p>
                <div class="mt-1 flex flex-col">
                  {group.items.map((entry) => (
                    <a href={entry.href} class={`nav-link-mobile ${active === entry.key ? 'nav-link-active' : ''}`} aria-current={active === entry.key ? 'page' : undefined}>{entry.name}</a>
                  ))}
                </div>
              </>
            ))}
            <p class="kicker px-3 mt-5">{t('lens.label')}</p>
            <div class="mt-1 flex flex-col gap-0.5 px-1">
              <button type="button" class="lens-option" data-lens="" aria-pressed="true">{t('lens.none')}</button>
              {actors.map((actor) => (
                <button type="button" class="lens-option" data-lens={actor.slug} aria-pressed="false">
                  <span class="text-hoba-text">{actor.title}</span>
                </button>
              ))}
            </div>
            <a href="https://github.com/dmytro-yemelianov/hoba.work" target="_blank" rel="noopener noreferrer" class="nav-link-mobile mt-5 sm:hidden">{t('nav.github')}</a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script define:vars={{ LANG_COOKIE }}>
  document.querySelectorAll('[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', () => {
      document.cookie = `${LANG_COOKIE}=${a.dataset.langSwitch}; path=/; max-age=31536000; samesite=lax`;
    });
  });

  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const dark = !document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark', dark);
    try { localStorage.setItem('hoba_theme', dark ? 'dark' : 'light'); } catch {}
    window.dispatchEvent(new CustomEvent('hoba:theme', { detail: { dark } }));
  });

  const drawer = document.getElementById('mobile-nav');
  const groups = [...document.querySelectorAll('.nav-group')];
  const close = (el) => el && el.removeAttribute('open');

  drawer?.addEventListener('toggle', () => {
    const open = drawer.hasAttribute('open');
    document.body.classList.toggle('overflow-hidden', open);
    drawer.querySelector('.nav-open')?.classList.toggle('hidden', open);
    drawer.querySelector('.nav-close')?.classList.toggle('hidden', !open);
    if (open) groups.forEach(close);
  });

  for (const group of groups) {
    group.addEventListener('toggle', () => {
      if (group.hasAttribute('open')) groups.filter((g) => g !== group).forEach(close);
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    close(drawer);
    groups.forEach(close);
  });

  document.addEventListener('click', (event) => {
    for (const group of groups) {
      if (group.hasAttribute('open') && !group.contains(event.target)) close(group);
    }
    if (drawer?.hasAttribute('open') && event.target.closest('.nav-drawer a')) close(drawer);
  });
</script>
