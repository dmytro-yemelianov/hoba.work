---
import { useTranslations, type Lang } from '../i18n/utils';

type EntityType = 'observation' | 'barrier' | 'mechanism' | 'pattern' | 'loop' | 'intervention' | 'evidence';
interface Props {
  type: EntityType;
  id?: string;
  lang?: Lang;
}

const { type, id, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---
<span class="pill">
  <span class="dot" style={`background-color: rgb(var(--g-${type}))`} aria-hidden="true"></span>
  <span>{t(`entity.${type}`)}</span>
  {id && <span class="font-mono text-hoba-muted break-all whitespace-normal">{id}</span>}
</span>
