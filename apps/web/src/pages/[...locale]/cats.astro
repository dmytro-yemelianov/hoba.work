---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import {
  generateDNA,
  renderCatSVG,
  CAT_PRESETS,
  POSES,
  HEAD_SHAPES,
  EAR_TYPES,
  EYE_SHAPES,
  EYE_COLORS,
  MOUTH_EMOTIONS,
  COAT_STYLES,
  FUR_PATTERNS,
  TAIL_TYPES,
  HEAD_ACCESSORIES,
  NECK_ACCESSORIES,
  PROP_ITEMS,
  BACKDROP_THEMES,
} from '../../lib/cat-engine';
import { localeFromParams, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);

const initialSeed = 'borys-loaf-master';
const initialDNA = generateDNA(initialSeed);
const initialSVG = renderCatSVG(initialDNA, { width: 440, height: 440, idPrefix: 'cat-main' });
---

<Layout
  lang={lang}
  title={`${t('cats.title')} · hoba`}
  activeNav="cats"
>
  <div class="cats-page max-w-6xl mx-auto px-4 py-8">
    <PageHeader
      kicker={t('cats.kicker')}
      title={t('cats.title')}
      lead={t('cats.intro')}
    />

    <!-- Main Studio Workspace -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
      <!-- Left Column: Visual Stage -->
      <div class="lg:col-span-6 flex flex-col items-center">
        <div class="cat-stage-container w-full rounded-2xl border border-slate-700/60 bg-slate-900/95 p-6 flex flex-col items-center shadow-2xl relative backdrop-blur-md overflow-hidden">
          <!-- Ambient Glow Background -->
          <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/10 via-purple-500/10 to-pink-500/10 pointer-events-none"></div>

          <!-- Top Cat Identity Badge -->
          <div class="w-full flex items-center justify-between z-10 mb-4 pb-3 border-b border-slate-800">
            <div>
              <h2 id="cat-display-name" class="text-2xl font-bold text-slate-100 tracking-tight flex items-center gap-2">
                <span>{initialDNA.name}</span>
                <span class="text-xs px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 font-mono font-normal">v1.0</span>
              </h2>
              <p id="cat-display-title" class="text-sm text-cyan-400 font-medium">{initialDNA.title}</p>
            </div>
            <div class="flex items-center gap-2">
              <button
                id="randomize-btn"
                type="button"
                class="px-4 py-2 bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white text-sm font-semibold rounded-xl shadow-lg transition-all transform active:scale-95 flex items-center gap-2 cursor-pointer"
                title="Press Space or R to randomize"
              >
                <span>🎲</span>
                <span>{t('cats.btn.random')}</span>
              </button>
            </div>
          </div>

          <!-- Interactive SVG Stage Viewport -->
          <div id="cat-svg-viewport" class="w-full max-w-[420px] aspect-square flex items-center justify-center relative z-10 transition-transform duration-300">
            <Fragment set:html={initialSVG} />
          </div>

          <!-- Seed input & Direct share -->
          <div class="w-full mt-4 pt-3 border-t border-slate-800 flex flex-col sm:flex-row items-center gap-3 z-10">
            <div class="flex-1 w-full relative">
              <label for="cat-seed-input" class="sr-only">{t('cats.seedLabel')}</label>
              <input
                id="cat-seed-input"
                type="text"
                value={initialSeed}
                placeholder={t('cats.customSeed')}
                class="w-full bg-slate-950/80 border border-slate-700 text-slate-200 text-sm rounded-lg px-3 py-2 font-mono focus:outline-none focus:border-cyan-400"
              />
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
              <button
                id="copy-seed-btn"
                type="button"
                class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-semibold rounded-lg border border-slate-700 transition-colors flex items-center gap-1 cursor-pointer flex-1 sm:flex-initial justify-center"
              >
                <span>🔗</span>
                <span class="btn-text">{t('cats.btn.copySeed')}</span>
              </button>
            </div>
          </div>

          <!-- Export Action Buttons -->
          <div class="w-full mt-4 flex flex-wrap items-center justify-center gap-2 z-10">
            <button
              id="export-svg-btn"
              type="button"
              class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-cyan-300 hover:text-cyan-200 text-xs font-bold rounded-lg border border-cyan-500/30 transition-all flex items-center gap-1.5 cursor-pointer"
            >
              <span>📥</span>
              <span>{t('cats.btn.exportSvg')}</span>
            </button>
            <button
              id="export-png-btn"
              type="button"
              class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-emerald-300 hover:text-emerald-200 text-xs font-bold rounded-lg border border-emerald-500/30 transition-all flex items-center gap-1.5 cursor-pointer"
            >
              <span>🖼️</span>
              <span>{t('cats.btn.exportPng')}</span>
            </button>
            <button
              id="copy-svg-btn"
              type="button"
              class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-purple-300 hover:text-purple-200 text-xs font-bold rounded-lg border border-purple-500/30 transition-all flex items-center gap-1.5 cursor-pointer"
            >
              <span>📋</span>
              <span class="btn-text">{t('cats.btn.copySvg')}</span>
            </button>
          </div>
        </div>

        <p class="text-xs text-hoba-muted mt-3 text-center">
          ✨ {t('cats.combinatorics')} · 100% Vector SVG
        </p>
      </div>

      <!-- Right Column: Interactive Parameter Tabs -->
      <div class="lg:col-span-6 flex flex-col">
        <div class="rounded-2xl border border-slate-700/60 bg-slate-900/95 p-6 flex flex-col shadow-xl backdrop-blur-md">
          <!-- Parameter Tabs Header -->
          <div class="flex items-center gap-1 border-b border-slate-800 pb-3 overflow-x-auto no-scrollbar" role="tablist">
            <button class="cat-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer bg-cyan-500 text-slate-900" data-tab="pose" role="tab" aria-selected="true">
              {t('cats.tab.pose')}
            </button>
            <button class="cat-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer text-slate-300 hover:text-white hover:bg-slate-800" data-tab="head" role="tab" aria-selected="false">
              {t('cats.tab.head')}
            </button>
            <button class="cat-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer text-slate-300 hover:text-white hover:bg-slate-800" data-tab="face" role="tab" aria-selected="false">
              {t('cats.tab.face')}
            </button>
            <button class="cat-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer text-slate-300 hover:text-white hover:bg-slate-800" data-tab="coat" role="tab" aria-selected="false">
              {t('cats.tab.coat')}
            </button>
            <button class="cat-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer text-slate-300 hover:text-white hover:bg-slate-800" data-tab="acc" role="tab" aria-selected="false">
              {t('cats.tab.acc')}
            </button>
            <button class="cat-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer text-slate-300 hover:text-white hover:bg-slate-800" data-tab="backdrop" role="tab" aria-selected="false">
              {t('cats.tab.backdrop')}
            </button>
          </div>

          <!-- Tab 1: Pose & Body -->
          <div id="tab-pane-pose" class="tab-pane pt-5 flex flex-col gap-4">
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Поза та форма тіла (Pose)</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                {POSES.map((pose) => (
                  <button
                    type="button"
                    class="param-choice-btn p-2.5 rounded-xl border text-xs font-medium text-center transition-all cursor-pointer flex flex-col items-center gap-1.5 border-slate-700 bg-slate-950/60 text-slate-300 hover:border-cyan-500 hover:text-white"
                    data-param="pose"
                    data-value={pose}
                  >
                    <span class="text-lg">
                      {pose === 'loaf' ? '🍞' : pose === 'sitting' ? '🐈' : pose === 'stretching' ? '🧘' : pose === 'chilling' ? '🛋️' : pose === 'pounce' ? '🐾' : pose === 'orb' ? '⚪' : pose === 'longcat' ? '🥖' : '📦'}
                    </span>
                    <span class="capitalize">{pose}</span>
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Хвіст (Tail)</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                {TAIL_TYPES.map((tail) => (
                  <button
                    type="button"
                    class="param-choice-btn p-2 rounded-lg border text-xs font-medium text-center transition-all cursor-pointer border-slate-700 bg-slate-950/60 text-slate-300 hover:border-cyan-500 hover:text-white"
                    data-param="tailType"
                    data-value={tail}
                  >
                    <span class="capitalize">{tail}</span>
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label for="slider-chonk" class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Ступінь пухнастості / пузика (Chonk Factor)</label>
              <input id="slider-chonk" type="range" min="0.85" max="1.3" step="0.05" value={initialDNA.chonkFactor} class="w-full accent-cyan-500" />
            </div>
          </div>

          <!-- Tab 2: Head & Ears -->
          <div id="tab-pane-head" class="tab-pane pt-5 flex flex-col gap-4 hidden">
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Форма голови (Head Shape)</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                {HEAD_SHAPES.map((hs) => (
                  <button
                    type="button"
                    class="param-choice-btn p-2 rounded-lg border text-xs font-medium text-center transition-all cursor-pointer border-slate-700 bg-slate-950/60 text-slate-300 hover:border-cyan-500 hover:text-white"
                    data-param="headShape"
                    data-value={hs}
                  >
                    <span class="capitalize">{hs}</span>
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Тип вушок (Ear Style)</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                {EAR_TYPES.map((ear) => (
                  <button
                    type="button"
                    class="param-choice-btn p-2 rounded-lg border text-xs font-medium text-center transition-all cursor-pointer border-slate-700 bg-slate-950/60 text-slate-300 hover:border-cyan-500 hover:text-white"
                    data-param="earType"
                    data-value={ear}
                  >
                    <span class="capitalize">{ear}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>

          <!-- Tab 3: Eyes & Emotion -->
          <div id="tab-pane-face" class="tab-pane pt-5 flex flex-col gap-4 hidden">
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Погляд та очі (Eye Expression)</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                {EYE_SHAPES.map((eye) => (
                  <button
                    type="button"
                    class="param-choice-btn p-2.5 rounded-xl border text-xs font-medium text-center transition-all cursor-pointer flex flex-col items-center gap-1 border-slate-700 bg-slate-950/60 text-slate-300 hover:border-cyan-500 hover:text-white"
                    data-param="eyeShape"
                    data-value={eye}
                  >
                    <span class="text-base">
                      {eye === 'animeSparkle' ? '✨' : eye === 'curvedHappy' ? '^_^' : eye === 'sleepyLids' ? '¬_¬' : eye === 'shockedRound' ? 'O_O' : eye === 'wink' ? ';_o' : eye === 'derpCross' ? 'o_O' : '😼'}
                    </span>
                    <span class="capitalize">{eye}</span>
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Колір очей (Eye Color)</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                {EYE_COLORS.map((col) => (
                  <button
                    type="button"
                    class="param-choice-btn p-2 rounded-lg border text-xs font-medium text-center transition-all cursor-pointer border-slate-700 bg-slate-950/60 text-slate-300 hover:border-cyan-500 hover:text-white"
                    data-param="eyeColor"
                    data-value={col}
                  >
                    <span class="capitalize">{col}</span>
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Ротик та емоція (Mouth & Emotion)</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                {MOUTH_EMOTIONS.map((m) => (
                  <button
                    type="button"
                    class="param-choice-btn p-2 rounded-lg border text-xs font-medium text-center transition-all cursor-pointer border-slate-700 bg-slate-950/60 text-slate-300 hover:border-cyan-500 hover:text-white"
                    data-param="mouthEmotion"
                    data-value={m}
                  >
                    <span class="capitalize">{m}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>

          <!-- Tab 4: Coat & Fur Patterns -->
          <div id="tab-pane-coat" class="tab-pane pt-5 flex flex-col gap-4 hidden">
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Забарвлення шерсті (Coat Palette)</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                {COAT_STYLES.map((coat) => (
                  <button
                    type="button"
                    class="param-choice-btn p-2.5 rounded-xl border text-xs font-medium text-center transition-all cursor-pointer border-slate-700 bg-slate-950/60 text-slate-300 hover:border-cyan-500 hover:text-white"
                    data-param="coatStyle"
                    data-value={coat}
                  >
                    <span class="capitalize">{coat}</span>
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Візерунки на шерсті (Patterns)</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                {FUR_PATTERNS.map((pat) => (
                  <button
                    type="button"
                    class="param-choice-btn p-2 rounded-lg border text-xs font-medium text-center transition-all cursor-pointer border-slate-700 bg-slate-950/60 text-slate-300 hover:border-cyan-500 hover:text-white"
                    data-param="furPattern"
                    data-value={pat}
                  >
                    <span class="capitalize">{pat}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>

          <!-- Tab 5: Accessories -->
          <div id="tab-pane-acc" class="tab-pane pt-5 flex flex-col gap-4 hidden">
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Головні убори (Head Accessories)</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                {HEAD_ACCESSORIES.map((hAcc) => (
                  <button
                    type="button"
                    class="param-choice-btn p-2 rounded-lg border text-xs font-medium text-center transition-all cursor-pointer border-slate-700 bg-slate-950/60 text-slate-300 hover:border-cyan-500 hover:text-white"
                    data-param="headAccessory"
                    data-value={hAcc}
                  >
                    <span class="capitalize">{hAcc}</span>
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Нашийники та бантики (Neck Accessories)</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                {NECK_ACCESSORIES.map((nAcc) => (
                  <button
                    type="button"
                    class="param-choice-btn p-2 rounded-lg border text-xs font-medium text-center transition-all cursor-pointer border-slate-700 bg-slate-950/60 text-slate-300 hover:border-cyan-500 hover:text-white"
                    data-param="neckAccessory"
                    data-value={nAcc}
                  >
                    <span class="capitalize">{nAcc}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>

          <!-- Tab 6: Backdrop & Props -->
          <div id="tab-pane-backdrop" class="tab-pane pt-5 flex flex-col gap-4 hidden">
            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Тема фону (Backdrop)</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                {BACKDROP_THEMES.map((bd) => (
                  <button
                    type="button"
                    class="param-choice-btn p-2 rounded-lg border text-xs font-medium text-center transition-all cursor-pointer border-slate-700 bg-slate-950/60 text-slate-300 hover:border-cyan-500 hover:text-white"
                    data-param="backdropTheme"
                    data-value={bd}
                  >
                    <span class="capitalize">{bd}</span>
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Додатковий предмет (Prop Item)</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                {PROP_ITEMS.map((prop) => (
                  <button
                    type="button"
                    class="param-choice-btn p-2 rounded-lg border text-xs font-medium text-center transition-all cursor-pointer border-slate-700 bg-slate-950/60 text-slate-300 hover:border-cyan-500 hover:text-white"
                    data-param="propItem"
                    data-value={prop}
                  >
                    <span class="capitalize">{prop}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Presets Gallery (Hall of Fame) -->
    <section class="mt-12">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-bold text-hoba-text flex items-center gap-2">
            <span>🏆</span>
            <span>{t('cats.hallOfFame')}</span>
          </h2>
          <p class="text-xs text-hoba-muted mt-1">Оберіть готовий кураторський архетип для швидкого старту</p>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {CAT_PRESETS.map((preset) => {
          const pDNA = { ...generateDNA(preset.dna.seed), ...preset.dna };
          const pSVG = renderCatSVG(pDNA, { width: 140, height: 140, idPrefix: `preset-${preset.id}` });
          return (
            <button
              type="button"
              class="preset-card p-4 rounded-xl border border-slate-700/60 bg-slate-900/90 hover:bg-slate-800 hover:border-cyan-500/80 transition-all flex flex-col items-center text-center cursor-pointer group shadow-md"
              data-seed={preset.dna.seed}
            >
              <div class="w-24 h-24 flex items-center justify-center group-hover:scale-105 transition-transform">
                <Fragment set:html={pSVG} />
              </div>
              <h3 class="text-sm font-bold text-slate-200 mt-2 group-hover:text-cyan-400 transition-colors">
                {preset.name[lang]}
              </h3>
              <p class="text-xs text-slate-400 mt-0.5 line-clamp-1">
                {preset.title[lang]}
              </p>
            </button>
          );
        })}
      </div>
    </section>

    <!-- Cat Clan / Army Infinite Generator -->
    <section class="mt-12 pt-8 border-t border-slate-800">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl font-bold text-hoba-text flex items-center gap-2">
            <span>🐾</span>
            <span>{t('cats.armyTitle')}</span>
          </h2>
          <p class="text-xs text-hoba-muted mt-1">Генерація випадкових котячих варіацій у реальному часі</p>
        </div>
        <button
          id="generate-army-btn"
          type="button"
          class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-cyan-300 text-xs font-bold rounded-xl border border-slate-700 transition-all cursor-pointer flex items-center gap-1.5"
        >
          <span>⚡</span>
          <span>Перегенерувати зграю</span>
        </button>
      </div>

      <div id="cat-army-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        <!-- Injected via client script -->
      </div>
    </section>
  </div>
</Layout>

<script>
  import {
    generateDNA,
    renderCatSVG,
    randomSeed,
    type CatDNA,
  } from '../../lib/cat-engine';

  let currentDNA: CatDNA = generateDNA('borys-loaf-master');

  const viewport = document.getElementById('cat-svg-viewport');
  const nameEl = document.getElementById('cat-display-name');
  const titleEl = document.getElementById('cat-display-title');
  const seedInput = document.getElementById('cat-seed-input') as HTMLInputElement | null;
  const randomizeBtn = document.getElementById('randomize-btn');
  const copySeedBtn = document.getElementById('copy-seed-btn');
  const exportSvgBtn = document.getElementById('export-svg-btn');
  const exportPngBtn = document.getElementById('export-png-btn');
  const copySvgBtn = document.getElementById('copy-svg-btn');
  const armyGrid = document.getElementById('cat-army-grid');
  const generateArmyBtn = document.getElementById('generate-army-btn');

  function updateStudio(dna: CatDNA) {
    currentDNA = dna;
    if (viewport) {
      viewport.innerHTML = renderCatSVG(dna, { width: 440, height: 440, idPrefix: 'cat-main' });
    }
    if (nameEl) {
      nameEl.innerHTML = `<span>${dna.name ?? 'Кіт'}</span><span class="text-xs px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 font-mono font-normal">v1.0</span>`;
    }
    if (titleEl) {
      titleEl.textContent = dna.title ?? '';
    }
    if (seedInput) {
      seedInput.value = dna.seed;
    }
    highlightActiveButtons(dna);
    try {
      window.history.replaceState(null, '', `#seed=${encodeURIComponent(dna.seed)}`);
    } catch {
      // Ignore in restricted environments
    }
  }

  function highlightActiveButtons(dna: CatDNA) {
    document.querySelectorAll('.param-choice-btn').forEach((btn) => {
      const param = btn.getAttribute('data-param') as keyof CatDNA | null;
      const val = btn.getAttribute('data-value');
      if (param && val && dna[param] === val) {
        btn.classList.add('border-cyan-500', 'bg-cyan-950/40', 'text-cyan-300');
        btn.classList.remove('border-slate-700', 'bg-slate-950/60', 'text-slate-300');
      } else {
        btn.classList.remove('border-cyan-500', 'bg-cyan-950/40', 'text-cyan-300');
        btn.classList.add('border-slate-700', 'bg-slate-950/60', 'text-slate-300');
      }
    });
  }

  // 1. Randomize button & Hotkeys
  function triggerRandomize() {
    const seed = randomSeed();
    const dna = generateDNA(seed);
    updateStudio(dna);
  }

  randomizeBtn?.addEventListener('click', triggerRandomize);
  window.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    if (e.key === ' ' || e.key === 'r' || e.key === 'R') {
      e.preventDefault();
      triggerRandomize();
    }
  });

  // 2. Custom seed input
  seedInput?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value.trim();
    if (val) {
      const dna = generateDNA(val);
      updateStudio(dna);
    }
  });

  // 3. Tab switching
  document.querySelectorAll('.cat-tab-btn').forEach((tabBtn) => {
    tabBtn.addEventListener('click', () => {
      const tab = tabBtn.getAttribute('data-tab');
      document.querySelectorAll('.cat-tab-btn').forEach((b) => {
        b.classList.remove('bg-cyan-500', 'text-slate-900');
        b.classList.add('text-hoba-muted');
        b.setAttribute('aria-selected', 'false');
      });
      tabBtn.classList.add('bg-cyan-500', 'text-slate-900');
      tabBtn.classList.remove('text-hoba-muted');
      tabBtn.setAttribute('aria-selected', 'true');

      document.querySelectorAll('.tab-pane').forEach((pane) => pane.classList.add('hidden'));
      const targetPane = document.getElementById(`tab-pane-${tab}`);
      targetPane?.classList.remove('hidden');
    });
  });

  // 4. Parameter overrides buttons
  document.querySelectorAll('.param-choice-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const param = btn.getAttribute('data-param') as keyof CatDNA | null;
      const val = btn.getAttribute('data-value');
      if (param && val) {
        const nextDNA = { ...currentDNA, [param]: val };
        updateStudio(nextDNA);
      }
    });
  });

  // 5. Chonk slider
  const chonkSlider = document.getElementById('slider-chonk') as HTMLInputElement | null;
  chonkSlider?.addEventListener('input', (e) => {
    const val = parseFloat((e.target as HTMLInputElement).value);
    const nextDNA = { ...currentDNA, chonkFactor: val };
    updateStudio(nextDNA);
  });

  // 6. Presets clicks
  document.querySelectorAll('.preset-card').forEach((card) => {
    card.addEventListener('click', () => {
      const seed = card.getAttribute('data-seed');
      if (seed) {
        const dna = generateDNA(seed);
        updateStudio(dna);
        window.scrollTo({ top: 120, behavior: 'smooth' });
      }
    });
  });

  // 7. Copy Seed & URL
  copySeedBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    await navigator.clipboard.writeText(url);
    const label = copySeedBtn.querySelector('.btn-text');
    if (label) {
      const orig = label.textContent;
      label.textContent = '✓ Скопійовано!';
      setTimeout(() => (label.textContent = orig), 2000);
    }
  });

  // 8. Export SVG
  exportSvgBtn?.addEventListener('click', () => {
    const svgStr = renderCatSVG(currentDNA, { width: 1024, height: 1024 });
    const blob = new Blob([svgStr], { type: 'image/svg+xml;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `hoba-cat-${currentDNA.seed}.svg`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // 9. Export PNG
  exportPngBtn?.addEventListener('click', () => {
    const svgStr = renderCatSVG(currentDNA, { width: 1024, height: 1024 });
    const img = new Image();
    const svgBlob = new Blob([svgStr], { type: 'image/svg+xml;charset=utf-8' });
    const url = URL.createObjectURL(svgBlob);
    img.onload = () => {
      const canvas = document.createElement('canvas');
      canvas.width = 1024;
      canvas.height = 1024;
      const ctx = canvas.getContext('2d');
      if (ctx) {
        ctx.drawImage(img, 0, 0);
        const pngUrl = canvas.toDataURL('image/png');
        const a = document.createElement('a');
        a.href = pngUrl;
        a.download = `hoba-cat-${currentDNA.seed}.png`;
        a.click();
      }
      URL.revokeObjectURL(url);
    };
    img.src = url;
  });

  // 10. Copy SVG to Clipboard
  copySvgBtn?.addEventListener('click', async () => {
    const svgStr = renderCatSVG(currentDNA, { width: 800, height: 800 });
    await navigator.clipboard.writeText(svgStr);
    const label = copySvgBtn.querySelector('.btn-text');
    if (label) {
      const orig = label.textContent;
      label.textContent = '✓ Скопійовано!';
      setTimeout(() => (label.textContent = orig), 2000);
    }
  });

  // 11. Cat Clan (Army) Generator
  function renderArmyGrid() {
    if (!armyGrid) return;
    armyGrid.innerHTML = '';
    for (let i = 0; i < 12; i++) {
      const seed = randomSeed();
      const dna = generateDNA(seed);
      const svg = renderCatSVG(dna, { width: 120, height: 120, idPrefix: `army-${i}` });

      const card = document.createElement('button');
      card.type = 'button';
      card.className = 'p-3 rounded-xl border border-slate-800 bg-slate-950/95 hover:bg-slate-900 hover:border-cyan-500/60 transition-all flex flex-col items-center text-center cursor-pointer group shadow';
      card.innerHTML = `
        <div class="w-20 h-20 flex items-center justify-center group-hover:scale-105 transition-transform">${svg}</div>
        <span class="text-xs font-bold text-slate-300 mt-2 truncate w-full group-hover:text-cyan-300">${dna.name}</span>
        <span class="text-[10px] text-slate-400 font-mono">${dna.pose}</span>
      `;
      card.addEventListener('click', () => {
        updateStudio(dna);
        window.scrollTo({ top: 120, behavior: 'smooth' });
      });
      armyGrid.appendChild(card);
    }
  }

  generateArmyBtn?.addEventListener('click', renderArmyGrid);

  // Initial load from URL hash if available
  if (window.location.hash) {
    const match = window.location.hash.match(/seed=([^&]+)/);
    if (match && match[1]) {
      const seed = decodeURIComponent(match[1]);
      updateStudio(generateDNA(seed));
    }
  }

  // Populate army
  renderArmyGrid();
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
