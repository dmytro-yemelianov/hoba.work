---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EntityRow from '../../components/EntityRow.astro';
import { countRoutes, getBundle, IDEAL_PATH_ID, stateAnchor } from '../../lib/registry';
import { localeFromParams, localePrefix, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);

const ROUTES: Record<string, string> = {
  observation: 'observations', barrier: 'barriers', mechanism: 'mechanisms',
  pattern: 'patterns', loop: 'loops', intervention: 'interventions',
};
const nodes = new Map(
  [...bundle.observations, ...bundle.barriers, ...bundle.mechanisms, ...bundle.patterns, ...bundle.loops, ...bundle.interventions].map((n) => [
    n.id,
    { id: n.id, title: n.title, href: `${prefix}/${ROUTES[n.type]}/${n.id}` },
  ])
);
const actors = new Map(bundle.actors.map((a) => [a.id, a.title]));

// The canonical path leads, because everything else on this page is a
// description of what actually happens instead of it.
const processes = [...bundle.processes].sort((a, b) => Number(b.id === IDEAL_PATH_ID) - Number(a.id === IDEAL_PATH_ID));

// The player needs the machine and the names it will print; both are resolved
// here so the client ships data rather than a second copy of the dictionary.
const payload = JSON.stringify({
  processes: processes.map((w) => ({ id: w.id, title: w.title, subject: w.subject, states: w.states, transitions: w.transitions })),
  nodes: Object.fromEntries(nodes),
  actors: Object.fromEntries(actors),
  strings: {
    play: t('wf.play'), pause: t('wf.pause'), step: t('wf.step'),
    owner: t('wf.owner'), visible: t('wf.visible'), entities: t('wf.entities'),
    deviations: t('wf.deviations'), transition: t('wf.transition'), leaves: t('wf.leaves'),
    branches: t('wf.branches'), ended: t('wf.ended'), broken: t('wf.broken'), clean: t('wf.clean'),
    share: t('wf.share'), copied: t('wf.copied'), walked: t('wf.walked'), arrived: t('wf.arrived'),
    terminal: t('wf.terminal'), initial: t('wf.initial'),
  },
}).replace(/</g, '\\u003c');
---
<Layout lang={lang} title={t('wf.title')} activeNav="process">
  <PageHeader kicker={t('wf.kicker')} title={t('wf.title')} lead={t('wf.intro')} wide tourPageKey="process" lang={lang} />

  {processes.map((workflow, index) => (
    <section class="section" data-workflow={workflow.id}>
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2 min-w-0 max-w-full">
        <h2 class="section-title flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-0 min-w-0 max-w-full wrap-break-word">
          <span class="min-w-0 wrap-break-word"><span class="break-all">{workflow.id}</span> · {workflow.title}</span>
          {workflow.id === IDEAL_PATH_ID && <span class="pill pill-muted shrink-0">{t('ideal.badge')}</span>}
        </h2>
        <span class="pill pill-muted text-xs font-mono max-w-full truncate"><span class="text-hoba-muted">{t('wf.subject')}:</span> {workflow.subject}</span>
      </div>

      <p class="text-base text-hoba-muted max-w-3xl">{workflow.summary}</p>

      {workflow.id === IDEAL_PATH_ID && (() => {
        const routes = countRoutes(workflow);
        const named = workflow.states.filter((s) => s.kind === 'terminal');
        return (
          <div class="rounded-xl border border-hoba-border bg-hoba-card/60 p-3.5 my-3 text-xs leading-relaxed space-y-2">
            <div class="flex items-center gap-2 font-mono text-hoba-accent font-semibold">
              <span>📐 {t('wf.routes', { n: routes.total })} ({named.length} {lang === 'uk' ? 'термінальні стани' : 'terminal states'})</span>
            </div>
            <p class="text-hoba-muted">{t('ideal.construct')}</p>
            <p class="text-hoba-muted">
              {named
                .map((s) => t('wf.routesEnd', { n: routes.byTerminal[s.id] ?? 0, title: s.title.toLocaleLowerCase(lang) }))
                .join('; ')}. {t('wf.routesNote')}
            </p>
          </div>
        );
      })()}

      <div class="wf-shell mt-5">
        <div class="wf-transport flex flex-col items-stretch gap-2 px-3 py-2 border-b border-hoba-border bg-hoba-bg overflow-hidden">
          <div class="flex flex-wrap items-center gap-2 w-full justify-between">
            <div class="flex flex-wrap items-center gap-1.5 min-w-0">
              <div class="wf-modes inline-flex items-center gap-0.5 rounded-md border border-hoba-border bg-hoba-bg p-0.5 text-xs shrink-0" role="group" aria-label={t('wf.states')}>
                <button type="button" class="wf-mode px-2 py-1 text-xs" data-index={index} data-mode="play" aria-pressed="true">{t('wf.mode.play')}</button>
                <button type="button" class="wf-mode px-2 py-1 text-xs" data-index={index} data-mode="choose" aria-pressed="false">{t('wf.mode.choose')}</button>
              </div>
              <button type="button" class="wf-play btn btn-secondary text-xs px-2.5 py-1 shrink-0" data-index={index} aria-label={t('wf.play')}>{t('wf.play')}</button>
              <button type="button" class="wf-prev icon-btn shrink-0" data-index={index} aria-label={t('wf.prev')} title={t('wf.prev')}>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              </button>
              <button type="button" class="wf-next icon-btn shrink-0" data-index={index} aria-label={t('wf.next')} title={t('wf.next')}>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </button>
              <button type="button" class="wf-reset icon-btn shrink-0" data-index={index} aria-label={t('wf.reset')} title={t('wf.reset')}>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7M20 19l-7-7 7-7"/></svg>
              </button>
            </div>

            <div class="flex items-center gap-1.5 shrink-0">
              <label class="sr-only" for={`wf-speed-${index}`}>{t('wf.speed')}</label>
              <select id={`wf-speed-${index}`} class="wf-speed rounded-md border border-hoba-border bg-hoba-card px-2 py-1 text-xs text-hoba-text font-mono cursor-pointer" data-index={index} aria-label={t('wf.speed')}>
                <option value="1">1x</option>
                <option value="1.5">1.5x</option>
                <option value="2">2x</option>
              </select>
              <button type="button" class="wf-autozoom pill pill-active text-xs cursor-pointer font-medium" data-index={index} aria-pressed="true" title={t('wf.autozoom')}>
                🔍 {lang === 'uk' ? 'Авто-зум' : 'Auto-zoom'}
              </button>
            </div>
          </div>

          <div class="flex items-center gap-2 w-full pt-1.5 border-t border-hoba-border/40 min-w-0">
            <input type="range" class="wf-scrub flex-1 min-w-0" data-index={index} min="0" value="0" aria-label={t('wf.states')} />
            <span class="wf-step text-xs font-mono text-hoba-muted tabular-nums whitespace-nowrap shrink-0" data-index={index} aria-live="polite"></span>
          </div>
        </div>
        <div class="wf-stage relative" data-index={index}>
          <canvas class="wf-canvas h-full" data-index={index} tabindex="0" role="img" aria-label={t('wf.canvasLabel')}></canvas>
        </div>
        <div class="wf-detail border-t border-hoba-border px-4 py-3 sm:px-5" data-index={index}></div>
        <div class="wf-branches" data-index={index} aria-live="polite"></div>
      </div>

      <details class="section">
        <summary class="section-title cursor-pointer">{t('wf.fallback')}</summary>
        <ol class="row-list mt-3">
          {workflow.states.map((state) => (
            <li class="py-3 scroll-mt-24" id={stateAnchor(workflow.id, state.id)}>
              <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="font-mono text-sm text-hoba-accent">{state.id}</span>
                <span class="text-hoba-text font-medium">{state.title}</span>
                <span class="pill pill-muted">{actors.get(state.owner) ?? state.owner}</span>
                {state.kind !== 'active' && <span class="pill pill-muted">{state.kind === 'initial' ? t('wf.initial') : t('wf.terminal')}</span>}
              </p>
              <p class="mt-1 text-base text-hoba-muted">{state.description}</p>
              {state.visible_to_candidate && (
                <p class="mt-1 text-sm text-hoba-muted"><span class="text-hoba-text">{t('wf.visible')}:</span> {state.visible_to_candidate}</p>
              )}
              {state.entities.length > 0 && (
                <p class="mt-2 text-sm text-hoba-muted">{workflow.id === IDEAL_PATH_ID ? t('ideal.holdsHere') : t('wf.entities')}</p>
              )}
              {state.entities.length > 0 && (
                <ul class="mt-1 flex flex-wrap gap-1.5">
                  {state.entities.map((id) => (
                    <li><a href={nodes.get(id)?.href ?? '#'} class="pill pill-muted font-mono">{id}</a></li>
                  ))}
                </ul>
              )}
              {state.deviations.length > 0 && (
                <p class="mt-2 text-sm text-hoba-muted">{workflow.id === IDEAL_PATH_ID ? t('ideal.deviationsHere') : t('wf.deviations')}</p>
              )}
              {state.deviations.length > 0 && (
                <ul class="mt-1 flex flex-wrap gap-1.5">
                  {state.deviations.map((id) => (
                    <li><a href={nodes.get(id)?.href ?? '#'} class="pill pill-muted font-mono">{id}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>
        <ol class="row-list mt-6">
          {workflow.transitions.map((transition) => (
            <li class="row text-base">
              <span class="font-mono text-sm text-hoba-accent">{transition.from} → {transition.to}</span>
              <span class="text-hoba-text">{transition.label}</span>
              <span class="w-full text-sm text-hoba-muted">
                {t('wf.transition')}: {transition.guard}
                {transition.latency_expected_days !== undefined && (
                  <span class="ml-2 font-mono text-xs text-hoba-accent">
                    (turnaround: {transition.latency_expected_days}d / max: {transition.latency_max_days}d)
                  </span>
                )}
              </span>
            </li>
          ))}
        </ol>
      </details>
    </section>
  ))}

  <script type="application/json" id="wf-data" set:html={payload} />
  <script>
    import { WorkflowView, type ViewState, type WorkflowData, type WorkflowMode, type WorkflowStep } from '../../lib/workflow-view';

    interface Payload {
      processes: WorkflowData[];
      nodes: Record<string, { id: string; title: string; href: string }>;
      actors: Record<string, string>;
      strings: Record<string, string>;
    }

    const raw = document.getElementById('wf-data')?.textContent;
    if (raw) {
      const data = JSON.parse(raw) as Payload;
      const fill = (template: string, vars: Record<string, string | number>) =>
        template.replace(/\{(\w+)\}/g, (_, name: string) => String(vars[name] ?? ''));

      const pick = <T extends Element>(selector: string, index: number) =>
        document.querySelector<T>(`${selector}[data-index="${index}"]`);

      const views = new Map<string, WorkflowView>();

      data.processes.forEach((workflow, index) => {
        const canvas = pick<HTMLCanvasElement>('canvas.wf-canvas', index);
        const detail = pick<HTMLElement>('.wf-detail', index);
        const scrub = pick<HTMLInputElement>('.wf-scrub', index);
        const stepLabel = pick<HTMLElement>('.wf-step', index);
        const playButton = pick<HTMLButtonElement>('.wf-play', index);
        if (!canvas || !detail || !scrub || !stepLabel || !playButton) return;

        const list = (heading: string, ids: string[]) => {
          if (!ids.length) return '';
          const items = ids
            .map((id) => {
              const node = data.nodes[id];
              return node
                ? `<li><a href="${node.href}" class="pill pill-muted font-mono">${id}</a></li>`
                : `<li><span class="pill pill-muted font-mono">${id}</span></li>`;
            })
            .join('');
          return `<p class="mt-2 text-sm text-hoba-muted">${heading}</p><ul class="mt-1 flex flex-wrap gap-1.5">${items}</ul>`;
        };

        const branchPanel = pick<HTMLElement>('.wf-branches', index);
        const shell = canvas.closest('.wf-shell');

        // In `choose` mode the panel is either the fork or, at a terminal, the
        // account of the walk: which commitments it broke on the way through.
        const renderBranches = ({ branches, trace }: WorkflowStep) => {
          if (!branchPanel) return;
          if (branches.length) {
            branchPanel.innerHTML = [
              `<p class="text-sm text-hoba-muted">${data.strings.branches}</p>`,
              `<div class="mt-2 grid gap-2 sm:grid-cols-2">`,
              ...branches.map(
                (b, i) =>
                  `<button type="button" class="wf-branch" data-branch="${i}">` +
                  `<span class="wf-branch-label">${b.label}</span>` +
                  `<span class="wf-branch-guard">${b.guard}` +
                  (b.latency_expected_days !== undefined
                    ? ` · <span class="font-mono text-xs text-hoba-accent">${b.latency_expected_days}d-${b.latency_max_days}d</span>`
                    : '') +
                  `</span>` +
                  `</button>`
              ),
              `</div>`,
            ].join('');
            return;
          }
          const broken = [...new Set(trace.flatMap((s) => (s as ViewState).deviations ?? []))];
          branchPanel.innerHTML = [
            `<p class="text-sm text-hoba-muted">${data.strings.ended}</p>`,
            `<p class="mt-1 text-base font-medium text-hoba-text">${trace[trace.length - 1]?.title ?? ''}</p>`,
            `<p class="mt-1 text-sm text-hoba-muted">${fill(data.strings.walked, { n: trace.length - 1 })}</p>`,
            broken.length
              ? list(data.strings.broken, broken)
              : `<p class="mt-3 text-base text-hoba-muted max-w-2xl">${data.strings.clean}</p>`,
            `<p class="mt-3"><button type="button" class="wf-share btn btn-secondary">${data.strings.share}</button></p>`,
          ].join('');
        };

        const view = new WorkflowView(canvas, workflow, {
          onStep: (step) => {
            const { index: at, total, state, transition } = step;
            if (step.mode === 'choose') renderBranches(step);
            scrub.max = String(total - 1);
            scrub.value = String(at);
            stepLabel.textContent = fill(data.strings.step, { n: at + 1, total });
            const kind = state.kind === 'initial' ? data.strings.initial : state.kind === 'terminal' ? data.strings.terminal : '';
            detail.innerHTML = [
              `<p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">`,
              `<span class="font-mono text-sm text-hoba-accent">${state.id}</span>`,
              `<span class="text-base font-medium text-hoba-text">${state.title}</span>`,
              `<span class="pill pill-muted">${data.actors[state.owner] ?? state.owner}</span>`,
              kind ? `<span class="pill pill-muted">${kind}</span>` : '',
              `</p>`,
              `<p class="mt-1 text-base text-hoba-muted">${state.description}</p>`,
              state.visible_to_candidate
                ? `<p class="mt-1 text-sm text-hoba-muted"><span class="text-hoba-text">${data.strings.visible}:</span> ${state.visible_to_candidate}</p>`
                : '',
              transition
                ? `<p class="mt-2 text-sm text-hoba-muted"><span class="text-hoba-text">${step.mode === 'choose' ? data.strings.arrived : data.strings.leaves}:</span> ${transition.label}</p>`
                : '',
              transition
                ? `<p class="mt-1 text-sm text-hoba-muted"><span class="text-hoba-text">${data.strings.transition}:</span> ${transition.guard}</p>`
                : '',
              list(data.strings.entities, state.entities),
              list(data.strings.deviations, (state as ViewState).deviations ?? []),
            ].join('');
          },
          onPlaying: (playing) => {
            playButton.textContent = playing ? data.strings.pause : data.strings.play;
            playButton.setAttribute('aria-label', playing ? data.strings.pause : data.strings.play);
          },
        });

        views.set(workflow.id, view);
        // Give the machine the height it actually needs, rather than one box
        // for every machine with the short ones half empty.
        const stage = pick<HTMLElement>('.wf-stage', index);
        if (stage) stage.style.height = `${Math.min(440, Math.max(240, view.preferredHeight()))}px`;
        playButton.addEventListener('click', () => view.toggle());
        pick<HTMLButtonElement>('.wf-next', index)?.addEventListener('click', () => { view.pause(); view.next(); });
        pick<HTMLButtonElement>('.wf-prev', index)?.addEventListener('click', () => { view.pause(); view.previous(); });
        pick<HTMLButtonElement>('.wf-reset', index)?.addEventListener('click', () => view.reset());
        scrub.addEventListener('input', () => { view.pause(); view.seek(Number(scrub.value)); });

        pick<HTMLSelectElement>('.wf-speed', index)?.addEventListener('change', (e) => {
          view.setSpeed(Number((e.target as HTMLSelectElement).value));
        });

        const autozoomBtn = pick<HTMLButtonElement>('.wf-autozoom', index);
        let autozoomActive = true;
        autozoomBtn?.addEventListener('click', () => {
          autozoomActive = !autozoomActive;
          view.setAutoZoom(autozoomActive);
          autozoomBtn.classList.toggle('pill-active', autozoomActive);
          autozoomBtn.classList.toggle('pill-muted', !autozoomActive);
          autozoomBtn.setAttribute('aria-pressed', String(autozoomActive));
        });

        const modeButtons = document.querySelectorAll<HTMLButtonElement>(`.wf-mode[data-index="${index}"]`);
        const setMode = (mode: WorkflowMode) => {
          view.setMode(mode);
          shell?.classList.toggle('is-choosing', mode === 'choose');
          modeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
        };
        modeButtons.forEach((b) =>
          b.addEventListener('click', () => setMode(b.dataset.mode === 'choose' ? 'choose' : 'play'))
        );

        branchPanel?.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const branch = target?.closest('[data-branch]');
          if (branch) {
            view.choose(Number(branch.getAttribute('data-branch')));
            return;
          }
          const share = target?.closest('.wf-share');
          if (!share) return;
          // The walk is the argument, so it has to be sendable.
          const url = new URL(location.href);
          url.searchParams.set('walk', `${workflow.id}:${view.walk.join(',')}`);
          url.hash = '';
          navigator.clipboard
            ?.writeText(url.toString())
            .then(() => { share.textContent = data.strings.copied; })
            .catch(() => {});
        });

        view.seek(0);

        const asked = new URLSearchParams(location.search).get('walk');
        if (asked && asked.startsWith(`${workflow.id}:`)) {
          setMode('choose');
          view.restore(asked.slice(workflow.id.length + 1).split(',').filter(Boolean));
        }
      });

      // A link from a barrier page names one state of one machine. Open the
      // machine it belongs to, put the player on that state, and scroll to it.
      const openAnchor = () => {
        const anchor = decodeURIComponent(location.hash.slice(1));
        // A canonical workflow id carries dots and hyphens of its own, so the
        // boundary between machine and state is found against the machines
        // actually on the page rather than guessed with a pattern.
        const workflowId = [...views.keys()]
          .filter((id) => anchor.startsWith(`${id}-`))
          .sort((a, b) => b.length - a.length)[0];
        if (!workflowId) return;
        const stateId = anchor.slice(workflowId.length + 1);
        const view = views.get(workflowId);
        if (!view) return;
        document.getElementById(anchor)?.closest('details')?.setAttribute('open', '');
        view.selectState(stateId!);
        // The native hash jump lands on the list entry; what the reader asked
        // for is the player, already standing on that state.
        requestAnimationFrame(() =>
          document.querySelector(`[data-workflow="${workflowId}"] .wf-shell`)?.scrollIntoView({ block: 'center' })
        );
      };
      openAnchor();
      window.addEventListener('hashchange', openAnchor);

      window.addEventListener('hoba:theme', () => views.forEach((v) => v.refreshTheme()));
    }
  </script>
</Layout>
