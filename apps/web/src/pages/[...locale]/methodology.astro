---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { branded, localeFromParams, localeStaticPaths, useTranslations } from '../../i18n/utils';
import { evidenceKindSchema, evidenceLevelSchema } from '@hoba/registry';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const verbs = ['observed', 'compatible', 'supported', 'proven'] as const;
const protocol = [
  { letter: 'H', title: t('home.step.h.title'), text: t('home.step.h.text'), out: t('home.step.h.out') },
  { letter: 'O', title: t('home.step.o.title'), text: t('home.step.o.text'), out: t('home.step.o.out') },
  { letter: 'B', title: t('home.step.b.title'), text: t('home.step.b.text'), out: t('home.step.b.out') },
  { letter: 'A', title: t('home.step.a.title'), text: t('home.step.a.text'), out: t('home.step.a.out') },
] as const;

/**
 * Read off the schema, never restated. This page is about what the registry
 * may claim, so a hand-typed list here is a second source of truth that drifts
 * the moment the enum changes — as it did when the levels went from four to
 * seven and this prose had to be edited by hand, in two languages.
 */

const tocItems = [
  { id: 'method-core', label: t('method.core.title'), icon: '⚖️' },
  { id: 'method-protocol', label: t('home.protocol.title'), icon: '🧭' },
  { id: 'method-verbs', label: t('method.verbs.title'), icon: '🔤' },
  { id: 'method-honest', label: t('method.honest.title'), icon: '🛡️' },
  { id: 'method-evidence', label: t('method.evidence.title'), icon: '📑' },
  { id: 'method-nongoals', label: t('method.nongoals.title'), icon: '🚫' },
];
---
<Layout lang={lang} title={t('method.title')} activeNav="methodology">
  <PageHeader kicker={t('method.kicker')} title={t('method.heading')} lead={t('method.intro')} />

  <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_16rem] gap-10 items-start mt-4">
    <article class="prose-hoba min-w-0">
      <section id="method-core" class="scroll-mt-24">
        <h2>{t('method.core.title')}</h2>
        <blockquote set:html={branded(t('method.core.quote'))} />
        <p>{t('method.core.text')}</p>
      </section>

      <section id="method-protocol" class="scroll-mt-24 mt-10">
        <h2>{t('home.protocol.title')}</h2>
        <p>{t('home.protocol.sub')}</p>
        <div class="not-prose mt-5 grid gap-3 sm:grid-cols-2">
          {protocol.map((step) => (
            <div class="rounded-lg border border-hoba-border bg-hoba-card p-4">
              <div class="flex items-center gap-3">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-hoba-accent/40 bg-hoba-accent/10 font-mono font-bold text-hoba-accent">{step.letter}</span>
                <h3 class="m-0 text-base font-semibold text-hoba-text">{step.title}</h3>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-hoba-muted">{step.text}</p>
              <p class="mt-2 text-xs font-mono text-hoba-muted">{step.out}</p>
            </div>
          ))}
        </div>
        <p class="mt-5 text-hoba-muted">
          <strong class="text-hoba-text">HOBA</strong> is the procedure used to reason over the atlas; the evidence levels below describe the strength of individual claims. They are separate axes.
        </p>
      </section>

      <section id="method-verbs" class="scroll-mt-24 mt-10">
        <h2>{t('method.verbs.title')}</h2>
        <p set:html={branded(t('method.verbs.sub'))} />
        <dl>
          {verbs.map((v) => (
            <>
              <dt class="font-mono text-hoba-text">{t(`method.verbs.${v}`)}</dt>
              <dd class="text-hoba-muted">{t(`method.verbs.${v}.text`)}</dd>
            </>
          ))}
        </dl>
      </section>

      <section id="method-honest" class="scroll-mt-24 mt-10">
        <h2>{t('method.honest.title')}</h2>
        <p>{t('method.honest.text')}<code>honest_baseline: true</code>{t('method.honest.textAfter')}</p>
      </section>

      <section id="method-evidence" class="scroll-mt-24 mt-10">
        <h2>{t('method.evidence.title')}</h2>
        <p>{t('method.evidence.text1.before')}<code>evidence_level</code>{t('method.evidence.text1.middle')}<code>EVD-xxx</code>{t('method.evidence.text1.after')}</p>
        <p>
          {t('method.evidence.kindsLead')}{' '}
          {evidenceKindSchema.options.map((k, i) => (
            <><code>{k}</code>{i < evidenceKindSchema.options.length - 1 ? ', ' : '.'}</>
          ))}
        </p>
        <p>
          {t('method.evidence.levelsLead')}{' '}
          {evidenceLevelSchema.options.map((l, i) => (
            <><code>{l}</code>{i < evidenceLevelSchema.options.length - 1 ? ', ' : ''}</>
          ))}
          {t('method.evidence.levelsTail')}
        </p>
        <p>{t('method.evidence.text2.before')}<code>compatible</code>{t('method.evidence.text2.after')}</p>
      </section>

      <section id="method-nongoals" class="scroll-mt-24 mt-10">
        <div class="callout border-l-hoba-exogenous">
          <h2 class="mt-0">{t('method.nongoals.title')}</h2>
          <p set:html={branded(t('method.nongoals.sub'))} />
          <ul>{(['1', '2', '3', '4', '5'] as const).map((n) => <li>{t(`method.nongoals.${n}`)}</li>)}</ul>
        </div>
      </section>
    </article>

    <!-- Sticky Side Navigation -->
    <TableOfContents items={tocItems} lang={lang} />
  </div>
</Layout>
