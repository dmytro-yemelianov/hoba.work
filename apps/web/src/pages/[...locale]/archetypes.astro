---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ArchetypeGrid from '../../components/ArchetypeGrid.astro';
import { ARCHETYPES, getBundle } from '../../lib/registry';
import { localeFromParams, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const bundle = getBundle(lang);

/**
 * One grid per entity type rather than one grid for all 124 — mixing 28
 * mechanisms into the same nine boxes as 3 loops made every box read as
 * "mechanisms, mostly," which buried the more interesting fact: each type
 * has its own honest shape on these two axes.
 */
const TYPE_GROUPS = [
  { prefix: 'obs', labelKey: 'entity.plural.observation' },
  { prefix: 'bar', labelKey: 'entity.plural.barrier' },
  { prefix: 'mech', labelKey: 'entity.plural.mechanism' },
  { prefix: 'pat', labelKey: 'entity.plural.pattern' },
  { prefix: 'loop', labelKey: 'entity.plural.loop' },
  { prefix: 'int', labelKey: 'entity.plural.intervention' },
  { prefix: 'actor', labelKey: 'entity.plural.actor' },
  { prefix: 'record', labelKey: 'entity.plural.record' },
  { prefix: 'era', labelKey: 'entity.plural.era' },
  { prefix: 'proc', labelKey: 'entity.plural.process' },
] as const;

const groups = TYPE_GROUPS.map(({ prefix, labelKey }) => ({
  id: `archetypes-${prefix}`,
  label: t(labelKey),
  archetypes: ARCHETYPES.filter((a) => a.id.split('.')[0] === prefix),
})).filter((g) => g.archetypes.length > 0);

const tocItems = groups.map((g) => ({ id: g.id, label: `${g.label} (${g.archetypes.length})` }));
---
<Layout lang={lang} title={t('archetypes.title')} activeNav="archetypes">
  <PageHeader kicker={t('archetypes.kicker')} title={t('archetypes.title')} lead={t('archetypes.intro')} wide />

  <p class="mt-4 text-sm text-hoba-muted border-l-2 border-hoba-border pl-3">{t('archetypes.disclaimer')}</p>

  <dl class="mt-4 space-y-1 text-xs text-hoba-muted">
    <div><dt class="inline font-semibold">{lang === 'uk' ? 'Горизонталь: ' : 'Horizontal: '}</dt><dd class="inline">{t('archetypes.axis.x')}</dd></div>
    <div><dt class="inline font-semibold">{lang === 'uk' ? 'Вертикаль: ' : 'Vertical: '}</dt><dd class="inline">{t('archetypes.axis.y')}</dd></div>
  </dl>

  <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_16rem] gap-10 items-start mt-8">
    <div class="space-y-12 min-w-0">
      {groups.map((g) => (
        <section id={g.id} class="scroll-mt-24">
          <h2 class="section-title">{g.label} <span class="text-hoba-muted font-normal">({g.archetypes.length})</span></h2>
          <div class="mt-4">
            <ArchetypeGrid lang={lang} archetypes={g.archetypes} bundle={bundle} />
          </div>
        </section>
      ))}

      <p class="text-sm text-hoba-muted">{t('archetypes.coverageNote', { n: String(ARCHETYPES.length) })}</p>
    </div>

    <TableOfContents items={tocItems} lang={lang} />
  </div>
</Layout>
