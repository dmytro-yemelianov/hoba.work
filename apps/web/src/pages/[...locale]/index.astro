---
import Layout from '../../layouts/Layout.astro';
import RemovabilityBadge from '../../components/RemovabilityBadge.astro';
import Specimen from '../../components/Specimen.astro';
import OnboardingTour from '../../components/OnboardingTour.astro';
import { countGraphNodes, getBundle, getGraph, siteVersion } from '../../lib/registry';
import { branded, asHeading, localeFromParams, localePrefix, localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const bundle = getBundle(lang);
const totalNodes = countGraphNodes(bundle);

const steps = [
  { k: 'h', letter: 'H', stepNum: '01' },
  { k: 'o', letter: 'O', stepNum: '02' },
  { k: 'b', letter: 'B', stepNum: '03' },
  { k: 'a', letter: 'A', stepNum: '04' },
] as const;

const stats = [
  { n: totalNodes, label: t('home.stat.entities'), desc: 'Formal ontology nodes' },
  { n: bundle.barriers.length, label: t('home.stat.barriers'), desc: t('home.stat.barriersDesc') },
  { n: bundle.mechanisms.length, label: t('home.stat.mechanisms'), desc: t('home.stat.mechanismsDesc') },
  { n: bundle.patterns.length, label: t('home.stat.patternsDesc'), desc: t('home.stat.leanDesc') },
];

const personas = [
  {
    role: 'candidate',
    icon: '🎯',
    title: t('home.role.candidate.title'),
    desc: t('home.role.candidate.desc'),
    cta: `${t('analyze.heading')} →`,
    href: `${prefix}/analyze`,
    badge: 'Walkthrough',
  },
  {
    role: 'recruiter',
    icon: '⚙️',
    title: t('home.role.recruiter.title'),
    desc: t('home.role.recruiter.desc'),
    cta: `${t('wf.kicker')} →`,
    href: `${prefix}/process`,
    badge: 'State Machines',
  },
  {
    role: 'researcher',
    icon: '🔬',
    title: t('home.role.researcher.title'),
    // Counted, not stated: this said 89 while the registry had grown to 96.
    desc: t('home.role.researcher.desc', { n: totalNodes }),
    cta: `${t('graph.title')} →`,
    href: `${prefix}/graph`,
    badge: 'Graph Explorer',
  },
] as const;

const caseArtifact = bundle.observations.find((a) => a.id === 'obs.generic_closer_alignment_rejection_template' || a.id === 'A-002')!;
const caseSpecimen = caseArtifact.specimens[0];
const caseMechanisms = bundle.mechanisms
  .filter((m) => m.emissions.some((e) => e.artifact === caseArtifact.id))
  .slice(0, 4);
---
<Layout lang={lang} title={t('home.title')} activeNav="home">
  <!-- HERO SECTION -->
  <section id="main" class="py-8 sm:py-12 border-b border-hoba-border scroll-mt-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7">
        <div class="flex items-center justify-between gap-3 mb-1">
          <p class="kicker">{lang === 'uk' ? 'Атлас перешкод і барʼєрів найму' : 'Hiring Obstacles & Barriers Atlas'}</p>
          <OnboardingTour pageKey="home" lang={lang} />
        </div>

        <h1 class="mt-2 text-2xl sm:text-4xl font-extrabold text-hoba-text tracking-tight leading-snug">
          {t('home.h1.before')}<span class="text-hoba-accent">{t('home.h1.accent')}</span>
        </h1>

        <p class="mt-3 text-base sm:text-lg text-hoba-muted leading-relaxed" set:html={branded(t('home.what', { n: totalNodes }))} />

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href={`${prefix}/analyze`} class="btn btn-primary">{t('home.cta.primary')} →</a>
          <a href={`${prefix}/registry`} class="btn btn-secondary">{t('home.cta.secondary', { n: totalNodes })}</a>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-mono text-hoba-muted">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            {lang === 'uk' ? '100% клієнтська діагностика' : '100% Client-side privacy'}
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-hoba-accent"></span>
            {lang === 'uk' ? 'Без збору даних' : 'Zero telemetry'}
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
            {lang === 'uk' ? 'Формальні доведення Lean 4' : 'Lean 4 kernel proofs'}
          </span>
        </div>
      </div>

      <!-- Right Column: Interactive Diagnostic Flow Preview -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl border border-hoba-border bg-hoba-card/90 p-5 shadow-xl shadow-black/5 relative overflow-hidden">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-hoba-border pb-3 mb-4">
            <div class="flex items-center gap-2">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-hoba-text">
                {lang === 'uk' ? 'Приклад розбору випадку' : 'Diagnostic Pipeline Flow'}
              </span>
            </div>
            <span class="inline-block rounded-full border border-hoba-border bg-hoba-card px-2.5 py-0.5 text-[11px] font-mono text-hoba-muted break-all max-w-full">DAG: obs.generic_closer_alignment_rejection_template → bar.automated_filter_parser_threshold → mech.genuine_technical_skill_shortfall</span>
          </div>

          <!-- Flow Steps -->
          <div class="space-y-2.5">
            <!-- Node 1: Observation -->
            <a href={`${prefix}/observations/obs.generic_closer_alignment_rejection_template`} class="block p-3 rounded-lg border border-hoba-border bg-hoba-bg hover:border-hoba-accent/50 transition-all text-left no-underline group">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="inline-block rounded-full border border-hoba-border bg-hoba-card px-2.5 py-0.5 text-[10px] font-mono text-hoba-accent break-all">obs.generic_closer_alignment_rejection_template · {lang === 'uk' ? 'Спостереження' : 'Observation'}</span>
                <span class="text-[11px] font-mono text-hoba-muted shrink-0">{lang === 'uk' ? 'Етап: Скринінг' : 'Stage: Screening'}</span>
              </div>
              <p class="mt-1 text-xs font-semibold text-hoba-text group-hover:text-hoba-accent transition-colors">
                {lang === 'uk' ? 'Шаблонна нічна відмова без деталей (03:14)' : 'Standardized late-night rejection message (03:14)'}
              </p>
            </a>

            <!-- Flow Connector -->
            <div class="flex items-center justify-center text-hoba-muted text-xs font-mono py-0.5">
              <span>↓ {lang === 'uk' ? 'Зупинка на барʼєрі воронки' : 'Stopped at Funnel Barrier'}</span>
            </div>

            <!-- Node 2: Barrier -->
            <a href={`${prefix}/barriers/bar.automated_filter_parser_threshold`} class="block p-3 rounded-lg border border-hoba-border bg-hoba-bg hover:border-hoba-accent/50 transition-all text-left no-underline group">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="inline-block rounded-full border border-hoba-border bg-hoba-card px-2.5 py-0.5 text-[10px] font-mono text-amber-700 dark:text-amber-400 break-all">bar.automated_filter_parser_threshold · {lang === 'uk' ? 'Барʼєр воронки' : 'Funnel Barrier'}</span>
                <span class="text-[11px] font-mono text-hoba-muted shrink-0">{lang === 'uk' ? 'Детерміновано' : 'Deterministic'}</span>
              </div>
              <p class="mt-1 text-xs font-semibold text-hoba-text group-hover:text-hoba-accent transition-colors">
                {lang === 'uk' ? 'Автоматичний фільтр парсера резюме ATS' : 'Automated ATS Resume Parser Threshold'}
              </p>
            </a>

            <!-- Flow Connector -->
            <div class="flex items-center justify-center text-hoba-muted text-xs font-mono py-0.5">
              <span>↓ {lang === 'uk' ? 'Сумісний кореневий механізм' : 'Compatible Root Mechanism'}</span>
            </div>

            <!-- Node 3: Mechanism -->
            <a href={`${prefix}/mechanisms/mech.genuine_technical_skill_shortfall`} class="block p-3 rounded-lg border border-rose-500/30 bg-rose-500/5 hover:border-rose-500/60 transition-all text-left no-underline group">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="inline-block rounded-full border border-hoba-border bg-hoba-card px-2.5 py-0.5 text-[10px] font-mono text-rose-700 dark:text-rose-400 break-all">mech.genuine_technical_skill_shortfall · {lang === 'uk' ? 'Механізм' : 'Mechanism'}</span>
                <span class="inline-block rounded-full border border-rose-500/30 bg-rose-500/10 px-2 py-0.5 text-[10px] text-rose-700 dark:text-rose-400 shrink-0">{lang === 'uk' ? 'Екзогенно' : 'Exogenous'}</span>
              </div>
              <p class="mt-1 text-xs font-semibold text-hoba-text group-hover:text-rose-600 dark:group-hover:text-rose-300 transition-colors">
                {lang === 'uk' ? 'Фантомна вакансія або збір бази без активного бюджету' : 'Ghost Requisition & Pipeline Refresh without Budget'}
              </p>
            </a>
          </div>

          <!-- Diagnostic Insight -->
          <div class="mt-3 pt-3 border-t border-hoba-border text-xs flex items-center justify-between gap-2">
            <span class="text-hoba-muted truncate">
              💡 <strong class="text-hoba-text">{lang === 'uk' ? 'Проба:' : 'Probe:'}</strong> {lang === 'uk' ? 'Звірити дельту дати публікації (PR-001)' : 'Audit posting date delta (PR-001)'}
            </span>
            <a href={`${prefix}/analyze`} class="text-hoba-accent hover:underline font-mono shrink-0 font-medium">
              {lang === 'uk' ? 'Розбір →' : 'Analyze →'}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 4-Metric Definition List Cards -->
    <dl class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
      {stats.map((s) => (
        <div class="p-4 rounded-xl border border-hoba-border bg-hoba-card hover:border-hoba-accent/40 transition-all flex flex-col justify-between">
          <dt class="text-xs font-semibold uppercase tracking-wider text-hoba-muted">{s.label}</dt>
          <dd class="mt-1">
            <span class="text-2xl sm:text-3xl font-bold font-mono text-hoba-text tabular-nums">{s.n}</span>
            <span class="block mt-0.5 text-xs text-hoba-muted font-normal">{s.desc}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- 4 INTERACTIVE ENGINES SHOWCASE -->
  <section id="tools-grid" class="py-12 sm:py-16 border-b border-hoba-border scroll-mt-24">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <p class="kicker">{lang === 'uk' ? 'Інструменти атласу' : 'Atlas Engine Suite'}</p>
        <h2 class="mt-1 text-2xl sm:text-3xl font-bold text-hoba-text">
          {lang === 'uk' ? 'Чотири способи дослідити систему' : 'Four Ways to Explore the System'}
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-hoba-muted max-w-md">
        {lang === 'uk' ? 'Працює локально у вашому браузері без передачі персональних даних або запитів на сервер.' : 'Runs locally in your browser with zero telemetry or data extraction.'}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <a href={`${prefix}/analyze`} class="group p-5 rounded-xl border border-hoba-border bg-hoba-card hover:border-hoba-accent/60 hover:bg-hoba-hover/50 hover:shadow-lg transition-all flex flex-col justify-between no-underline">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-hoba-accent/10 text-hoba-accent font-mono text-sm font-bold">01</span>
            <span class="pill pill-muted text-[11px] font-mono">{lang === 'uk' ? 'Діагностика' : 'Diagnostic'}</span>
          </div>
          <h3 class="text-base font-semibold text-hoba-text group-hover:text-hoba-accent transition-colors">
            {lang === 'uk' ? 'Аналіз ситуації' : 'Situation Analyzer'}
          </h3>
          <p class="mt-1.5 text-xs text-hoba-muted leading-relaxed">
            {lang === 'uk' ? 'Введіть спостережуваний факт (тишу, відмову чи тестове) та отримайте список логічно сумісних механізмів.' : 'Input your witnessed observations and derive compatible root causes without speculative self-blame.'}
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hoba-border/60 text-xs font-medium text-hoba-accent flex items-center gap-1">
          <span>{lang === 'uk' ? 'Запустити аналіз' : 'Run Analyzer'}</span>
          <span>→</span>
        </div>
      </a>

      <a href={`${prefix}/check`} class="group p-5 rounded-xl border border-hoba-border bg-hoba-card hover:border-hoba-accent/60 hover:bg-hoba-hover/50 hover:shadow-lg transition-all flex flex-col justify-between no-underline">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-hoba-hover border border-hoba-border text-hoba-text font-mono text-sm font-bold">02</span>
            <span class="pill pill-muted text-[11px] font-mono">{lang === 'uk' ? 'Арифметика' : 'Arithmetic'}</span>
          </div>
          <h3 class="text-base font-semibold text-hoba-text group-hover:text-hoba-accent transition-colors">
            {lang === 'uk' ? 'Перевірка відповідності' : 'Conformance Check'}
          </h3>
          <p class="mt-1.5 text-xs text-hoba-muted leading-relaxed">
            {lang === 'uk' ? 'Звірте названі умови вакансії з фактами профілю: роки, обовʼязкові фрази, локація та зарплатна вилка.' : 'Audit posting hard requirements against your verified profile before investing preparation time.'}
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hoba-border/60 text-xs font-medium text-hoba-accent flex items-center gap-1">
          <span>{lang === 'uk' ? 'Перевірити профіль' : 'Check Posting'}</span>
          <span>→</span>
        </div>
      </a>

      <a href={`${prefix}/process`} class="group p-5 rounded-xl border border-hoba-border bg-hoba-card hover:border-hoba-accent/60 hover:bg-hoba-hover/50 hover:shadow-lg transition-all flex flex-col justify-between no-underline">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-hoba-hover border border-hoba-border text-hoba-text font-mono text-sm font-bold">03</span>
            <span class="pill pill-muted text-[11px] font-mono">{lang === 'uk' ? 'Стейт-машина' : 'State Machine'}</span>
          </div>
          <h3 class="text-base font-semibold text-hoba-text group-hover:text-hoba-accent transition-colors">
            {lang === 'uk' ? 'Симулятор процесу' : 'Pipeline State Machine'}
          </h3>
          <p class="mt-1.5 text-xs text-hoba-muted leading-relaxed">
            {lang === 'uk' ? 'Інтерактивний покроковий плеєр 4 процесів найму (воронка, ATS, канонічний шлях, клієнтський найм).' : 'Step through sequenced pipeline state machines and verify where stage turnaround exceeds normal limits.'}
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hoba-border/60 text-xs font-medium text-hoba-accent flex items-center gap-1">
          <span>{lang === 'uk' ? 'Крокувати процесом' : 'Step Through'}</span>
          <span>→</span>
        </div>
      </a>

      <a href={`${prefix}/graph`} class="group p-5 rounded-xl border border-hoba-border bg-hoba-card hover:border-hoba-accent/60 hover:bg-hoba-hover/50 hover:shadow-lg transition-all flex flex-col justify-between no-underline">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-hoba-accent/10 text-hoba-accent font-mono text-sm font-bold">04</span>
            <span class="pill pill-muted text-[11px] font-mono">{lang === 'uk' ? 'Топологія' : 'Topology'}</span>
          </div>
          <h3 class="text-base font-semibold text-hoba-text group-hover:text-hoba-accent transition-colors">
            {lang === 'uk' ? 'Провідник графа' : 'Knowledge Graph'}
          </h3>
          <p class="mt-1.5 text-xs text-hoba-muted leading-relaxed">
            {lang === 'uk' ? 'Повна мережа 89 вузлів та звʼязків: яруси сутностей, причинні петлі Тарʼяна та зони контролю.' : 'Explore 89 cross-referenced entities, stratified tiers, Tarjan cycles, and agency zone distributions.'}
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hoba-border/60 text-xs font-medium text-hoba-accent flex items-center gap-1">
          <span>{lang === 'uk' ? 'Відкрити граф' : 'Open Graph'}</span>
          <span>→</span>
        </div>
      </a>
    </div>
  </section>

  <!-- THE PROBLEM & WHAT HOBA GIVES -->
  <section id="landing-funnel" class="py-12 sm:py-16 border-b border-hoba-border scroll-mt-24">
    <div class="max-w-3xl mb-8">
      <p class="kicker">{t('home.problem.title')}</p>
      <h2 class="mt-1 text-2xl sm:text-3xl font-bold text-hoba-text text-balance">
        {t('home.problem.heading')}
      </h2>
      <p class="mt-3 text-base text-hoba-muted leading-relaxed">{t('home.problem')}</p>
    </div>

    <ol class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {(['1', '2', '3'] as const).map((n, i) => (
        <li class="p-6 rounded-xl border border-hoba-border bg-hoba-card flex flex-col justify-between">
          <div>
            <span class="font-mono text-xs font-semibold text-hoba-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-semibold text-hoba-text">{t(`home.gives.${n}.title`)}</h3>
            <p class="mt-2 text-sm text-hoba-muted leading-relaxed">{t(`home.gives.${n}.text`)}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- GUIDED PERSONA PATHWAYS -->
  <section id="lens-nav" class="py-12 sm:py-16 border-b border-hoba-border scroll-mt-24">
    <div class="max-w-2xl mb-8">
      <p class="kicker">{t('home.gives.title')}</p>
      <h2 class="mt-1 text-2xl sm:text-3xl font-bold text-hoba-text text-balance break-words">
        {lang === 'uk' ? 'Маршрути для різних ролей' : 'Role-Specific Pathways'}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {personas.map((p) => (
        <a href={p.href} class="group p-6 rounded-xl border border-hoba-border bg-hoba-card hover:border-hoba-accent hover:shadow-md transition-all flex flex-col justify-between no-underline">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-2xl" aria-hidden="true">{p.icon}</span>
              <span class="pill pill-muted text-xs font-mono">{p.badge}</span>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-hoba-text group-hover:text-hoba-accent transition-colors">
              {p.title}
            </h3>
            <p class="mt-2 text-sm text-hoba-muted leading-relaxed">
              {p.desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-hoba-border/60 flex items-center text-sm font-medium text-hoba-accent">
            <span>{p.cta}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- FORENSIC CASE DEMONSTRATION -->
  <section id="landing-specimens" class="py-12 sm:py-16 border-b border-hoba-border scroll-mt-24">
    <div class="max-w-3xl mb-8">
      <p class="kicker">{t('home.case.kicker')}</p>
      <h2 class="mt-1 text-2xl sm:text-3xl font-bold text-hoba-text text-balance">{t('home.case.title')}</h2>
      <p class="mt-2 text-base text-hoba-muted">{t('home.case.sub')}</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1.8fr)] items-start">
      <!-- Specimen card -->
      <div class="rounded-xl border border-hoba-border bg-hoba-card overflow-hidden shadow-sm">
        <div class="px-4 py-2.5 bg-hoba-bg border-b border-hoba-border flex items-center justify-between">
          <span class="font-mono text-xs text-hoba-accent font-semibold">{caseArtifact.id}</span>
          <span class="text-xs text-hoba-muted font-mono">{caseArtifact.stages.join(' · ')}</span>
        </div>
        <div class="p-4 sm:p-5">
          <Specimen specimen={caseSpecimen} lang={lang} />
        </div>
      </div>

      <!-- Epistemic breakdown -->
      <div class="space-y-4">
        <div class="rounded-xl border border-hoba-border bg-hoba-card p-5">
          <h3 class="text-base font-semibold text-hoba-text">{t('home.case.establishes')}</h3>
          <p class="mt-1.5 text-sm text-hoba-muted leading-relaxed">{t('home.case.establishesText')}</p>
        </div>

        <details class="disclosure">
          <summary>
            <span class="font-semibold text-sm text-hoba-text flex items-center gap-2">
              <span class="text-xs font-mono text-hoba-accent">🛡️</span>
              <span>{asHeading(t('art.nonInf'))}</span>
              <span class="pill pill-muted text-[11px] font-mono">{caseArtifact.non_inferences.length}</span>
            </span>
            <svg class="disclosure-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="disclosure-body">
            <ul class="list-disc pl-5 space-y-1 text-sm text-hoba-muted leading-relaxed">
              {caseArtifact.non_inferences.map((ni) => <li>{ni}</li>)}
            </ul>
          </div>
        </details>

        <div class="rounded-xl border border-hoba-border bg-hoba-card p-5">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-base font-semibold text-hoba-text">{t('home.case.behind')}</h3>
            <span class="pill pill-muted text-xs font-mono">{caseMechanisms.length}</span>
          </div>
          <p class="mt-1 text-xs text-hoba-muted">{t('home.case.behindText')}</p>
          <ul class="row-list divide-y divide-hoba-border mt-3">
            {caseMechanisms.map((m) => (
              <li class="py-2">
                <a href={`${prefix}/mechanisms/${m.id}`} class="group flex flex-col gap-1 hover:bg-hoba-hover -mx-2 p-2 rounded-md transition-colors no-underline">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 min-w-0">
                      <span class="font-mono text-xs font-semibold text-hoba-accent break-all">{m.id}</span>
                      <span class="text-sm text-hoba-text font-medium group-hover:text-hoba-accent transition-colors break-words">{m.title}</span>
                    </div>
                    <RemovabilityBadge removability={m.facets.removability} lang={lang} />
                  </div>
                  <span class="text-xs text-hoba-muted leading-relaxed line-clamp-2">{m.summary}</span>
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-4 pt-3 border-t border-hoba-border flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <p class="text-xs text-hoba-muted">{t('home.case.agencyText')}</p>
            <a href={`${prefix}/observations/${caseArtifact.id}`} class="btn btn-secondary text-xs shrink-0 self-start sm:self-auto">{t('home.case.cta')} →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NAMED CONTRADICTION PATTERNS -->
  <section id="landing-patterns" class="py-12 sm:py-16 border-b border-hoba-border scroll-mt-24">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <p class="kicker">{t('home.patterns.kicker')}</p>
        <h2 class="mt-1 text-2xl sm:text-3xl font-bold text-hoba-text text-balance">{t('home.patterns.title')}</h2>
        <p class="mt-2 text-base text-hoba-muted max-w-2xl">{t('home.patterns.sub')}</p>
      </div>
      <a href={`${prefix}/patterns`} class="btn btn-secondary text-sm shrink-0 self-start sm:self-auto">{t('home.patterns.all')} →</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {bundle.patterns.map((p) => (
        <a href={`${prefix}/patterns/${p.id}`} class="group p-5 rounded-xl border border-hoba-border bg-hoba-card hover:border-hoba-accent hover:shadow-md transition-all flex flex-col justify-between no-underline">
          <div>
            <span class="font-mono text-xs font-semibold text-hoba-accent break-all">{p.id}</span>
            <h3 class="mt-2 text-base font-semibold text-hoba-text group-hover:text-hoba-accent transition-colors">{p.title}</h3>
            <p class="mt-2 text-xs sm:text-sm text-hoba-muted leading-relaxed line-clamp-3">{p.summary}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-hoba-border/60 text-xs font-medium text-hoba-accent flex items-center gap-1">
            <span>{t('home.case.cta')}</span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- OPEN INFRASTRUCTURE & DEVELOPER BANNER -->
  <section id="open-data-section" class="py-12 sm:py-16 scroll-mt-24">
    <div class="p-6 sm:p-10 rounded-2xl border border-hoba-border bg-gradient-to-br from-hoba-card via-hoba-card to-hoba-hover/50 flex flex-col lg:flex-row lg:items-center justify-between gap-8">
      <div class="max-w-2xl">
        <span class="pill pill-muted text-xs font-mono mb-3">Open Source · CC BY-SA 4.0 · MIT</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-hoba-text">{t('home.dev.title')}</h2>
        <p class="mt-2 text-sm sm:text-base text-hoba-muted leading-relaxed">{t('home.dev.text')}</p>
        <div class="mt-4 flex flex-wrap gap-2 text-xs font-mono">
          <a href="/data/latest/registry.json" target="_blank" class="pill hover:border-hoba-accent">registry.json</a>
          <a href="/data/latest/graph.graphml" target="_blank" class="pill hover:border-hoba-accent">graph.graphml</a>
          <a href="/openapi.json" target="_blank" class="pill hover:border-hoba-accent">openapi.json</a>
          <a href={`${prefix}/developers#mcp`} class="pill hover:border-hoba-accent">MCP Server</a>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row lg:flex-col gap-3 shrink-0">
        <a href={`${prefix}/developers`} class="btn btn-primary text-sm px-5 py-2.5 text-center">{lang === 'uk' ? 'Документація для розробників' : 'Developer Docs'} →</a>
        <a href="https://github.com/dmytro-yemelianov/hoba.work" target="_blank" rel="noopener noreferrer" class="btn btn-secondary text-sm px-5 py-2.5 text-center">GitHub Repository</a>
      </div>
    </div>
  </section>
</Layout>
