---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { READER_FACING_TYPES } from '@hoba/registry';
import { getGraph, IDEAL_PATH_ID, STAGES } from '../../lib/registry';
import { localeFromParams, localePrefix, localeStaticPaths, useTranslations } from '../../i18n/utils';
import type { GraphNodeInput, GraphRelationType } from '../../lib/graph-view';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = localeFromParams(Astro.params);
const t = useTranslations(lang);
const prefix = localePrefix(lang);
const graph = getGraph(lang);
const bundle = graph.bundle;

// The x axis is the hiring funnel itself: every node inherits the stage of what
// it attaches to, so the picture reads left to right instead of as a hairball.
const stageIndex = new Map(STAGES.map((stage, index) => [stage, index] as const));
const mean = (values: (number | undefined)[]): number | undefined => {
  const known = values.filter((v): v is number => v !== undefined);
  return known.length ? known.reduce((a, b) => a + b, 0) / known.length : undefined;
};
const barrierLane = new Map(bundle.barriers.map((b) => [b.id, stageIndex.get(b.stage)] as const));
const artifactLane = new Map(bundle.observations.map((a) => [a.id, mean(a.stages.map((s) => stageIndex.get(s)))] as const));
const mechanismLane = new Map(bundle.mechanisms.map((m) => [m.id, mean(m.operates_at.map((id) => barrierLane.get(id)))] as const));
const patternLane = new Map(
  bundle.patterns.map((p) => [p.id, mean([...p.required_artifacts.map((id) => artifactLane.get(id)), ...p.compatible_mechanisms.map((id) => mechanismLane.get(id))])] as const)
);
const loopLane = new Map(bundle.loops.map((l) => [l.id, mean(l.mechanisms.map((id) => mechanismLane.get(id)))] as const));
const laneOf = (id: string): number | undefined =>
  barrierLane.get(id) ?? artifactLane.get(id) ?? mechanismLane.get(id) ?? patternLane.get(id) ?? loopLane.get(id);
const interventionLane = new Map(bundle.interventions.map((i) => [i.id, mean(i.targets.map(laneOf))] as const));

/** Facet labels double as list headings elsewhere, where they carry a colon. */
const label = (key: Parameters<typeof t>[0], vars?: Parameters<typeof t>[1]) => t(key, vars).replace(/:$/, '');
const evidence = (level: string) => ({ label: label('common.evidence'), value: t(`level.${level}` as Parameters<typeof t>[0]) });

// Everything the explorer shows is localized here, at build time: the client
// ships a plain data file and never needs the dictionary for facet values.
const nodes: GraphNodeInput[] = [
  ...bundle.observations.map((a) => ({
    id: a.id,
    type: 'observation' as const,
    title: a.title,
    summary: a.summary,
    href: `${prefix}/observations/${a.id}`,
    lane: artifactLane.get(a.id),
    facts: [
      { label: label('common.stage'), value: a.stages.map((s) => t(`stage.${s}`)).join(' · ') },
      evidence(a.evidence_level),
    ],
  })),
  ...bundle.barriers.map((b) => ({
    id: b.id,
    type: 'barrier' as const,
    title: b.title,
    summary: b.description,
    href: `${prefix}/barriers/${b.id}`,
    lane: barrierLane.get(b.id),
    facts: [
      { label: label('common.stage'), value: t(`stage.${b.stage}`) },
      { label: t('bar.order', { n: b.order }).split(':')[0], value: `#${b.order}` },
      evidence(b.evidence_level),
    ],
  })),
  ...bundle.mechanisms.map((m) => ({
    id: m.id,
    type: 'mechanism' as const,
    title: m.title,
    summary: m.summary,
    href: `${prefix}/mechanisms/${m.id}`,
    lane: mechanismLane.get(m.id),
    removability: m.facets.removability,
    facts: [
      { label: label('facet.actor'), value: t(`actor.${m.facets.actor}`) },
      { label: label('facet.nature'), value: t(`nature.${m.facets.nature}`) },
      { label: label('facet.visibility'), value: t(`visibility.${m.facets.visibility}`) },
      { label: label('facet.removability'), value: t(`removability.short.${m.facets.removability}`) },
      evidence(m.evidence_level),
    ],
  })),
  ...bundle.patterns.map((p) => ({
    id: p.id,
    type: 'pattern' as const,
    title: p.title,
    summary: p.summary,
    href: `${prefix}/patterns/${p.id}`,
    lane: patternLane.get(p.id),
    facts: [evidence(p.evidence_level)],
  })),
  ...bundle.loops.map((l) => ({
    id: l.id,
    type: 'loop' as const,
    title: l.title,
    summary: l.summary,
    href: `${prefix}/loops/${l.id}`,
    lane: loopLane.get(l.id),
    facts: [{ label: label('loop.members', { n: l.mechanisms.length }).split('(')[0].trim(), value: String(l.mechanisms.length) }, evidence(l.evidence_level)],
  })),
  ...bundle.interventions.map((i) => ({
    id: i.id,
    type: 'intervention' as const,
    title: i.title,
    summary: i.summary,
    href: `${prefix}/interventions/${i.id}`,
    lane: interventionLane.get(i.id),
    facts: [
      { label: label('int.actor'), value: t(`iactor.${i.actor}`) },
      { label: label('int.scope'), value: t(`scope.${i.scope}`) },
      { label: label('int.cost'), value: t(`cost.${i.cost}`) },
      evidence(i.evidence_level),
    ],
  })),
];

const edges = graph.edges.map((e) => ({ source: e.source, target: e.target, relation: e.type }));
const relationTypes: GraphRelationType[] = ['operates_at', 'emits', 'amplifies', 'masks', 'precedes', 'instantiates', 'targets', 'mitigates'];

const actorTitles = new Map(bundle.actors.map((a) => [a.id, a.title] as const));
const idealWorkflow = bundle.processes.find((w) => w.id === IDEAL_PATH_ID);
const idealSteps = idealWorkflow
  ? idealWorkflow.states.map((s, idx) => ({
      index: idx + 1,
      id: s.id,
      title: s.title,
      // The actor's own title, not a facet label. `s.owner` is an actorId and
      // has been dotted since the actor rename, so `actor.${s.owner}` built the
      // key `actor.actor.candidate` — and `t()` returns the key it cannot find,
      // so the HUD printed that string at a reader.
      owner: actorTitles.get(s.owner) ?? s.owner,
      description: s.description,
      entities: s.entities,
    }))
  : [];

const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
const graphData = json({
  nodes,
  edges,
  lanes: STAGES.map((stage) => ({ label: t(`stage.${stage}`) })),
  idealSteps,
  lang,
});
const strings = json({
  relations: Object.fromEntries(relationTypes.map((r) => [r, t(`relation.${r}`)])),
  outgoing: t('graph.outgoing'),
  incoming: t('graph.incoming'),
  noEdges: t('graph.noEdges'),
  degree: t('graph.degree'),
  visible: t('graph.visible'),
  fullscreen: t('graph.fullscreen'),
  exitFullscreen: t('graph.exitFullscreen'),
  tooltipHint: t('graph.tooltipHint'),
  openDetail: t('graph.openDetail'),
  types: Object.fromEntries(READER_FACING_TYPES.map((k) => [k, t(`entity.${k}` as Parameters<typeof t>[0])])),
});

const layers = READER_FACING_TYPES;
const nodeCount = graph.nodeMap.size - bundle.evidence.length;
---
<Layout lang={lang} title={t('graph.title')} activeNav="graph">
  <PageHeader kicker={t('graph.kicker')} title={t('graph.title')} lead={t('graph.intro', { nodes: nodeCount, edges: graph.edges.length })} wide tourPageKey="graph" lang={lang}>
    <Fragment slot="actions">
      <a href="/data/latest/graph.graphml" target="_blank" class="text-sm text-hoba-accent underline underline-offset-2 font-mono">graph.graphml</a>
      <a href="/data/latest/graph.json" target="_blank" class="text-sm text-hoba-accent underline underline-offset-2 font-mono">graph.json</a>
    </Fragment>
  </PageHeader>

  <div id="graph-shell" class="graph-shell h-[min(74vh,760px)] min-h-[480px]">
    <div class="graph-toolbar">
      <fieldset class="flex flex-wrap items-center gap-1.5">
        <legend class="sr-only">{t('graph.filterLayers')}</legend>
        {layers.map((type) => (
          <label class="pill-toggle pill-filter">
            <input type="checkbox" class="type-toggle" data-type={type} checked />
            <span class="dot" style={`background-color: rgb(var(--g-${type}))`} aria-hidden="true"></span>
            <span class="pill-label">{t(`entity.plural.${type}`)}</span>
          </label>
        ))}
      </fieldset>

      <div class="flex flex-wrap w-full sm:w-auto sm:ml-auto items-center gap-2">
        <button
          type="button"
          id="graph-ideal-toggle"
          class="btn btn-secondary text-xs px-2.5 py-1.5 flex items-center gap-1.5 cursor-pointer font-medium hover:border-hoba-accent transition-colors"
          title={lang === 'uk' ? `Підсвітити ідеальний канонічний маршрут (${IDEAL_PATH_ID})` : `Highlight canonical workflow (${IDEAL_PATH_ID})`}
        >
          <span class="text-amber-400">✨</span>
          <span>{lang === 'uk' ? 'Ідеальний маршрут' : 'Canonical path'}</span>
        </button>

        <label class="flex flex-1 sm:flex-none items-center gap-2 text-sm text-hoba-muted min-w-0">
          {/* The visible text is hidden below lg, and a hidden label gives no
              accessible name — so on a phone this was an unnamed control. */}
          <span class="hidden lg:inline">{t('graph.removabilityFilter')}</span>
          <select id="select-removability" aria-label={t('graph.removabilityFilter')} class="w-full sm:w-auto rounded-md border border-hoba-border bg-hoba-card px-2 py-1 text-sm text-hoba-text">
            <option value="all">{t('graph.rem.all')}</option>
            <option value="candidate">{t('graph.rem.candidate')}</option>
            <option value="intermediary">{t('graph.rem.intermediary')}</option>
            <option value="none">{t('graph.rem.none')}</option>
          </select>
        </label>

        <div class="flex items-center gap-1">
          <span id="graph-count" class="hidden md:inline text-sm text-hoba-muted tabular-nums mr-1"></span>
          <button type="button" id="graph-zoom-out" class="icon-btn" aria-label={t('graph.zoomOut')} title={t('graph.zoomOut')}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="M20 20l-3.6-3.6M8 11h6"/></svg>
          </button>
          <button type="button" id="graph-zoom-in" class="icon-btn" aria-label={t('graph.zoomIn')} title={t('graph.zoomIn')}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="M20 20l-3.6-3.6M8 11h6M11 8v6"/></svg>
          </button>
          <button type="button" id="graph-fit" class="icon-btn" aria-label={t('graph.fit')} title={t('graph.fit')}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path stroke-linecap="round" d="M12 2.5v3m0 13v3M2.5 12h3m13 0h3"/></svg>
          </button>
          <button type="button" id="graph-fullscreen" class="icon-btn" aria-label={t('graph.fullscreen')} title={t('graph.fullscreen')}>
            <svg class="w-4 h-4 fs-open" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3M3 16v3a2 2 0 002 2h3m8 0h3a2 2 0 002-2v-3"/></svg>
            <svg class="w-4 h-4 fs-close hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 3v3a2 2 0 01-2 2H3m18 0h-3a2 2 0 01-2-2V3M3 16h3a2 2 0 012 2v3m8 0v-3a2 2 0 012-2h3"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="relative flex-1 min-h-0">
      <canvas id="graph-canvas" class="graph-canvas h-full" tabindex="0" role="img" aria-label={t('graph.canvasLabel')}></canvas>

      <p id="graph-empty" class="absolute inset-0 hidden place-content-center text-center px-6 text-base text-hoba-muted">{t('graph.emptyLayers')}</p>
      <p class="absolute bottom-2 left-3 text-xs text-hoba-muted pointer-events-none select-none">{t('graph.controls')}</p>

      <!-- Floating Ideal Path Walkthrough HUD -->
      <div
        id="ideal-hud"
        class="hidden absolute bottom-4 left-3 right-3 sm:left-auto sm:right-4 sm:w-96 z-30 rounded-xl border border-hoba-border bg-hoba-card/95 backdrop-blur-md shadow-2xl p-4 flex flex-col gap-3"
      >
        <div class="flex items-center justify-between">
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-hoba-accent uppercase font-mono tracking-wider">
            <span>✨</span> {lang === 'uk' ? 'Канонічний шлях' : 'Canonical Path'}
          </span>
          <button id="ideal-close" type="button" class="icon-btn -mr-1 -mt-1" aria-label={t('graph.close')}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>

        <div>
          <div class="flex items-center justify-between text-xs text-hoba-muted font-mono">
            <span>{lang === 'uk' ? 'Крок' : 'Step'} <span id="ideal-step-num" class="font-bold text-hoba-text">1</span> / <span id="ideal-total-steps">{idealSteps.length}</span></span>
            <span id="ideal-step-owner" class="pill pill-muted text-[11px]"></span>
          </div>
          <h3 id="ideal-step-title" class="text-sm font-semibold text-hoba-text mt-1 leading-snug"></h3>
          <p id="ideal-step-desc" class="text-xs text-hoba-muted mt-1 leading-relaxed"></p>
          <div id="ideal-step-entities" class="flex flex-wrap gap-1 mt-2"></div>
        </div>

        <div class="flex items-center justify-between gap-2 pt-2 border-t border-hoba-border">
          <div class="flex items-center gap-1">
            <button id="ideal-prev" type="button" class="btn btn-secondary text-xs px-2.5 py-1" title={lang === 'uk' ? 'Попередній крок' : 'Previous step'}>◀</button>
            <button id="ideal-play" type="button" class="btn btn-secondary text-xs px-2.5 py-1 font-mono" title={lang === 'uk' ? 'Автопрогравання' : 'Play walkthrough'}>▶</button>
            <button id="ideal-next" type="button" class="btn btn-secondary text-xs px-2.5 py-1" title={lang === 'uk' ? 'Наступний крок' : 'Next step'}>▶</button>
          </div>
          <button id="ideal-all" type="button" class="pill pill-muted text-xs cursor-pointer hover:border-hoba-accent">{lang === 'uk' ? 'Огляд усього шляху' : 'Show full path'}</button>
        </div>
      </div>

      <div id="graph-tooltip" class="pointer-events-none absolute z-20 hidden max-w-[16rem] rounded-md border border-hoba-border bg-hoba-card px-3 py-2 shadow-lg">
        <p class="flex items-center gap-1.5 text-xs text-hoba-muted"><span id="tip-dot" class="dot"></span><span id="tip-type"></span><span id="tip-id" class="font-mono"></span></p>
        <p id="tip-title" class="mt-0.5 text-sm font-medium text-hoba-text leading-snug"></p>
        <p id="tip-meta" class="mt-1 text-xs text-hoba-muted"></p>
      </div>

      <aside
        id="graph-panel"
        class="graph-panel"
        aria-label={t('graph.inspector')}
        inert
      >
        <div class="p-5">
          <div class="flex items-start justify-between gap-3">
            <span id="panel-type" class="pill"></span>
            <button type="button" id="panel-close" class="icon-btn -mr-2 -mt-1" aria-label={t('graph.close')} title={t('graph.close')}>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>
          <p id="panel-id" class="mt-3 font-mono text-sm text-hoba-accent"></p>
          <h2 id="panel-title" class="mt-1 text-lg font-semibold text-hoba-text leading-snug"></h2>
          <p id="panel-summary" class="mt-2 text-base text-hoba-muted"></p>
          <ul id="panel-facts" class="mt-4 flex flex-wrap gap-1.5"></ul>
          <a id="panel-link" href="#" class="btn btn-secondary mt-5 w-full">{t('graph.openDetail')} →</a>
          <div id="panel-edges" class="mt-6 space-y-6"></div>
        </div>
      </aside>
    </div>
  </div>

  <p class="mt-3 text-sm text-hoba-muted">{t('graph.clickHint')}</p>

  <section class="section pt-8 border-t border-hoba-border">
    <h2 class="section-title">{t('graph.fallback')}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12">
      <ul class="row-list">
        {bundle.barriers.map((b) => <li><a href={`${prefix}/barriers/${b.id}`} class="row-link text-base"><span class="font-mono text-sm text-hoba-accent break-all max-w-full">{b.id}</span><span>{b.title}</span></a></li>)}
      </ul>
      <ul class="row-list">
        {bundle.mechanisms.map((m) => <li><a href={`${prefix}/mechanisms/${m.id}`} class="row-link text-base"><span class="font-mono text-sm text-hoba-accent break-all max-w-full">{m.id}</span><span>{m.title}</span></a></li>)}
      </ul>
    </div>
  </section>

  <script type="application/json" id="graph-data" set:html={graphData} />
  <script type="application/json" id="graph-strings" set:html={strings} />
  <script>
    import { GraphView, type GraphData, type GraphRelationType, type SimNode } from '../../lib/graph-view';

    interface Strings {
      relations: Record<GraphRelationType, string>;
      types: Record<string, string>;
      outgoing: string;
      incoming: string;
      noEdges: string;
      degree: string;
      visible: string;
      fullscreen: string;
      exitFullscreen: string;
      tooltipHint: string;
      openDetail: string;
    }

    const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const canvas = el<HTMLCanvasElement>('graph-canvas');
    const dataNode = el('graph-data');
    const stringsNode = el('graph-strings');

    if (canvas && dataNode?.textContent && stringsNode?.textContent) {
      const data = JSON.parse(dataNode.textContent) as GraphData;
      const s = JSON.parse(stringsNode.textContent) as Strings;
      const fill = (template: string, vars: Record<string, string | number>) =>
        template.replace(/\{(\w+)\}/g, (_, name: string) => String(vars[name] ?? `{${name}}`));

      const shell = el('graph-shell')!;
      const tooltip = el('graph-tooltip')!;
      const panel = el('graph-panel')!;
      const empty = el('graph-empty')!;
      const count = el('graph-count')!;

      const view = new GraphView(canvas, data, {
        onHover: (payload) => {
          if (!payload) {
            tooltip.classList.add('hidden');
            return;
          }
          const { node, x, y, radius } = payload;
          el('tip-dot')!.style.backgroundColor = `rgb(var(--g-${node.type}))`;
          el('tip-type')!.textContent = s.types[node.type] ?? node.type;
          el('tip-id')!.textContent = node.id;
          el('tip-title')!.textContent = node.title;
          el('tip-meta')!.textContent = `${fill(s.degree, { n: node.degree })} · ${s.tooltipHint}`;
          tooltip.classList.remove('hidden');
          const bounds = canvas.getBoundingClientRect();
          const width = tooltip.offsetWidth;
          const height = tooltip.offsetHeight;
          const axis = 30; // never cover the sticky stage axis
          const above = y - radius - 10 - height > axis;
          tooltip.style.left = `${Math.min(Math.max(x - width / 2, 8), bounds.width - width - 8)}px`;
          tooltip.style.top = `${Math.min(above ? y - radius - 10 - height : y + radius + 10, bounds.height - height - 8)}px`;
        },
        onSelect: (node) => renderPanel(node),
      });
      (window as any).__graphView = view;

      // ---- details panel ---------------------------------------------------

      function connectionRow(neighbor: SimNode, relation: GraphRelationType): HTMLLIElement {
        const li = document.createElement('li');
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'row-link w-full text-left';
        const rel = document.createElement('span');
        rel.className = 'pill pill-muted';
        rel.textContent = s.relations[relation] ?? relation;
        const id = document.createElement('span');
        id.className = 'font-mono text-sm text-hoba-accent';
        id.textContent = neighbor.id;
        const title = document.createElement('span');
        title.className = 'text-sm text-hoba-text';
        title.textContent = neighbor.title;
        button.append(rel, id, title);
        button.addEventListener('click', () => {
          view.select(neighbor.id);
          view.centerOn(neighbor.id);
        });
        li.append(button);
        return li;
      }

      function connectionGroup(heading: string, rows: HTMLLIElement[]): HTMLElement | null {
        if (!rows.length) return null;
        const section = document.createElement('div');
        const h = document.createElement('h3');
        h.className = 'text-sm font-medium text-hoba-muted mb-1';
        h.textContent = heading;
        const list = document.createElement('ul');
        list.className = 'row-list';
        list.append(...rows);
        section.append(h, list);
        return section;
      }

      function renderPanel(node: SimNode | null) {
        if (!node) {
          panel.classList.remove('is-open');
          panel.setAttribute('inert', '');
          return;
        }
        el('panel-type')!.textContent = s.types[node.type] ?? node.type;
        el('panel-type')!.style.borderColor = `rgb(var(--g-${node.type}))`;
        el('panel-id')!.textContent = node.id;
        el('panel-title')!.textContent = node.title;
        el('panel-summary')!.textContent = node.summary;
        el<HTMLAnchorElement>('panel-link')!.href = node.href;

        const facts = el('panel-facts')!;
        facts.replaceChildren(
          ...node.facts.map((fact) => {
            const li = document.createElement('li');
            li.className = 'pill pill-muted';
            li.textContent = `${fact.label}: ${fact.value}`;
            return li;
          })
        );

        const out: HTMLLIElement[] = [];
        const inbound: HTMLLIElement[] = [];
        for (const edge of view.graphEdges) {
          if (edge.hidden) continue;
          if (edge.source === node) out.push(connectionRow(edge.target, edge.relation));
          else if (edge.target === node) inbound.push(connectionRow(edge.source, edge.relation));
        }
        const groups = [connectionGroup(s.outgoing, out), connectionGroup(s.incoming, inbound)].filter(Boolean) as HTMLElement[];
        if (!groups.length) {
          const note = document.createElement('p');
          note.className = 'text-sm text-hoba-muted';
          note.textContent = s.noEdges;
          groups.push(note);
        }
        el('panel-edges')!.replaceChildren(...groups);

        panel.classList.add('is-open');
        panel.removeAttribute('inert');
        panel.scrollTop = 0;
      }

      el('panel-close')!.addEventListener('click', () => view.select(null));

      // ---- ideal path controls --------------------------------------------

      const idealToggle = el<HTMLButtonElement>('graph-ideal-toggle');
      const idealHud = el('ideal-hud');
      const idealClose = el('ideal-close');
      const idealPrev = el<HTMLButtonElement>('ideal-prev');
      const idealNext = el<HTMLButtonElement>('ideal-next');
      const idealPlay = el<HTMLButtonElement>('ideal-play');
      const idealAll = el<HTMLButtonElement>('ideal-all');
      const idealStepNum = el('ideal-step-num');
      const idealStepOwner = el('ideal-step-owner');
      const idealStepTitle = el('ideal-step-title');
      const idealStepDesc = el('ideal-step-desc');
      const idealStepEntities = el('ideal-step-entities');

      const idealSteps = data.idealSteps ?? [];
      let currentIdealStep = -1;
      let idealPlayTimer: number | null = null;

      function renderIdealStep(stepIdx: number) {
        currentIdealStep = stepIdx;
        if (stepIdx < 0 || stepIdx >= idealSteps.length) {
          // All steps mode
          if (idealStepNum) idealStepNum.textContent = '★';
          if (idealStepOwner) idealStepOwner.textContent = data.lang === 'uk' ? 'усі кроки' : 'all steps';
          if (idealStepTitle) idealStepTitle.textContent = data.lang === 'uk' ? 'Огляд усього канонічного шляху' : 'Full Canonical Route Overview';
          if (idealStepDesc) idealStepDesc.textContent = data.lang === 'uk' ? 'Усі 9 послідовних етапів та їх інтервенції підсвічено одночасно.' : 'All 9 sequential stages and interventions are highlighted.';
          if (idealStepEntities) idealStepEntities.innerHTML = '';
          view.setIdealPathActive(true, -1);
          return;
        }

        const step = idealSteps[stepIdx]!;
        if (idealStepNum) idealStepNum.textContent = String(stepIdx + 1);
        if (idealStepOwner) idealStepOwner.textContent = step.owner;
        if (idealStepTitle) idealStepTitle.textContent = step.title;
        if (idealStepDesc) idealStepDesc.textContent = step.description;

        if (idealStepEntities) {
          idealStepEntities.innerHTML = '';
          step.entities.forEach((eid) => {
            const badge = document.createElement('span');
            badge.className = 'pill pill-active font-mono text-[11px] cursor-pointer';
            badge.textContent = eid;
            badge.addEventListener('click', () => {
              view.select(eid);
              view.centerOn(eid);
            });
            idealStepEntities.appendChild(badge);
          });
        }

        view.setIdealPathActive(true, stepIdx);
      }

      function stopIdealPlay() {
        if (idealPlayTimer) {
          clearInterval(idealPlayTimer);
          idealPlayTimer = null;
          if (idealPlay) idealPlay.textContent = '▶';
        }
      }

      function toggleIdealPlay() {
        if (idealPlayTimer) {
          stopIdealPlay();
        } else {
          if (idealPlay) idealPlay.textContent = '⏸';
          if (currentIdealStep < 0) currentIdealStep = 0;
          renderIdealStep(currentIdealStep);
          idealPlayTimer = window.setInterval(() => {
            currentIdealStep = (currentIdealStep + 1) % idealSteps.length;
            renderIdealStep(currentIdealStep);
          }, 2600);
        }
      }

      idealToggle?.addEventListener('click', () => {
        const isHidden = idealHud?.classList.contains('hidden');
        if (isHidden) {
          idealHud?.classList.remove('hidden');
          idealToggle.classList.add('pill-active');
          renderIdealStep(0);
        } else {
          idealHud?.classList.add('hidden');
          idealToggle.classList.remove('pill-active');
          stopIdealPlay();
          view.setIdealPathActive(false);
        }
      });

      idealClose?.addEventListener('click', () => {
        idealHud?.classList.add('hidden');
        idealToggle?.classList.remove('pill-active');
        stopIdealPlay();
        view.setIdealPathActive(false);
      });

      idealPrev?.addEventListener('click', () => {
        stopIdealPlay();
        const next = currentIdealStep <= 0 ? idealSteps.length - 1 : currentIdealStep - 1;
        renderIdealStep(next);
      });

      idealNext?.addEventListener('click', () => {
        stopIdealPlay();
        const next = currentIdealStep >= idealSteps.length - 1 ? 0 : currentIdealStep + 1;
        renderIdealStep(next);
      });

      idealPlay?.addEventListener('click', toggleIdealPlay);
      idealAll?.addEventListener('click', () => {
        stopIdealPlay();
        renderIdealStep(-1);
      });

      // ---- filters ---------------------------------------------------------

      const toggles = Array.from(document.querySelectorAll<HTMLInputElement>('.type-toggle'));
      const removability = el<HTMLSelectElement>('select-removability')!;

      function applyFilters() {
        const hidden = new Set(toggles.filter((t) => !t.checked).map((t) => t.dataset.type));
        const agency = removability.value;
        const visible = view.setVisibility(
          (node) => !hidden.has(node.type) && (node.type !== 'mechanism' || agency === 'all' || node.removability === agency)
        );
        empty.classList.toggle('hidden', visible > 0);
        empty.classList.toggle('grid', visible === 0);
        count.textContent = fill(s.visible, { visible, total: view.graphNodes.length });
      }
      toggles.forEach((toggle) => toggle.addEventListener('change', applyFilters));
      removability.addEventListener('change', applyFilters);
      applyFilters();

      // ---- viewport controls ----------------------------------------------

      el('graph-zoom-in')!.addEventListener('click', () => view.zoomBy(1.3));
      el('graph-zoom-out')!.addEventListener('click', () => view.zoomBy(1 / 1.3));
      el('graph-fit')!.addEventListener('click', () => view.fit());

      const fullscreenButton = el<HTMLButtonElement>('graph-fullscreen')!;
      const supportsFullscreen = typeof shell.requestFullscreen === 'function';

      function isFullscreen() {
        return document.fullscreenElement === shell || shell.classList.contains('is-pseudo-fullscreen');
      }

      function syncFullscreen() {
        const active = isFullscreen();
        fullscreenButton.querySelector('.fs-open')!.classList.toggle('hidden', active);
        fullscreenButton.querySelector('.fs-close')!.classList.toggle('hidden', !active);
        const label = active ? s.exitFullscreen : s.fullscreen;
        fullscreenButton.setAttribute('aria-label', label);
        fullscreenButton.title = label;
        view.setFreeTouchPanning(active);
        // The box changes size in the same frame; refit once the browser settles.
        requestAnimationFrame(() => view.fit());
      }

      function toggleFullscreen() {
        if (supportsFullscreen) {
          if (document.fullscreenElement === shell) void document.exitFullscreen();
          else void shell.requestFullscreen().catch(() => shell.classList.add('is-pseudo-fullscreen'));
          return;
        }
        // iOS Safari refuses requestFullscreen on ordinary elements.
        shell.classList.toggle('is-pseudo-fullscreen');
        document.body.classList.toggle('overflow-hidden', shell.classList.contains('is-pseudo-fullscreen'));
        syncFullscreen();
      }

      fullscreenButton.addEventListener('click', toggleFullscreen);
      document.addEventListener('fullscreenchange', syncFullscreen);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && shell.classList.contains('is-pseudo-fullscreen')) toggleFullscreen();
      });

      window.addEventListener('hoba:theme', () => view.refreshTheme());
    }
  </script>
</Layout>
