{
  "$id": "https://hoba.work/schemas/evidence.schema.json",
  "$ref": "#/definitions/Evidence",
  "definitions": {
    "Evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(EVD-\\d{3}|evidence\\.[a-z0-9_]+)$"
        },
        "type": {
          "type": "string",
          "const": "evidence"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "kind": {
          "type": "string",
          "enum": [
            "primary",
            "research",
            "reporting",
            "survey",
            "anecdote",
            "illustrative"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "descriptive_fact",
            "mechanism_support",
            "claim_scoped",
            "edge_scoped",
            "intervention_effectiveness",
            "synthetic_labelled"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "citation": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "period": {
          "type": "string"
        },
        "aliases": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "kind",
        "role",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
